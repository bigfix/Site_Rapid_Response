createfile until END_PHP_YARA_0f68f1276f3d50db
/*
  PHP install detection + version, all OSes (Linux ELF, Windows PE, macOS Mach-O).

  Deliberately broad: PHP_Binary_Broad flags anything that looks PHP-related so
  nothing is missed; the other rules carry the exact version string. Run with
  `yara -s` (or `yr scan -s`) to print the matched version text.

  Rules:
    PHP_Runtime_Version     - PHP core runtime; $ver holds the exact version,
                              incl. distro suffix (e.g. 8.1.2-1ubuntu2.27)
    PHP_Windows_VersionInfo - any PE whose version resource says ProductName=PHP
                              (php.exe, php-cgi.exe, php8ts.dll, ext\php_*.dll);
                              $pv holds ProductVersion
    PHP_Binary_Broad        - catch-all: any executable with any PHP marker
    PHP_Build_Artifact      - php-config / php_version.h left by source installs

  No modules are imported so the rules also work in embedded YARA engines
  (osquery, EDRs) that are built without the pe/elf/macho modules.

  See README.md for tested samples and the API number -&gt; branch table.
*/

private rule PHP_Detect_IsExecutable
{{
  condition:
    uint32(0) == 0x464C457F                                 // ELF
    or uint16(0) == 0x5A4D                                  // PE (MZ)
    or uint32(0) == 0xFEEDFACE or uint32(0) == 0xFEEDFACF   // Mach-O 32/64
    or uint32(0) == 0xCEFAEDFE or uint32(0) == 0xCFFAEDFE   // Mach-O 32/64, byte-swapped
    or uint32(0) == 0xBEBAFECA                              // Mach-O universal (CAFEBABE)
}

rule PHP_Runtime_Version
{{
  meta:
    description = "PHP core runtime (CLI/CGI/FPM/mod_php/libphp/php*ts.dll/php8.dll/embedded); $ver = exact version"
    confidence = "high"
  strings:
    // Compile-time literal "X-Powered-By: PHP/" PHP_VERSION in main/SAPI.c.
    // Present regardless of expose_php. Suffix covers distro builds (8.1.2-1ubuntu2.27)
    // and pre-releases (8.5.0RC1).
    $ver = /X-Powered-By: PHP\/[0-9]{{1,2}\.[0-9]{{1,2}\.[0-9]{{1,3}[0-9A-Za-z.+~_-]{{0,40}/
  condition:
    PHP_Detect_IsExecutable and $ver
}

rule PHP_Windows_VersionInfo
{{
  meta:
    description = "Windows PE with PHP version resource; $pv = ProductVersion (exact version)"
    confidence = "high"
  strings:
    // UTF-16LE "ProductName" &lt;NUL + 0-2 bytes alignment pad&gt; "PHP\0"
    $pname = {{ 50 00 72 00 6F 00 64 00 75 00 63 00 74 00 4E 00 61 00 6D 00 65 00 [2-4] 50 00 48 00 50 00 00 00 }
    $pv = /ProductVersion\x00[0-9]{{1,2}\.[0-9]{{1,2}\.[0-9]{{1,3}[0-9A-Za-z.\-]{{0,20}/ wide
  condition:
    // #pv &gt;= 0 is always true: $pv is only there so -s prints the version
    uint16(0) == 0x5A4D and $pname and #pv &gt;= 0
}

rule PHP_Binary_Broad
{{
  meta:
    description = "Broad catch-all: executable containing any PHP runtime/extension marker"
    confidence = "medium"
  strings:
    $xpb    = "X-Powered-By: PHP/"
    $zend   = "Zend Engine v"
    // ZEND_MODULE_BUILD_ID, e.g. API20220829,NTS / API20250925,TS - also in extensions
    $api    = /API20[0-9]{{6},N?TS/
    $pname  = {{ 50 00 72 00 6F 00 64 00 75 00 63 00 74 00 4E 00 61 00 6D 00 65 00 [2-4] 50 00 48 00 50 00 00 00 }
    $grp    = "The PHP Group" ascii wide
    $ini    = "php.ini"
    $fmt    = "PHP %s (%s)"
  condition:
    PHP_Detect_IsExecutable and
    (
      $xpb or $zend or $api or $pname
      or ($grp and ($ini or $fmt))
    )
}

rule PHP_Build_Artifact
{{
  meta:
    description = "php-config script or php_version.h header from a PHP build/install; $v* = version"
    confidence = "medium"
  strings:
    // php-config (installed next to the php binary by `make install` and -dev packages)
    $cfg_ver   = /version="[0-9]{{1,2}\.[0-9]{{1,2}\.[0-9]{{1,3}[0-9A-Za-z.+~_-]{{0,40}"/
    $cfg_a     = "php_cli_binary="
    $cfg_b     = "--php-binary"
    // main/php_version.h
    $hdr_ver   = /#define PHP_VERSION "[0-9]{{1,2}\.[0-9]{{1,2}\.[0-9]{{1,3}[0-9A-Za-z.+~_-]{{0,40}"/
    $hdr_a     = "#define PHP_MAJOR_VERSION"
  condition:
    filesize &lt; 64KB and
    (
      ($cfg_ver and $cfg_a and $cfg_b)
      or ($hdr_ver and $hdr_a)
    )
}
END_PHP_YARA_0f68f1276f3d50db
delete "{parameter "work"}/php-detect.yar"
move __createfile "{parameter "work"}/php-detect.yar"
delete __createfile
createfile until END_PHP_YARA_318980fafe61de1e
#Requires -Version 5.1
param([string]$Archive,[string]$ArchiveHash,[string]$Destination,[string]$EngineHash)
$ErrorActionPreference = 'Stop'
Import-Module (Join-Path $PSHOME 'Modules\Microsoft.PowerShell.Utility\Microsoft.PowerShell.Utility.psd1') -ErrorAction Stop
if (Test-Path -LiteralPath $Destination) {{ throw 'Engine destination exists' }
if ((Get-FileHash -LiteralPath $Archive -Algorithm SHA256).Hash.ToLowerInvariant() -ne $ArchiveHash) {{ throw 'Archive hash mismatch' }
Add-Type -AssemblyName System.IO.Compression.FileSystem
$zip = [IO.Compression.ZipFile]::OpenRead($Archive)
try {{
    $entry = $zip.GetEntry('yr.exe')
    if (-not $entry -or $entry.Length -gt 64MB) {{ throw 'Unexpected archive entry' }
    [IO.Compression.ZipFileExtensions]::ExtractToFile($entry,$Destination,$false)
}
finally {{ $zip.Dispose() }
if ((Get-FileHash -LiteralPath $Destination -Algorithm SHA256).Hash.ToLowerInvariant() -ne $EngineHash) {{ throw 'Engine hash mismatch' }
END_PHP_YARA_318980fafe61de1e
delete "{parameter "work"}/extract-engine.ps1"
move __createfile "{parameter "work"}/extract-engine.ps1"
delete __createfile
createfile until END_PHP_YARA_05336401dc9d2255
#Requires -Version 5.1
&lt;# Bounded PHP signature discovery. Never executes discovered PHP binaries.
   PhpCandidateFilter.cs and the pinned rules ship beside this script. #&gt;
[CmdletBinding()]
param(
    [Parameter(Mandatory=$true)][string]$Engine,
    [Parameter(Mandatory=$true)][string]$EngineSha256,
    [Parameter(Mandatory=$true)][string]$Rules,
    [Parameter(Mandatory=$true)][string]$OutputDirectory,
    [string]$Archive,
    [string]$ArchiveSha256,
    [string[]]$Roots,
    [ValidateRange(1,10000000)][long]$MaxFiles = 5000000,
    [ValidateRange(1,2048)][long]$MaxFileMB = 512,
    [ValidateRange(1,100)][long]$CandidateGB = 30,
    [ValidateRange(1,3600)][int]$EnumerationSeconds = 600,
    [ValidateRange(1,3600)][int]$ScanSeconds = 600,
    [ValidateRange(1,99)][int]$CpuLimit = 10,
    [ValidateRange(0,1)][int]$GentleDisk = 0,
    [ValidateRange(0,1)][int]$IncludeBuildText = 0,
    [ValidateRange(0,1)][int]$IncludeBroaderLocations = 0,
    [ValidateRange(0,1)][int]$IncludeNonstandardNames = 0,
    [string]$ExcludeDirectoriesHex = 'x'
)
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'
Import-Module (Join-Path $PSHOME 'Modules\Microsoft.PowerShell.Utility\Microsoft.PowerShell.Utility.psd1') -ErrorAction Stop
$ruleSha256 = '0f68f1276f3d50db3dcba06fd1d8089e157fbc8e60bcca49ac1e7b2dde664615'
$utf8 = New-Object Text.UTF8Encoding($false)

# Bound the Analysis reason by UTF-8 bytes and preserve surrogate pairs.
# Full reasons remain in scan.log. This runs at most once per completed scan.
function Limit-PhpUnknownReason([string]$Text) {{
    if ($utf8.GetByteCount($Text) -le 800) {{ return $Text }
    $low = 0; $high = [Math]::Min(800, $Text.Length)
    while ($low -lt $high) {{
        $middle = [int][Math]::Ceiling(($low + $high) / 2.0)
        if ($utf8.GetByteCount($Text.Substring(0, $middle)) -le 800) {{ $low = $middle }
        else {{ $high = $middle - 1 }
    }
    if ($low -gt 0 -and [char]::IsHighSurrogate($Text[$low - 1])) {{ $low-- }
    return $Text.Substring(0, $low)
}

function Assert-NoReparsePath([string]$Path) {{
    $current = [IO.Path]::GetFullPath($Path)
    while ($current) {{
        if ([IO.File]::Exists($current) -or [IO.Directory]::Exists($current)) {{
            if (([IO.File]::GetAttributes($current) -band [IO.FileAttributes]::ReparsePoint) -ne 0) {{ throw 'Reparse path rejected' }
        }
        $current = [IO.Path]::GetDirectoryName($current)
    }
}

function Write-AtomicText([string]$Path, [string]$Text) {{
    Assert-NoReparsePath $Path
    Assert-NoReparsePath ($Path + '.new')
    [IO.File]::WriteAllText($Path + '.new', $Text, $utf8)
    if ([IO.File]::Exists($Path)) {{ [IO.File]::Replace($Path + '.new', $Path, [NullString]::Value) }
    else {{ [IO.File]::Move($Path + '.new', $Path) }
}

$OutputDirectory = [IO.Path]::GetFullPath($OutputDirectory)
Assert-NoReparsePath $OutputDirectory
$null = [IO.Directory]::CreateDirectory($OutputDirectory)
$lock = $null
Assert-NoReparsePath (Join-Path $OutputDirectory 'scan.lock')
try {{ $lock = [IO.File]::Open((Join-Path $OutputDirectory 'scan.lock'), [IO.FileMode]::OpenOrCreate, [IO.FileAccess]::ReadWrite, [IO.FileShare]::None) }
catch [IO.IOException] {{ exit 75 }
# Called only by a background worker AFTER it owns the existing scan.lock.
# Never remove an unmarked folder: another action may still be staging it.
if ($env:PHP_BACKGROUND_RUN_ID) {{
    foreach ($candidate in [IO.Directory]::GetDirectories($OutputDirectory, 'work-*')) {{
        if ($candidate -eq $PSScriptRoot -or [IO.Path]::GetFileName($candidate) -notmatch '^work-[0-9]+-[0-9]+-[0-9]+$') {{ continue }
        Assert-NoReparsePath $candidate
        $marker=Join-Path $candidate 'attempt.started'
        Assert-NoReparsePath $marker
        if (-not [IO.File]::Exists($marker) -or (Get-Item -LiteralPath $marker).Length -gt 128 -or [IO.File]::ReadAllText($marker).Trim() -ne 'PHP_YARA_BACKGROUND_WORKSPACE_V1') {{ continue }
        $safe=$true
        foreach ($entry in Get-ChildItem -LiteralPath $candidate -Force -Recurse -ErrorAction Stop) {{
            if (($entry.Attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {{ $safe=$false; break }
        }
        if ($safe) {{ [IO.Directory]::Delete($candidate,$true) }
    }
    [IO.File]::WriteAllText((Join-Path $PSScriptRoot 'attempt.started'),"PHP_YARA_BACKGROUND_WORKSPACE_V1`n",$utf8)
    [IO.File]::WriteAllText((Join-Path $PSScriptRoot 'attempt.admitted'),$env:PHP_BACKGROUND_RUN_ID,$utf8)
}
$started = [DateTime]::UtcNow.ToString('o')
$summaryPath = Join-Path $OutputDirectory 'summary.txt'
$logPath = Join-Path $OutputDirectory 'scan.log'
$clock = [Diagnostics.Stopwatch]::StartNew()
try {{
    Write-AtomicText $logPath ("Scan running; started $started. Properties retain the last finished scan until this scan ends.`n")
    $ruleBytes = $utf8.GetBytes([IO.File]::ReadAllText($Rules, $utf8).Replace("`r`n","`n"))
    $sha = [Security.Cryptography.SHA256]::Create()
    try {{ $actualRuleHash = [BitConverter]::ToString($sha.ComputeHash($ruleBytes)).Replace('-','').ToLowerInvariant() }
    finally {{ $sha.Dispose() }
    if ($actualRuleHash -ne $ruleSha256) {{ throw 'Rule/prefilter hash mismatch' }
    if (-not [IO.File]::Exists($Engine)) {{
        if (-not $Archive -or -not $ArchiveSha256) {{ throw 'Engine missing; verified archive required' }
        # Same process: avoid a second PowerShell startup. The bootstrap verifies
        # both archive and executable hashes before returning.
        &amp; (Join-Path $PSScriptRoot 'extract-engine.ps1') -Archive $Archive -ArchiveHash $ArchiveSha256 -Destination $Engine -EngineHash $EngineSha256
    }
    elseif ((Get-FileHash -LiteralPath $Engine -Algorithm SHA256).Hash.ToLowerInvariant() -ne $EngineSha256) {{ throw 'Engine hash mismatch' }
    if (-not ('PhpCandidateFilter' -as [type])) {{ Add-Type -Path (Join-Path $PSScriptRoot 'PhpCandidateFilter.cs') }
    $customExclusions = New-Object PhpDirectoryExclusions($ExcludeDirectoriesHex)
    try {{ [Diagnostics.Process]::GetCurrentProcess().PriorityClass = [Diagnostics.ProcessPriorityClass]::BelowNormal } catch {{ }
    if (-not $Roots) {{ $Roots = @([IO.DriveInfo]::GetDrives() | Where-Object {{ $_.DriveType -eq [IO.DriveType]::Fixed -and $_.IsReady } | ForEach-Object {{ $_.RootDirectory.FullName }) }
    $candidateList = Join-Path $PSScriptRoot 'candidates.txt'
    $stats = [PhpCandidateFilter]::WriteCandidates($Roots, $OutputDirectory, $candidateList, $MaxFiles, ($MaxFileMB * 1MB), ($CandidateGB * 1GB), $EnumerationSeconds, ($GentleDisk -eq 1), ($IncludeBuildText -eq 1), ($IncludeBroaderLocations -eq 1), ($IncludeNonstandardNames -eq 1), $customExclusions)
    $reasons = New-Object 'Collections.Generic.List[string]'
    if ($stats.BudgetReason) {{ $reasons.Add($stats.BudgetReason) }
    if ($stats.Errors -gt 0) {{ $reasons.Add('enumeration_or_read_errors') }
    if ($stats.SizeSkipped -gt 0) {{ $reasons.Add('individual_file_size_limit') }
    $rawPath = Join-Path $PSScriptRoot 'results.ndjson'
    $errorPath = Join-Path $PSScriptRoot 'engine.stderr.txt'
    Assert-NoReparsePath $rawPath
    Assert-NoReparsePath $errorPath
    $scanClock = [Diagnostics.Stopwatch]::StartNew()
    if ($stats.Candidates -gt 0) {{
        $arguments = @('scan','--scan-list','--print-strings','--output-format','ndjson',
                       '--threads','2','--cpu-limit',[string]$CpuLimit,'--timeout',[string]$ScanSeconds,
                       '--max-matches-per-pattern','64',$Rules,$candidateList)
        # These controlled paths are ordinary Windows file paths (no embedded
        # quotes, and no directory-ending backslash); no command shell is used.
        foreach ($argument in $arguments) {{ if ($argument.Contains('"')) {{ throw 'Unsupported quoted argument' } }
        $info = New-Object Diagnostics.ProcessStartInfo
        $info.FileName = [IO.Path]::GetFullPath($Engine)
        $info.Arguments = ($arguments | ForEach-Object {{ '"' + $_ + '"' }) -join ' '
        $info.UseShellExecute = $false
        $info.CreateNoWindow = $true
        $info.RedirectStandardOutput = $true
        $info.RedirectStandardError = $true
        $stdoutFile = [IO.File]::Open($rawPath, [IO.FileMode]::Create, [IO.FileAccess]::Write, [IO.FileShare]::ReadWrite)
        $stderrFile = [IO.File]::Open($errorPath, [IO.FileMode]::Create, [IO.FileAccess]::Write, [IO.FileShare]::ReadWrite)
        $child = $null
        try {{
            $child = [Diagnostics.Process]::Start($info)
            $outputCopy = $child.StandardOutput.BaseStream.CopyToAsync($stdoutFile)
            $errorCopy = $child.StandardError.BaseStream.CopyToAsync($stderrFile)
            while (-not $child.WaitForExit(200)) {{
                if ($scanClock.Elapsed.TotalSeconds -gt ($ScanSeconds + 15) -or $stdoutFile.Length -gt 64MB -or $stderrFile.Length -gt 8MB) {{
                    $child.Kill()
                    $reasons.Add('engine_deadline_or_output_budget')
                }
            }
            $null = $outputCopy.GetAwaiter().GetResult()
            $null = $errorCopy.GetAwaiter().GetResult()
            if ($child.ExitCode -ne 0) {{ $reasons.Add('engine_exit_' + $child.ExitCode) }
        }
        finally {{
            if ($child) {{ if (-not $child.HasExited) {{ $child.Kill(); $child.WaitForExit() }; $child.Dispose() }
            $stdoutFile.Dispose()
            $stderrFile.Dispose()
        }
        if ((Get-Item -LiteralPath $errorPath).Length -gt 0) {{ $reasons.Add('engine_warnings_or_file_errors') }
    }
    else {{ [IO.File]::WriteAllText($rawPath,'',$utf8); [IO.File]::WriteAllText($errorPath,'',$utf8) }
    $findings = New-Object 'Collections.Generic.List[object]'
    $findingCount = 0
    foreach ($line in [IO.File]::ReadLines($rawPath, $utf8)) {{
        try {{ $record = $line | ConvertFrom-Json }
        catch {{ $reasons.Add('invalid_or_truncated_engine_json'); continue }
        $findingCount++
        if ($findings.Count -ge 5000) {{ continue }
        $apiMarker = $false; $otherBroadMarker = $false
        $versions = New-Object 'Collections.Generic.HashSet[string]' ([StringComparer]::Ordinal)
        $ruleNames = @($record.rules | ForEach-Object {{ $_.identifier })
        foreach ($rule in $record.rules) {{
            foreach ($match in $rule.strings) {{
                if ($rule.identifier -eq 'PHP_Binary_Broad') {{
                    if ($match.identifier -eq '$api') {{ $apiMarker = $true }
                    else {{ $otherBroadMarker = $true }
                }
                if ($match.identifier -in @('$ver','$pv','$cfg_ver','$hdr_ver')) {{
                    $text = $match.match.Replace('\x00','').Replace([string][char]0,'')
                    foreach ($version in [regex]::Matches($text,'[0-9]{{1,2}\.[0-9]{{1,2}\.[0-9]{{1,3}[0-9A-Za-z.+~_-]*')) {{ [void]$versions.Add($version.Value) }
                }
            }
        }
        $kind = if ($ruleNames -contains 'PHP_Runtime_Version') {{ 'PHP_RUNTIME_SIGNATURE' }
                elseif ($ruleNames.Count -eq 1 -and $ruleNames[0] -eq 'PHP_Binary_Broad' -and $apiMarker -and -not $otherBroadMarker) {{ 'PHP_EXTENSION_API_ONLY' }
                elseif (@($ruleNames | Where-Object {{ $_ -ne 'PHP_Build_Artifact' }).Count -gt 0) {{ 'PHP_BINARY_OR_MODULE' }
                else {{ 'BUILD_ARTIFACT_ONLY' }
        $findings.Add([ordered]@{{path=$record.path; kind=$kind; versions=@($versions | Sort-Object); rules=$ruleNames})
    }

    # Only core/runtime signatures or standard Windows SAPI/core version resources
    # can set the vulnerable flag. Extension/build evidence remains in scan.log.
    $vulnerable = New-Object 'Collections.Generic.SortedSet[string]' ([StringComparer]::OrdinalIgnoreCase)
    $unverified = New-Object 'Collections.Generic.SortedSet[string]' ([StringComparer]::OrdinalIgnoreCase)
    $unknown = 0
    $fixes = @{{'8.2'=35; '8.3'=36; '8.4'=27; '8.5'=12}
    foreach ($finding in $findings) {{
        # API-only extensions remain in scan.log; a core signature takes precedence.
        if ($finding.kind -in @('BUILD_ARTIFACT_ONLY','PHP_EXTENSION_API_ONLY')) {{ continue }
        $leaf = [IO.Path]::GetFileName([string]$finding.path)
        $displayPath = ([string]$finding.path) -replace '^\\\\\?\\', ''
        $displayPath = $displayPath.Replace("`r",'\r').Replace("`n",'\n').Replace("`t",'\t')
        $core = $finding.kind -eq 'PHP_RUNTIME_SIGNATURE' -or ($finding.rules -contains 'PHP_Windows_VersionInfo' -and $leaf -match '^php(?:[0-9]+(?:ts|nts|apache[0-9_]*)?|(?:-cgi|-win)|dbg)?\.(exe|dll)$')
        if (-not $core) {{
            # Ordinary PHP extensions do not contain the affected PHP core.
            # The official debugger DLL is another non-core component. Only
            # suppress this known component when version-resource evidence agrees;
            # a real runtime signature always takes the core branch above.
            $debugger = $finding.rules -contains 'PHP_Windows_VersionInfo' -and $leaf -match '^php[0-9]+(?:ts|nts)?phpdbg\.dll$'
            if ($leaf -notmatch '^php_[^.]+\.dll$' -and -not $debugger) {{
                $unknown++; [void]$unverified.Add($displayPath + ' | PHP version/runtime unconfirmed')
            }
            continue
        }
        if (-not $finding.versions.Count) {{ $unknown++; [void]$unverified.Add($displayPath + ' | PHP version unavailable'); continue }
        foreach ($version in $finding.versions) {{
            if ($version -notmatch '^(\d+)\.(\d+)\.(\d+)(.*)$') {{ $unknown++; continue }
            $major = [int]$Matches[1]; $minor = [int]$Matches[2]; $patch = [int]$Matches[3]; $suffix = $Matches[4]
            $branch = "$major.$minor"
            # A prerelease of the fixed release is conservatively still affected.
            $affected = ($major -eq 5 -and $minor -ge 4) -or ($major -eq 7) -or ($major -eq 8 -and $minor -lt 2)
            if ($fixes.ContainsKey($branch)) {{ $affected = $patch -lt $fixes[$branch] -or ($patch -eq $fixes[$branch] -and $suffix -match '^(alpha|beta|RC|dev)') }
            elseif (-not $affected) {{ $unknown++; [void]$unverified.Add($displayPath + ' | PHP ' + $version + ' | Version assessment unavailable'); continue }
            if ($affected) {{
                if ($suffix -and $suffix -notmatch '^(alpha|beta|RC|dev)[0-9]*$') {{
                    [void]$unverified.Add($displayPath + ' | PHP ' + $version + ' | Vendor patch status unverified')
                }
                else {{ [void]$vulnerable.Add($displayPath + ' | PHP ' + $version) }
            }
        }
    }
    if ($findingCount -gt 5000) {{ $reasons.Add('finding_limit') }
    if ($unknown -gt 0) {{ $reasons.Add('PHP_version_or_runtime_unconfirmed') }
    $elapsed = [long][Math]::Round($clock.Elapsed.TotalSeconds)
    $duration = '{{0} hours, {{1} minutes, {{2} seconds' -f [Math]::Floor($elapsed / 3600), [Math]::Floor(($elapsed % 3600) / 60), ($elapsed % 60)
    $completed = [DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm:ss') + ' UTC'
    $messages = @{{enumeration_budget='File search limit reached'; search_time_limit='File search time limit reached'; file_limit='File count limit reached'; directory_budget='Folder count limit reached'; candidate_byte_budget='Total candidate size limit reached'; individual_file_size_limit=($stats.SizeSkipped.ToString() + ' possible runtime file(s) at or above ' + $MaxFileMB + ' MiB skipped'); engine_deadline_or_output_budget='Content scan time or output limit reached'; enumeration_or_read_errors='Unreadable files or folders'; engine_warnings_or_file_errors='Content scan warnings or unreadable files'; finding_limit='Result count limit reached'; PHP_version_or_runtime_unconfirmed='PHP version or runtime unconfirmed'}
    $why = @($reasons | Select-Object -Unique | ForEach-Object {{ if ($messages.ContainsKey($_)) {{ $messages[$_] } else {{ 'YARA error' } })
    $lastScan = $completed + $(if ($why.Count) {{ ' (Partial: ' + ($why -join ', ') + '; see scan.log)' } else {{ '' })
    if (@($unverified | Where-Object {{ $_.EndsWith('Vendor patch status unverified') }).Count) {{ $lastScan += ' (Vendor patch status unverified; see scan.log)' }
    $pathRows = New-Object 'Collections.Generic.List[string]'
    $pathBytes = 0
    $allRows = @($vulnerable | ForEach-Object {{ 'VULNERABLE=' + $_ }) + @($unverified | ForEach-Object {{ 'UNVERIFIED=' + $_ })
    foreach ($path in $allRows) {{
        # Bound UTF-8 bytes, not UTF-16 characters: BigFix file-line inspectors
        # split long byte sequences, which could otherwise break one-path rows.
        $row = $path
        if ($utf8.GetByteCount($path) -gt 900) {{
            $low = 0; $high = [Math]::Min(870,$path.Length)
            while ($low -lt $high) {{
                $middle = [int][Math]::Ceiling(($low + $high) / 2.0)
                if ($utf8.GetByteCount($path.Substring(0,$middle)) -le 870) {{ $low = $middle }
                else {{ $high = $middle - 1 }
            }
            if ($low -gt 0 -and [char]::IsHighSurrogate($path[$low - 1])) {{ $low-- }
            $row = $path.Substring(0,$low) + '...[full path in scan.log]'
        }
        $rowBytes = $utf8.GetByteCount($row) + 1
        if ($pathRows.Count -ge 100 -or $pathBytes + $rowBytes -gt 120000) {{ break }
        $pathRows.Add($row); $pathBytes += $rowBytes
    }
    if ($allRows.Count -gt $pathRows.Count) {{ $lastScan += ' (first ' + $pathRows.Count + ' paths shown; all paths in scan.log)' }
    $detected = if ($vulnerable.Count) {{ 'TRUE' } elseif ($unverified.Count -or $reasons.Count) {{ 'UNKNOWN' } else {{ 'FALSE' }
    $report = [ordered]@{{completed=$completed; duration=$duration; state=$(if ($reasons.Count) {{'Partial'} else {{'Completed'});
        started=$started; stats=$stats; scan_seconds=$scanClock.Elapsed.TotalSeconds; seconds=$clock.Elapsed.TotalSeconds;
        reasons=$reasons.ToArray(); roots=$Roots; custom_directory_exclusions=$customExclusions.Patterns.ToArray(); detected=$detected; vulnerable_paths=@($vulnerable); unverified_paths=@($unverified); findings_count=$findingCount; findings=$findings.ToArray();
        engine_messages=[IO.File]::ReadAllText($errorPath); rule_sha256=$ruleSha256;
        limits=@{{max_files=$MaxFiles; max_file_mb=$MaxFileMB; candidate_gb=$CandidateGB; enumeration_seconds=$EnumerationSeconds; scan_seconds=$ScanSeconds; cpu_limit=$CpuLimit; gentle_disk=$GentleDisk; include_build_text=$IncludeBuildText; include_broader_locations=$IncludeBroaderLocations; include_nonstandard_names=$IncludeNonstandardNames};
        meaning='TRUE: upstream-affected runtime detected. FALSE: none detected within complete scan scope. UNKNOWN: unavailable, incomplete or unverified evidence. Vendor patch status and web exposure require verification.'}
    Write-AtomicText $logPath (($report | ConvertTo-Json -Depth 14) + "`n")
    $summary = @('RESULT_FORMAT=2', ('DETECTED=' + $detected), ('LAST_SCAN=' + $lastScan), ('DURATION=' + $duration))
    if ($detected -eq 'UNKNOWN') {{
        $details = @($why)
        if (@($unverified | Where-Object {{ $_.EndsWith('Vendor patch status unverified') }).Count) {{ $details += 'Vendor patch status unverified' }
        if (-not $details.Count) {{ $details = @('Incomplete or unverified results; see scan.log') }
        $summary += 'UNKNOWN_REASON=' + (Limit-PhpUnknownReason ($details -join '; '))
    }
    if ($env:PHP_BACKGROUND_RUN_ID) {{ $summary += 'RUN_ID=' + $env:PHP_BACKGROUND_RUN_ID }
    $summary += $pathRows.ToArray()
    # A single replacement publishes all four properties together; in-progress
    # scans never clear a previous positive result or publish a start time as completion.
    Write-AtomicText $summaryPath (($summary -join "`n") + "`n")
    if ($reasons.Count) {{ exit 10 }
}
catch {{
    Write-AtomicText $logPath ("Scan failed at $([DateTime]::UtcNow.ToString('o')): $($_.Exception.Message)`n")
    $previous = if ([IO.File]::Exists($summaryPath)) {{ [IO.File]::ReadAllLines($summaryPath) } else {{ @('RESULT_FORMAT=2','DETECTED=UNKNOWN','LAST_SCAN=NO SCAN','DURATION=NO SCAN') }
    $previous = @($previous | ForEach-Object {{ if ($_.StartsWith('LAST_SCAN=')) {{ ($_ -split ' \(Last attempt failed')[0] + ' (Last attempt failed; see scan.log)' } else {{ $_ } })
    Write-AtomicText $summaryPath (($previous -join "`n") + "`n")
    throw
}
finally {{ if ($lock) {{ $lock.Dispose() } }
