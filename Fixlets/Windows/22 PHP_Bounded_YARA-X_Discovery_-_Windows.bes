$script:PhpWindows = [Environment]::GetFolderPath('Windows')
$script:PhpProgramFiles = @([Environment]::GetFolderPath('ProgramFiles'), [Environment]::GetFolderPath('ProgramFilesX86'))
$script:PhpDataPolicy = ConvertFrom-Json @'
{{
