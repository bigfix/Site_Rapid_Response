#Requires -Version 5.1
# Launch mode copies verified input out of __Download and waits only for admission.
# Supervisor mode owns its worker job, heartbeat, deadline and temporary cleanup.
[CmdletBinding()]
param(
    [string]$ConfigFile,
    [string]$Engine, [string]$EngineSha256, [string]$Rules, [string]$OutputDirectory,
    [string]$Archive, [string]$ArchiveSha256, [string[]]$Roots,
    [long]$MaxFiles=5000000, [long]$MaxFileMB=512, [long]$CandidateGB=30,
    [int]$EnumerationSeconds=600, [int]$ScanSeconds=600, [int]$CpuLimit=10,
    [int]$GentleDisk=0, [int]$IncludeBuildText=0, [int]$IncludeBroaderLocations=0,
    [int]$IncludeNonstandardNames=0, [string]$ExcludeDirectoriesHex='x'
)
Set-StrictMode -Version Latest
$ErrorActionPreference='Stop'
$utf8=New-Object Text.UTF8Encoding($false)
function Assert-SafePath([string]$Path) {{
    $current=[IO.Path]::GetFullPath($Path)
    while($current) {{
        if([IO.File]::Exists($current) -or [IO.Directory]::Exists($current)) {{
            if(([IO.File]::GetAttributes($current) -band [IO.FileAttributes]::ReparsePoint) -ne 0) {{ throw 'Reparse path rejected' }
        }
        $current=[IO.Path]::GetDirectoryName($current)
    }
}
function Write-Atomic([string]$Path,[string]$Text) {{
    for($attempt=0;$attempt -lt 20;$attempt++) {{
        Assert-SafePath $Path; Assert-SafePath ($Path+'.new')
        try {{
            [IO.File]::WriteAllText($Path+'.new',$Text,$utf8)
            if([IO.File]::Exists($Path)) {{ [IO.File]::Replace($Path+'.new',$Path,[NullString]::Value) }
            else {{ [IO.File]::Move($Path+'.new',$Path) }
            return
        }
        catch [IO.IOException] {{ if($attempt -eq 19) {{ throw }; Start-Sleep -Milliseconds 100 }
    }
}
function New-Child([string[]]$Arguments) {{
