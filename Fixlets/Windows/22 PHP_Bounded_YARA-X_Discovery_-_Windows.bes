# Exact YARA-X diagnostics only. Missing files must still be absent; permissions,
# recreated paths, malformed messages and uncertain ancestors remain UNKNOWN.
function Test-ConfirmedVanishedFile([string]$Path) {{
    if ($Path -notmatch '^(?:\\\\\?\\)?[A-Za-z]:\\' -or $Path -match '[\x00-\x1f]') {{ return $false }
    try {{
        $null = [IO.File]::GetAttributes($Path)
        return $false
    } catch {{
        $errorCode = $_.Exception.InnerException.HResult -band 0xffff
        if ($errorCode -ne 2 -and $errorCode -ne 3) {{ return $false }
    }
    # Check each existing ancestor without File.Exists, which masks access errors.
    $ancestor = [IO.Path]::GetDirectoryName($Path)
    while ($ancestor) {{
        try {{
            $attributes = [IO.File]::GetAttributes($ancestor)
            if (($attributes -band [IO.FileAttributes]::ReparsePoint) -ne 0) {{ return $false }
            if (($attributes -band [IO.FileAttributes]::Directory) -eq 0) {{ return $false }
        } catch {{
            $errorCode = $_.Exception.InnerException.HResult -band 0xffff
            if ($errorCode -ne 2 -and $errorCode -ne 3) {{ return $false }
        }
        $ancestor = [IO.Path]::GetDirectoryName($ancestor)
    }
    return $true
}
function Get-YaraWarningSummary {{
    param([string]$Path)
