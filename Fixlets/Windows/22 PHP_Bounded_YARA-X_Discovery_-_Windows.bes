<?xml version="1.0" encoding="UTF-8"?>
<BES>
  <Task>
    <Title>PHP YARA Vulnerability Scanner – CVE-2026-109618 and CVE-2026-109619 (Windows) V7</Title>
    <Description><![CDATA[<style>.php-hybrid{font-family:Segoe UI,Arial,sans-serif;max-width:1100px;line-height:1.45;color:#243447}.php-hybrid table{border-collapse:collapse;width:100%;margin:12px 0}.php-hybrid td,.php-hybrid th{padding:9px;border:1px solid #d6dee5;text-align:left;vertical-align:top}.php-hybrid th{background:#edf2f6}.php-hybrid .notice{padding:12px;background:#edf5fc;border-left:4px solid #356b98}.php-hybrid input{max-width:100%}</style>
<div class="php-hybrid"><h2>PHP YARA Vulnerability Scanner V7</h2>
<p>Detects PHP runtimes affected by CVE-2026-109618 and CVE-2026-109619 without executing PHP. Use the matching V7 analysis. Scanner and analysis versions should match.</p>
<p class="notice"><strong>Normal is the default: 2 workers, low priority, no CPU throttle. Use Gentle on busy or sensitive systems.</strong> Quick selects Gentle; Normal and Deep select Fast. You can adjust resource usage after selecting the scan type. Every mode keeps the 512 MiB individual-file limit.</p>
<h3>1. Coverage</h3><select id="PHPScanPreset" onchange="PhpScan.preset(this.value);"><option value="quick">Quick</option><option value="normal" selected="selected">Normal (default)</option><option value="deep">Deep</option><option value="custom" disabled="disabled">Custom</option></select>
<table><tr><th>Scan</th><th>Coverage and tradeoff</th></tr><tr><td>Quick</td><td>Standard PHP runtime names in usual application locations; fastest, but can miss renamed runtimes.</td></tr><tr><td>Normal</td><td>Includes renamed runtimes while keeping usual location exclusions.</td></tr><tr><td>Deep</td><td>Adds further OS and application locations, selected caches and PHP build evidence. Permanent data/cache exclusions, including Windows.old, still apply. Allows 60 minutes for file search and 60 minutes for YARA scanning.</td></tr></table>
<h3>2. Resource usage</h3><select id="PHPResourcePreset" onchange="PhpScan.resource(this.value);"><option value="gentle">Gentle (busy systems)</option><option value="fast" selected="selected">Fast (default)</option><option value="custom" disabled="disabled">Custom</option></select>
<p><strong>Gentle:</strong> 2 workers, engine throttle 10%, low CPU priority. <strong>Fast, default:</strong> 2 workers, no throttle, low CPU priority. Low priority does not prevent disk or memory contention; use Fast when the system is quiet.</p>
<h3>3. Advanced settings</h3><p>Changing the scan type selects its recommended resource settings and retains your directory exclusions. Change advanced settings afterward if needed. All times below are in minutes.</p><table><tr><th>Setting</th><th>Value</th><th>Purpose</th></tr><tr><td><label for="PHPExcludeDirectoriesHex">Additional directory exclusions (comma-separated)</label></td><td><input id="PHPExcludeDirectoriesHex" value="" size="48" maxlength="4096" /></td><td>Optional comma-separated directory exclusions; use /data/* or C:\folder\* to exclude a whole tree. A trailing slash alone excludes direct files only. Windows accepts either slash.</td></tr><tr><td><label for="PHPIncludeNonstandardNames">Include renamed or nonstandard PHP binaries (slower)</label></td><td><input type="checkbox" id="PHPIncludeNonstandardNames" checked="checked" onchange="PhpScan.syncPreset();" /></td><td>Includes renamed native runtimes; excluding them can miss custom PHP applications.</td></tr><tr><td><label for="PHPIncludeBroaderLocations">Include OS, recovery, cache and data locations (slower)</label></td><td><input type="checkbox" id="PHPIncludeBroaderLocations" onchange="PhpScan.syncPreset();" /></td><td>Includes normally skipped operating-system, cache and data locations.</td></tr><tr><td><label for="PHPIncludeBuildText">Include PHP source/build text (slower)</label></td><td><input type="checkbox" id="PHPIncludeBuildText" onchange="PhpScan.syncPreset();" /></td><td>Includes build evidence, which alone does not prove an installed vulnerable runtime.</td></tr><tr><td><label for="PHPEnumerationSeconds">File search time (minutes)</label></td><td><input id="PHPEnumerationSeconds" value="0" size="12" onchange="PhpScan.syncPreset();" /></td><td>Optional file-search time limit in minutes; 0 means no limit. Quick and Normal use 0; Deep uses 60.</td></tr><tr><td><label for="PHPScanSeconds">Content scan time (minutes)</label></td><td><input id="PHPScanSeconds" value="0" size="12" onchange="PhpScan.syncPreset();" /></td><td>Optional YARA content-scan time limit in minutes; 0 means no limit. Quick and Normal use 0; Deep uses 60.</td></tr><tr><td><label for="PHPMaxFiles">Maximum files checked (optional)</label></td><td><label><input id="PHPUseFileLimit" type="checkbox" onchange="PhpScan.syncPreset();" /> Limit files checked</label><br /><input id="PHPMaxFiles" value="50000000" size="12" onchange="PhpScan.syncPreset();" /></td><td>Enable only if you want a file-count limit. Unchecked means no limit for every scan type; the suggested enabled value is 50,000,000.</td></tr><tr><td><label for="PHPCandidateGB">Total input limit (GiB; 0 = off)</label></td><td><input id="PHPCandidateGB" value="0" size="12" onchange="PhpScan.syncPreset();" /></td><td>Optional cumulative input limit; 0 disables it. Time, individual-file and other safeguards remain active.</td></tr><tr><td><label for="PHPMaxFileMB">Maximum individual file size (MiB)</label></td><td><input id="PHPMaxFileMB" value="512" size="12" onchange="PhpScan.syncPreset();" /></td><td>Files at or above 512 MiB receive only a bounded header check; possible runtimes remain UNKNOWN.</td></tr><tr><td><label for="PHPCpuLimit">YARA CPU setting (%)</label></td><td><input id="PHPCpuLimit" value="0" size="12" onchange="PhpScan.syncPreset();" /></td><td>10 enables the engine throttle; 0 disables it. This is not a guaranteed whole-system CPU percentage.</td></tr><tr><td><label for="PHPGentleDisk">Pace Windows file search</label></td><td><input type="checkbox" id="PHPGentleDisk" onchange="PhpScan.syncPreset();" /></td><td>Adds a brief pause between batches during Windows file discovery; does not cap disk bandwidth or change YARA scanning.</td></tr><tr><td><label for="PHPYaraThreads">YARA workers</label></td><td><input id="PHPYaraThreads" value="2" size="12" onchange="PhpScan.syncPreset();" /></td><td>Concurrent YARA workers: use 2 normally; 4 may help a quiet Windows Deep scan but can increase contention.</td></tr></table>
<p>On Windows, update downloads, component servicing, installer caches, logs, crash dumps, recycle/restore data and Windows.old and Windows upgrade staging folders stay excluded in every mode, including Deep. General application and user folders remain eligible under the selected scope.</p><p>Linux and Mac submit ordinary candidates directly to YARA-X. Windows also submits ordinary candidates directly to YARA-X using PowerShell and built-in process support. No local C# compilation, scheduled tasks or Python are required. Oversized candidates receive only a small header check. Remote mounts, cloud placeholders and permanent exclusions remain excluded.</p>
<p>On Mac, specific Apple privacy, identity and personal-data stores are excluded. Desktop, Documents, Downloads, development folders and general application support remain in scope. On Mac, access-denied locations are skipped and recorded in scan.log, without making the scan Partial or UNKNOWN. FALSE means no vulnerable PHP was found in the accessible files; it does not confirm unreadable locations are clear. Running as root does not bypass macOS privacy controls.</p>
<p>The BigFix action returns after launch; results update after the background scan completes. TRUE means affected runtime evidence; FALSE means none found within the completed scan scope (accessible files on Mac); UNKNOWN includes a reason. Vendor patch status and web exposure require separate verification.</p>
<p>Results and detailed scan.log are under the BigFix client root in <code>YARA_PHP</code>. Previous completed results remain available while another scan runs.</p>
<p><a href="#" onclick="return PhpScan.prepare();">Start scan with these settings</a></p></div><script type="text/javascript">var phpScanFields = [{"key": "PHPExcludeDirectoriesHex", "label": "Additional directory exclusions (comma-separated)", "text": true}, {"key": "PHPIncludeNonstandardNames", "label": "Include renamed or nonstandard PHP binaries (slower)", "min": 0, "max": 1, "checkbox": true}, {"key": "PHPIncludeBroaderLocations", "label": "Include OS, recovery, cache and data locations (slower)", "min": 0, "max": 1, "checkbox": true}, {"key": "PHPIncludeBuildText", "label": "Include PHP source/build text (slower)", "min": 0, "max": 1, "checkbox": true}, {"key": "PHPEnumerationSeconds", "label": "File search time (minutes)", "min": 0, "max": 3600, "multiplier": 60}, {"key": "PHPScanSeconds", "label": "Content scan time (minutes)", "min": 0, "max": 3600, "multiplier": 60}, {"key": "PHPMaxFiles", "label": "Maximum files checked (optional)", "min": 1, "max": 50000000}, {"key": "PHPCandidateGB", "label": "Total input limit (GiB; 0 = off)", "min": 0, "max": 100}, {"key": "PHPMaxFileMB", "label": "Maximum individual file size (MiB)", "min": 16, "max": 512}, {"key": "PHPCpuLimit", "label": "YARA CPU setting (%)", "min": 0, "max": 10}, {"key": "PHPGentleDisk", "label": "Pace Windows file search", "min": 0, "max": 1, "checkbox": true}, {"key": "PHPYaraThreads", "label": "YARA workers", "min": 1, "max": 4}];
var phpScanWindows = true;
/* Console JScript compatible: no JSON dependency, eval, credentials or target selection. */
var PhpScan = (function () {
    function parameters(values) {
        var fields = phpScanFields, selected = {}, index, field, text, number, multiplier, minimum, maximum;
        for (index = 0; index < fields.length; index++) {
            field = fields[index];
            text = String(values[field.key]);
            if (field.text) {
                /* Encode UTF-8 bytes, never interpolate a directory into script code. */
                if (/[\x00-\x1f\x7f]/.test(text)) { throw new Error('Exclusions cannot contain control characters.'); }
                var entries = text.split(','), clean = [], j, entry, encoded, hex = 'x', k, byte;
                for (j = 0; j < entries.length; j++) {
                    entry = entries[j].replace(/^\s+|\s+$/g, '');
                    if (!entry) { continue; }
                    var prefix = phpScanWindows ? /^([A-Za-z]:[\\\/]|\*[\\\/])/ : /^(\/|\*\/)/;
                    var relative = phpScanWindows ? /(^|[\\\/])\.{1,2}([\\\/]|$)/ : /(^|\/)\.{1,2}(\/|$)/;
                    if (!prefix.test(entry) || relative.test(entry)) {
                        throw new Error('Use absolute exclusion paths or a leading */; . and .. segments are not allowed.');
                    }
                    clean.push(entry);
                }
                if (clean.length > 32) { throw new Error('Use at most 32 directory exclusions.'); }
                encoded = encodeURIComponent(clean.join(','));
                for (k = 0; k < encoded.length; k++) {
                    if (encoded.charAt(k) === '%') { byte = encoded.substr(k + 1, 2); k += 2; }
                    else { byte = encoded.charCodeAt(k).toString(16); if (byte.length < 2) { byte = '0' + byte; } }
                    hex += byte.toLowerCase();
                }
                if (hex.length > 8193) { throw new Error('Directory exclusions must fit within 4096 UTF-8 bytes.'); }
                selected[field.key] = hex;
                continue;
            }
            if (!/^[0-9]{1,9}$/.test(text)) { throw new Error(field.label + ': enter a whole number.'); }
            number = Number(text);
            multiplier = field.multiplier || 1;
            minimum = Math.ceil(field.min / multiplier);
            maximum = Math.floor(field.max / multiplier);
            if (number < minimum || number > maximum) { throw new Error(field.label + ': use ' + minimum + ' to ' + maximum + '.'); }
            number = number * multiplier;
            selected[field.key] = String(number);
        }
        selected.PHPMaxFiles = String(values.PHPUseFileLimit) === '1' ? selected.PHPMaxFiles : '0';
        return selected;
    }
    function prepare() {
        try {
            var values = {}, index, field;
            for (index = 0; index < phpScanFields.length; index++) {
                field = phpScanFields[index];
                values[field.key] = field.checkbox ? (document.getElementById(field.key).checked ? '1' : '0') : document.getElementById(field.key).value;
            }
            values.PHPUseFileLimit = document.getElementById('PHPUseFileLimit').checked ? '1' : '0';
            var selected = parameters(values);
            if (typeof TakeFixletAction === 'undefined' || typeof Relevance === 'undefined') {
                throw new Error('Open this content in the BigFix Console to use this settings form. API/WebUI launches use defaults unless action parameters are supplied.');
            }
            /* These are ordinary, nonsecret action parameters. The Console */
            /* obtains the current Task's Action1; no XML or script is rebuilt. */
            TakeFixletAction(Relevance('id of current fixlet'), Relevance('id of current bes site'), 'Action1', selected);
        } catch (error) { alert('Cannot prepare scan. ' + error.message); }
        return false;
    }

    var scopes = {"quick": {"PHPEnumerationSeconds": 0, "PHPScanSeconds": 0, "PHPMaxFiles": 50000000, "PHPCandidateGB": 0, "PHPMaxFileMB": 512, "PHPIncludeNonstandardNames": false, "PHPIncludeBroaderLocations": false, "PHPIncludeBuildText": false, "PHPCpuLimit": 10, "PHPYaraThreads": 2}, "normal": {"PHPEnumerationSeconds": 0, "PHPScanSeconds": 0, "PHPMaxFiles": 50000000, "PHPCandidateGB": 0, "PHPMaxFileMB": 512, "PHPIncludeNonstandardNames": true, "PHPIncludeBroaderLocations": false, "PHPIncludeBuildText": false, "PHPCpuLimit": 0, "PHPYaraThreads": 2}, "deep": {"PHPEnumerationSeconds": 60, "PHPScanSeconds": 60, "PHPMaxFiles": 50000000, "PHPCandidateGB": 0, "PHPMaxFileMB": 512, "PHPIncludeNonstandardNames": true, "PHPIncludeBroaderLocations": true, "PHPIncludeBuildText": true, "PHPCpuLimit": 0, "PHPYaraThreads": 2}};

    function apply(values) {
        var i, field, node;
        for (i = 0; i < phpScanFields.length; i++) {
            field = phpScanFields[i];
            if (!Object.prototype.hasOwnProperty.call(values, field.key)) continue;
            node = document.getElementById(field.key);
            if (field.checkbox) node.checked = values[field.key];
            else node.value = String(values[field.key]);
        }
    }
    function preset(value) {
        if (!scopes[value]) return;
        apply(scopes[value]);
        document.getElementById('PHPUseFileLimit').checked = false;
        document.getElementById('PHPScanPreset').value = value;
        if (Object.prototype.hasOwnProperty.call(scopes[value], 'PHPCpuLimit'))
            document.getElementById('PHPResourcePreset').value = scopes[value].PHPCpuLimit === 0 ? 'fast' : 'gentle';
    }
    function resource(value) {
        if (value !== 'gentle' && value !== 'fast') return;
        apply({PHPCpuLimit: value === 'gentle' ? 10 : 0, PHPYaraThreads: 2});
        document.getElementById('PHPResourcePreset').value = value;
    }
    function syncPreset() {
        document.getElementById('PHPScanPreset').value = 'custom';
        document.getElementById('PHPResourcePreset').value = 'custom';
    }
    return {parameters: parameters, prepare: prepare, preset: preset, resource: resource, syncPreset: syncPreset};
}());
document.body.ontakeaction = function () { return PhpScan.prepare(); };
</script>]]></Description>
    <Relevance><![CDATA[if (version of client >= "9.5.7") then (if windows of operating system then (x64 of operating system and (exists (it as string as version) whose (it >= "5.1" as version) of values "PowerShellVersion" of keys "HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\PowerShell\3\PowerShellEngine" of native registry) and (if product type of operating system = nt workstation product type then version of operating system >= "10.0.10240" as version else if product type of operating system = nt server product type or product type of operating system = nt domain controller product type then version of operating system >= "10.0.14393" as version else false)) else false) else false]]></Relevance>
    <Category>PHP Security Discovery</Category>
    <SourceReleaseDate>2026-10-25</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Sun, 25 Oct 2026 13:17:04 +0000</Value>
    </MIMEField>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to run bounded local PHP discovery.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[begin prefetch block
add prefetch item name=yara-x-v1.22.0-x86_64-pc-windows-msvc.zip sha1=344da50ce1693edd32b92c7d32eaf26d99c97f17 sha256=eac36a58699b94d3732a7fe1d8453fe89e0077bb18ac2c99b4c2ee102a431f2e size=9081400 url=https://github.com/VirusTotal/yara-x/releases/download/v1.22.0/yara-x-v1.22.0-x86_64-pc-windows-msvc.zip
end prefetch block
action uses file encoding UTF-8 NoBOM
action uses wow64 redirection false
if {not exists parameter "PHPExcludeDirectoriesHex"}
parameter "PHPExcludeDirectoriesHex" = "x"
endif
continue if {length of parameter "PHPExcludeDirectoriesHex" <= 8193 and parameter "PHPExcludeDirectoriesHex" = regex "x([0-9A-Fa-f][0-9A-Fa-f])*"}
if {not exists parameter "PHPIncludeNonstandardNames"}
parameter "PHPIncludeNonstandardNames" = "1"
endif
continue if {parameter "PHPIncludeNonstandardNames" = regex "[0-9]+" and length of parameter "PHPIncludeNonstandardNames" <= 9}
continue if {(parameter "PHPIncludeNonstandardNames" as integer) >= 0 and (parameter "PHPIncludeNonstandardNames" as integer) <= 1}
if {not exists parameter "PHPIncludeBroaderLocations"}
parameter "PHPIncludeBroaderLocations" = "0"
endif
continue if {parameter "PHPIncludeBroaderLocations" = regex "[0-9]+" and length of parameter "PHPIncludeBroaderLocations" <= 9}
continue if {(parameter "PHPIncludeBroaderLocations" as integer) >= 0 and (parameter "PHPIncludeBroaderLocations" as integer) <= 1}
if {not exists parameter "PHPIncludeBuildText"}
parameter "PHPIncludeBuildText" = "0"
endif
continue if {parameter "PHPIncludeBuildText" = regex "[0-9]+" and length of parameter "PHPIncludeBuildText" <= 9}
continue if {(parameter "PHPIncludeBuildText" as integer) >= 0 and (parameter "PHPIncludeBuildText" as integer) <= 1}
if {not exists parameter "PHPEnumerationSeconds"}
parameter "PHPEnumerationSeconds" = "0"
endif
continue if {parameter "PHPEnumerationSeconds" = regex "[0-9]+" and length of parameter "PHPEnumerationSeconds" <= 9}
continue if {(parameter "PHPEnumerationSeconds" as integer) >= 0 and (parameter "PHPEnumerationSeconds" as integer) <= 3600}
if {not exists parameter "PHPScanSeconds"}
parameter "PHPScanSeconds" = "0"
endif
continue if {parameter "PHPScanSeconds" = regex "[0-9]+" and length of parameter "PHPScanSeconds" <= 9}
continue if {(parameter "PHPScanSeconds" as integer) >= 0 and (parameter "PHPScanSeconds" as integer) <= 3600}
if {not exists parameter "PHPMaxFiles"}
parameter "PHPMaxFiles" = "0"
endif
continue if {parameter "PHPMaxFiles" = regex "[0-9]+" and length of parameter "PHPMaxFiles" <= 9}
continue if {(parameter "PHPMaxFiles" as integer) >= 0 and (parameter "PHPMaxFiles" as integer) <= 50000000}
if {not exists parameter "PHPCandidateGB"}
parameter "PHPCandidateGB" = "0"
endif
continue if {parameter "PHPCandidateGB" = regex "[0-9]+" and length of parameter "PHPCandidateGB" <= 9}
continue if {(parameter "PHPCandidateGB" as integer) >= 0 and (parameter "PHPCandidateGB" as integer) <= 100}
if {not exists parameter "PHPMaxFileMB"}
parameter "PHPMaxFileMB" = "512"
endif
continue if {parameter "PHPMaxFileMB" = regex "[0-9]+" and length of parameter "PHPMaxFileMB" <= 9}
continue if {(parameter "PHPMaxFileMB" as integer) >= 16 and (parameter "PHPMaxFileMB" as integer) <= 512}
if {not exists parameter "PHPCpuLimit"}
parameter "PHPCpuLimit" = "0"
endif
continue if {parameter "PHPCpuLimit" = regex "[0-9]+" and length of parameter "PHPCpuLimit" <= 9}
continue if {(parameter "PHPCpuLimit" as integer) >= 0 and (parameter "PHPCpuLimit" as integer) <= 10}
if {not exists parameter "PHPGentleDisk"}
parameter "PHPGentleDisk" = "0"
endif
continue if {parameter "PHPGentleDisk" = regex "[0-9]+" and length of parameter "PHPGentleDisk" <= 9}
continue if {(parameter "PHPGentleDisk" as integer) >= 0 and (parameter "PHPGentleDisk" as integer) <= 1}
if {not exists parameter "PHPYaraThreads"}
parameter "PHPYaraThreads" = "2"
endif
continue if {parameter "PHPYaraThreads" = regex "[0-9]+" and length of parameter "PHPYaraThreads" <= 9}
continue if {(parameter "PHPYaraThreads" as integer) >= 1 and (parameter "PHPYaraThreads" as integer) <= 4}
parameter "output" = "{pathname of parent folder of data folder of client}/YARA_PHP"
// Each attempt owns a separate workspace; interrupted children keep their scan lock.
parameter "work" = "{parameter "output"}/work-{id of action}-{((now - ("01 Jan 1970 00:00:00 +0000" as time)) / microsecond) as integer as string}-{random integer of 2147483647 as string}"
folder create "{parameter "output"}"
folder create "{parameter "work"}"
delete __createfile
createfile until END_PHP_HYBRID_d5fc6eed5b935a20
/*
  PHP install detection + version, all OSes (Linux ELF, Windows PE, macOS Mach-O).

  Deliberately broad: PHP_Binary_Broad flags anything that looks PHP-related so
  nothing is missed; the other rules carry the exact version string. Run with
  `yara -s` (or `yr scan -s`) to print the matched version text.

  Rules:
    PHP_Runtime_Version     - PHP core runtime; $ver holds the exact version,
                              incl. distro suffix (e.g. 8.1.2-1ubuntu2.27)
    PHP_Windows_VersionInfo - any PE whose version resource says ProductName=PHP
                              (php.exe, php-cgi.exe, php8ts.dll, ext\php_*.dll);
                              $pv holds ProductVersion
    PHP_Binary_Broad        - catch-all: any executable with any PHP marker
    PHP_Build_Artifact      - php-config / php_version.h left by source installs

  No modules are imported so the rules also work in embedded YARA engines
  (osquery, EDRs) that are built without the pe/elf/macho modules.

  See README.md for tested samples and the API number -> branch table.
*/

private rule PHP_Detect_IsExecutable
{{
  condition:
    // Keep existing ELF object/core exclusions inside YARA-X.
    (uint32(0) == 0x464C457F and
      not (uint16(16) == 1 or uint16(16) == 4 or
           uint16be(16) == 1 or uint16be(16) == 4))
    or uint16(0) == 0x5A4D
    // Mach-O executable, dylib and bundle; relocatable objects are not runtimes.
    or ((uint32(0) == 0xFEEDFACE or uint32(0) == 0xFEEDFACF) and
        (uint32(12) == 2 or uint32(12) == 6 or uint32(12) == 8))
    or ((uint32be(0) == 0xFEEDFACE or uint32be(0) == 0xFEEDFACF) and
        (uint32be(12) == 2 or uint32be(12) == 6 or uint32be(12) == 8))
    or uint32(0) == 0xBEBAFECA
}

// Coverage evidence only; do not silently certify unqualified fat variants.
rule PHP_Unsupported_Format
{{
  condition:
    uint32be(0) == 0xCAFEBABF or uint32be(0) == 0xBEBAFECA
    or uint32be(0) == 0xBFBAFECA
}


rule PHP_Runtime_Version
{{
  meta:
    description = "PHP core runtime (CLI/CGI/FPM/mod_php/libphp/php*ts.dll/php8.dll/embedded); $ver = exact version"
    confidence = "high"
  strings:
    // Compile-time literal "X-Powered-By: PHP/" PHP_VERSION in main/SAPI.c.
    // Present regardless of expose_php. Suffix covers distro builds (8.1.2-1ubuntu2.27)
    // and pre-releases (8.5.0RC1).
    $ver = /X-Powered-By: PHP\/[0-9]{{1,2}\.[0-9]{{1,2}\.[0-9]{{1,3}[0-9A-Za-z.+~_-]{{0,40}/
  condition:
    PHP_Detect_IsExecutable and $ver
}

rule PHP_Windows_VersionInfo
{{
  meta:
    description = "Windows PE with PHP version resource; $pv = ProductVersion (exact version)"
    confidence = "high"
  strings:
    // UTF-16LE "ProductName" <NUL + 0-2 bytes alignment pad> "PHP\0"
    $pname = {{ 50 00 72 00 6F 00 64 00 75 00 63 00 74 00 4E 00 61 00 6D 00 65 00 [2-4] 50 00 48 00 50 00 00 00 }
    $pv = /ProductVersion\x00[0-9]{{1,2}\.[0-9]{{1,2}\.[0-9]{{1,3}[0-9A-Za-z.\-]{{0,20}/ wide
  condition:
    // #pv >= 0 is always true: $pv is only there so -s prints the version
    uint16(0) == 0x5A4D and $pname and #pv >= 0
}

rule PHP_Binary_Broad
{{
  meta:
    description = "Broad catch-all: executable containing any PHP runtime/extension marker"
    confidence = "medium"
  strings:
    $xpb    = "X-Powered-By: PHP/"
    $zend   = "Zend Engine v"
    // ZEND_MODULE_BUILD_ID, e.g. API20220829,NTS / API20250925,TS - also in extensions
    $api    = /API20[0-9]{{6},N?TS/
    $pname  = {{ 50 00 72 00 6F 00 64 00 75 00 63 00 74 00 4E 00 61 00 6D 00 65 00 [2-4] 50 00 48 00 50 00 00 00 }
    $grp    = "The PHP Group" ascii wide
    $ini    = "php.ini"
    $fmt    = "PHP %s (%s)"
  condition:
    PHP_Detect_IsExecutable and
    (
      $xpb or $zend or $api or $pname
      or ($grp and ($ini or $fmt))
    )
}

rule PHP_Build_Artifact
{{
  meta:
    description = "php-config script or php_version.h header from a PHP build/install; $v* = version"
    confidence = "medium"
  strings:
    // php-config (installed next to the php binary by `make install` and -dev packages)
    $cfg_ver   = /version="[0-9]{{1,2}\.[0-9]{{1,2}\.[0-9]{{1,3}[0-9A-Za-z.+~_-]{{0,40}"/
    $cfg_a     = "php_cli_binary="
    $cfg_b     = "--php-binary"
    // main/php_version.h
    $hdr_ver   = /#define PHP_VERSION "[0-9]{{1,2}\.[0-9]{{1,2}\.[0-9]{{1,3}[0-9A-Za-z.+~_-]{{0,40}"/
    $hdr_a     = "#define PHP_MAJOR_VERSION"
  condition:
    filesize < 64KB and
    (
      ($cfg_ver and $cfg_a and $cfg_b)
      or ($hdr_ver and $hdr_a)
    )
}
