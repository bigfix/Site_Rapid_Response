function Write-Atomic([string]$Path, [string]$Text) {{
    for ($attempt = 0; $attempt -lt 20; $attempt++) {{
        Assert-SafePath $Path; Assert-SafePath ($Path + '.new')
        try {{
            [IO.File]::WriteAllText($Path + '.new', $Text, $utf8)
