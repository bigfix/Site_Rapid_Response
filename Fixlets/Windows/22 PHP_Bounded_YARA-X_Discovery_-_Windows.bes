'@
$script:PhpDataExtensions = New-Object 'Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
foreach ($extension in $script:PhpDataPolicy.data_extensions) {{
    [void]$script:PhpDataExtensions.Add($extension)
}
$script:PhpNonRuntimeExtensions = New-Object 'Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
foreach ($extension in $script:PhpDataPolicy.non_runtime_extensions) {{
    [void]$script:PhpNonRuntimeExtensions.Add($extension)
}
$script:PhpDefaultDirectories = New-Object 'Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
foreach ($directory in $script:PhpDataPolicy.default_relative_directories) {{
    [void]$script:PhpDefaultDirectories.Add($directory)
}
$script:PhpPermanentRoots = @($script:PhpDataPolicy.windows_relative_trees | ForEach-Object {{ [IO.Path]::Combine($script:PhpWindows, $_.Replace('/', '\')) })
$script:PhpPermanentRoots += @($script:PhpDataPolicy.system_volume_trees | ForEach-Object {{ [IO.Path]::Combine([IO.Path]::GetPathRoot($script:PhpWindows), $_) })
$script:PhpRuntimeName = [regex]::new('^(?:(?:php|phpdbg|libphp|mod_php|lsphp|frankenphp)(?:[0-9][0-9.]*(?:[-_][a-z0-9_.-]+)?|[-_][a-z0-9_.-]+)?(?:ts|nts|apache[0-9_]*)?)(?:\.exe|\.dll|\.so(?:\.[0-9]+)*)?$', [Text.RegularExpressions.RegexOptions]::IgnoreCase)
$script:PhpSystemFileNames = New-Object 'Collections.Generic.HashSet[string]' ([StringComparer]::OrdinalIgnoreCase)
foreach ($name in @('pagefile.sys', 'hiberfil.sys', 'swapfile.sys', 'NTUSER.DAT', 'UsrClass.dat', 'SYSTEM', 'SOFTWARE', 'SAM', 'SECURITY', 'DEFAULT', 'BBI')) {{
    [void]$script:PhpSystemFileNames.Add($name)
    [void]$script:PhpSystemFileNames.Add($name + '.LOG1'); [void]$script:PhpSystemFileNames.Add($name + '.LOG2')
}

function Initialize-PhpDirectoryPolicy {{
    # These expressions contain only fixed package policy, not user expressions.
    # Cache them once instead of rebuilding/testing every prefix on every folder.
    $roots = @($script:PhpPermanentRoots | ForEach-Object {{ [regex]::Escape($_.TrimEnd('\')) })
    $volumeNames = @($script:PhpDataPolicy.all_volume_trees | ForEach-Object {{ [regex]::Escape($_) })
    $roots += '[A-Za-z]:\\(?:' + ($volumeNames -join '|') + ')'
    $script:PhpPermanentDirectoryRegex = [regex]::new('^(?:' + ($roots -join '|') + ')(?:\\|$)', [Text.RegularExpressions.RegexOptions]::IgnoreCase)
    $defaults = @([regex]::Escape($script:PhpWindows))
    foreach ($root in $script:PhpProgramFiles) {{
        if (-not $root) {{
            continue
        }
        $defaults += [regex]::Escape([IO.Path]::Combine($root, 'WindowsApps'))
        foreach ($product in @('BES Server', 'BES Relay')) {{
            $defaults += [regex]::Escape([IO.Path]::Combine($root, 'BigFix Enterprise\' + $product + '\wwwrootbes\bfmirror\downloads\sha1'))
        }
    }
    $profileRoots = @('[A-Za-z]:\\Users\\[^\\]+\\', ([regex]::Escape([IO.Path]::Combine($script:PhpWindows, 'ServiceProfiles')) + '\\[^\\]+\\'), ([regex]::Escape([IO.Path]::Combine($script:PhpWindows, 'System32\config\systemprofile')) + '\\'))
    $cache = '(?:Pictures|Music|Videos|scoop\\cache|AppData\\Local\\CrashDumps|AppData\\Local\\(?:Google\\Chrome|Microsoft\\Edge)\\User Data\\(?:[^\\]+\\(?:Cache|Code Cache|GPUCache)|Crashpad\\reports)|AppData\\Local\\Mozilla\\Firefox\\Profiles\\[^\\]+\\cache2)'
    $defaults += '(?:' + ($profileRoots -join '|') + ')' + $cache
    $script:PhpDefaultDirectoryRegex = [regex]::new('^(?:' + ($defaults -join '|') + ')$', [Text.RegularExpressions.RegexOptions]::IgnoreCase)
}
Initialize-PhpDirectoryPolicy

function ConvertTo-PhpNormalPath([string]$Path) {{
    if ($Path.StartsWith('\\?\')) {{
        $Path = $Path.Substring(4)
    }
    return $Path.Replace('/', '\')
}
function ConvertTo-PhpExtendedPath([string]$Path) {{
    $normal = ConvertTo-PhpNormalPath $Path
    if ($normal.StartsWith('\\') -or $normal.StartsWith('UNC\', [StringComparison]::OrdinalIgnoreCase)) {{
        throw 'Network root excluded'
    }
    return '\\?\' + [IO.Path]::GetFullPath($normal)
}
function Test-PhpPathWithin([string]$Path, [string]$Root) {{
    return $Path.Equals($Root, [StringComparison]::OrdinalIgnoreCase) -or $Path.StartsWith($Root + '\', [StringComparison]::OrdinalIgnoreCase)
}
function New-PhpDirectoryExclusions([string]$Encoded) {{
    if ($Encoded -notmatch '^x(?:[a-fA-F0-9]{{2}){{0,4096}$') {{
        throw 'Invalid encoded directory exclusions'
    }
    $bytes = New-Object byte[] (($Encoded.Length - 1) / 2)
    for ($i = 0; $i -lt $bytes.Length; $i++) {{
        $bytes[$i] = [Convert]::ToByte($Encoded.Substring(1 + $i * 2, 2), 16)
    }
    $text = [Text.UTF8Encoding]::new($false, $true).GetString($bytes)
    if ($text -match '[\x00-\x1f\x7f]') {{
        throw 'Control character in exclusions'
    }
    $patterns = New-Object 'Collections.Generic.List[string]'
    $trees = New-Object 'Collections.Generic.List[object]'; $direct = New-Object 'Collections.Generic.List[object]'
    foreach ($entry in $text.Split(',')) {{
        $pattern = $entry.Trim().Replace('\', '/') -replace '/+', '/' -replace '\*+', '*'
        if (-not $pattern) {{
            continue
        }
        if ($patterns.Count -ge 32) {{
            throw 'At most 32 exclusions allowed'
        }
        if ($pattern -notmatch '^(?:\*/|[A-Za-z]:/)' -or @($pattern.Split('/') | Where-Object {{ $_ -eq '.' -or $_ -eq '..' }).Count) {{
            throw 'Invalid absolute directory exclusion'
        }
        $patterns.Add($pattern)
        $subtree = $pattern.EndsWith('/*')
        $basis = if ($subtree) {{
            $pattern.Substring(0, $pattern.Length - 2).TrimEnd('/')
        }
        else {{
            $pattern.TrimEnd('/')
        }
        # Escape everything except the supported asterisk. ? and [] stay literal.
        $escaped = [Management.Automation.WildcardPattern]::Escape($basis).Replace('`*', '*')
        $matcher = [Management.Automation.WildcardPattern]::new($escaped, [Management.Automation.WildcardOptions]::IgnoreCase)
        if ($subtree) {{
            $trees.Add(@($matcher, [Management.Automation.WildcardPattern]::new($escaped + '/*', [Management.Automation.WildcardOptions]::IgnoreCase)))
        }
        else {{
            $direct.Add($matcher)
        }
    }
    return [pscustomobject]@{{Patterns = $patterns; Trees = $trees; Direct = $direct }
}
function Get-PhpExclusionMode([string]$Path, $Exclusions) {{
    if (-not $Exclusions.Patterns.Count) {{
        return 0
    }
    $normal = (ConvertTo-PhpNormalPath $Path).Replace('\', '/').TrimEnd('/')
    foreach ($pair in $Exclusions.Trees) {{
        if ($pair[0].IsMatch($normal) -or $pair[1].IsMatch($normal)) {{
            return 2
        }
    }
    foreach ($matcher in $Exclusions.Direct) {{
        if ($matcher.IsMatch($normal)) {{
            return 1
        }
    }
    return 0
}
function Test-PhpPermanentDirectory([string]$Path) {{
    $normal = (ConvertTo-PhpNormalPath $Path).TrimEnd('\')
    return $script:PhpPermanentDirectoryRegex.IsMatch($normal)
}
function Get-PhpProfileRelativePath([string]$Normal) {{
    $system = Join-Path $script:PhpWindows 'System32\config\systemprofile\'
    if ($Normal.StartsWith($system, [StringComparison]::OrdinalIgnoreCase)) {{
        return $Normal.Substring($system.Length)
    }
    foreach ($root in @((Join-Path ([IO.Path]::GetPathRoot($Normal)) 'Users\'), (Join-Path $script:PhpWindows 'ServiceProfiles\'))) {{
        if (-not $Normal.StartsWith($root, [StringComparison]::OrdinalIgnoreCase)) {{
            continue
        }
        $rest = $Normal.Substring($root.Length); $index = $rest.IndexOf('\')
        if ($index -ge 0) {{
            return $rest.Substring($index + 1)
        }
    }
    return ''
}
function Test-PhpDefaultDirectory([string]$Normal) {{
    $volume = [IO.Path]::GetPathRoot($Normal)
    return $script:PhpDefaultDirectories.Contains($Normal.Substring($volume.Length)) -or $script:PhpDefaultDirectoryRegex.IsMatch($Normal)
}
function Test-PhpExpectedSystemFile([string]$Path) {{
    $normal = ConvertTo-PhpNormalPath $Path; $parent = [IO.Path]::GetDirectoryName($normal); $name = [IO.Path]::GetFileName($normal)
    if ($parent.TrimEnd('\') -ieq [IO.Path]::GetPathRoot($normal).TrimEnd('\') -and $name -imatch '^(?:pagefile|hiberfil|swapfile)\.sys$') {{
        return $true
    }
    $relative = Get-PhpProfileRelativePath $normal
    if ($relative -imatch '^(?:NTUSER\.DAT(?:\.LOG[12])?|AppData\\Local\\Microsoft\\Windows\\UsrClass\.dat(?:\.LOG[12])?)$') {{
        return $true
    }
    $config = Join-Path $script:PhpWindows 'System32\config'
    return ($parent -ieq $config -or $parent -ieq (Join-Path $config 'RegBack')) -and $name -imatch '^(?:SYSTEM|SOFTWARE|SAM|SECURITY|DEFAULT|BBI)(?:\.LOG[12])?$'
}
function Test-PhpExpectedReadFailure([string]$Path, [int]$Code) {{
    if ($Code -ne 32 -and $Code -ne 33) {{
        return $false
    }
    $normal = ConvertTo-PhpNormalPath $Path; $name = [IO.Path]::GetFileName($normal)
    if ($name -imatch '^(?:LOCK|\.lock|\.sLock)$') {{
        try {{
            if ([IO.FileInfo]::new($Path).Length -le 4096) {{
                return $true
            }
        }
        catch {{
        }
    }
    if ($normal -ieq (Join-Path ([IO.Path]::GetPathRoot($script:PhpWindows)) 'DumpStack.log.tmp')) {{
        return $true
    }
    if ($normal -imatch '\\TEMPDB\\templog\.ldf$') {{
        return $true
    }
    foreach ($root in $script:PhpProgramFiles) {{
        if ($root -and (Test-PhpPathWithin $normal (Join-Path $root 'Microsoft SQL Server')) -and $normal -imatch '\\MSSQL\\DATA\\[^\\]+\.(?:mdf|ndf|ldf)$') {{
            return $true
        }
    }
    $relative = Get-PhpProfileRelativePath $normal
    foreach ($pattern in $script:PhpDataPolicy.expected_profile_locked_patterns) {{
        if ($relative -imatch $pattern) {{
            return $true
        }
    }
    $programData = [Environment]::GetFolderPath('CommonApplicationData')
    if ($normal -ieq (Join-Path $programData 'BigFixScanner\bf-scanner.lock')) {{
        return $true
    }
    $defender = Join-Path $programData 'Microsoft\Windows Defender\'
    if ($normal.StartsWith($defender, [StringComparison]::OrdinalIgnoreCase)) {{
        $relativeDefender = $normal.Substring($defender.Length)
        if ($relativeDefender -imatch '^Scans\\MpDiag\.bin$|^IMpService[0-9a-f]{{8}-(?:[0-9a-f]{{4}-){{3}[0-9a-f]{{12}\.lock$|^Scans\\History\\CacheManager\\[0-9a-f]{{8}-(?:[0-9a-f]{{4}-){{3}[0-9a-f]{{12}-[0-9]+\.bin$') {{
            return $true
        }
    }
    $windowsPrefix = $script:PhpWindows + '\'
    if ($normal.StartsWith($windowsPrefix, [StringComparison]::OrdinalIgnoreCase)) {{
        $relativeWindows = $normal.Substring($windowsPrefix.Length)
        if ($relativeWindows -imatch '^System32\\catroot2\\.*(?:\.(?:log|jfm|edb)|\\catdb)$') {{
            return $true
        }
        foreach ($entry in $script:PhpDataPolicy.expected_windows_locked_paths) {{
            if ($relativeWindows -ieq $entry) {{
                return $true
            }
        }
    }
    return $false
}
function Add-PhpDiscoveryError($Stats, [string]$Operation, [string]$Path, [Exception]$ErrorValue) {{
    $cause = $ErrorValue.GetBaseException(); $code = $cause.HResult -band 65535
    if ($Operation -ne 'root' -and ($cause -is [IO.FileNotFoundException] -or $cause -is [IO.DirectoryNotFoundException])) {{
        $Stats.VanishedSkipped++; return
    }
    if ($Operation -eq 'read' -and (Test-PhpExpectedReadFailure $Path $code)) {{
        $Stats.ExpectedSkipped++; return
    }
    $Stats.Errors++
    if ($Stats.ErrorSamples.Count -lt 200) {{
        $safe = (ConvertTo-PhpNormalPath $Path).Replace("`r", '\r').Replace("`n", '\n'); if ($safe.Length -gt 600) {{
            $safe = $safe.Substring(0, 600) + '...[truncated]'
        }; $Stats.ErrorSamples.Add($Operation + ' | type=' + $cause.GetType().Name + ' | code=' + $code + ' | path=' + $safe)
    }
}
function Read-PhpStructure($Stream, [long]$Offset, [byte[]]$Buffer, [int]$Count, $Stats) {{
    if ($Offset -lt 0 -or $Count -lt 0 -or $Count -gt $Buffer.Length -or $Offset -gt $Stream.Length - $Count) {{
        return $false
    }
    $Stream.Position = $Offset; $total = 0
    while ($total -lt $Count) {{
        $read = $Stream.Read($Buffer, $total, $Count - $total); if ($read -le 0) {{
            break
        }; $total += $read
    }
    $Stats.StructuralBytes += $total; $Stats.PrefilterBytes += $total
    return $total -eq $Count
}
function Test-PhpKnownNonRuntime($Stream, [byte[]]$Buffer, $Stats) {{
    # Conservative structural proof. Uncertain or mixed/native images stay eligible.
    if (-not (Read-PhpStructure $Stream 0 $Buffer 64 $Stats)) {{
        return $false
    }
    if ([BitConverter]::ToUInt32($Buffer, 0) -eq 0x464c457f) {{
        if ($Buffer[4] -notin @(1, 2) -or $Buffer[5] -notin @(1, 2) -or $Buffer[6] -ne 1) {{
            return $false
        }
        $offset = if ($Buffer[4] -eq 1) {{
            40
        }
        else {{
            52
        }
        $type = if ($Buffer[5] -eq 1) {{
