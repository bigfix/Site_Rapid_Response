    while (-not [IO.File]::Exists((Join-Path $work 'attempt.admitted'))) {{
        if ($child.HasExited) {{
            throw "Worker admission failed (exit $($child.ExitCode))"
        }
        if ([DateTime]::UtcNow -gt $admissionDeadline) {{
            throw 'Worker admission timed out'
        }
        Start-Sleep -Milliseconds 100
    }
    $admitted = $true; Write-State 'RUNNING'
    [IO.File]::WriteAllText((Join-Path $work 'launch.ready'), "RUNNING`n", $utf8)
    $search = if ($settings.PSObject.Properties.Name -contains 'EnumerationSeconds') {{
        [int]$settings.EnumerationSeconds
    }
    else {{
        600
    }
    $scan = if ($settings.PSObject.Properties.Name -contains 'ScanSeconds') {{
        [int]$settings.ScanSeconds
    }
    else {{
        600
    }
    $deadline = [DateTime]::UtcNow.AddSeconds($search + $scan + 120); $heartbeat = [DateTime]::UtcNow
    while (-not $child.WaitForExit(200)) {{
        if ($search -gt 0 -and $scan -gt 0 -and [DateTime]::UtcNow -gt $deadline) {{
            throw 'Background scan exceeded its total deadline'
        }
        if ([DateTime]::UtcNow -ge $heartbeat) {{
            Write-State 'RUNNING'; $heartbeat = [DateTime]::UtcNow.AddSeconds(10)
        }
    }
    $exitCode = $child.ExitCode
    $summaryPath = Join-Path $OutputDirectory 'summary.txt'; Assert-SafePath $summaryPath
    $freshResults = [IO.File]::Exists($summaryPath) -and (Get-Item -LiteralPath $summaryPath).Length -le 131072 -and
    ([IO.File]::ReadAllLines($summaryPath) -contains ('RUN_ID=' + $runId))
    if ($freshResults -and $exitCode -eq 0) {{
        $finalState = 'COMPLETED'
    }
    elseif ($freshResults -and $exitCode -eq 10) {{
        $finalState = 'PARTIAL'
    }
}
catch {{
    $exitCode = 2
}
finally {{
    if ($child -and -not $child.HasExited) {{
        $child.Kill()
    }
    Stop-PhpOwnedEngine $work $settings.Engine $attemptStart
    if ($child) {{
        if (-not $child.HasExited -and -not $child.WaitForExit(5000)) {{
            throw 'Worker did not stop; preserving its workspace'
        }
        $child.Dispose()
    }
    if ($admitted) {{
        Write-State $finalState
    }
    $deadline = [DateTime]::UtcNow.AddSeconds(25)
    while ([IO.File]::Exists((Join-Path $work 'launch.ready')) -and -not [IO.File]::Exists((Join-Path $work 'launch.accepted')) -and [DateTime]::UtcNow -lt $deadline) {{
        Start-Sleep -Milliseconds 100
    }
    # No persistent result or log is included: this is the exact current work-* only.
    Assert-SafePath $work
    Remove-PhpAttemptDirectory $work $OutputDirectory
    $guard.Dispose()
}
exit $exitCode
