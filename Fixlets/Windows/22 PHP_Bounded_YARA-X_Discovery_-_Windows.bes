#Requires -Version 5.1
# Direct System.Diagnostics.Process supervision; no compiled helper or scheduled task.
# The worker observes its owner's identity; the owner terminates only the engine
# under this attempt's unique workspace, never processes selected by name alone.
function Assert-PhpSupervisor {{
    if (-not $env:PHP_BACKGROUND_SUPERVISOR) {{
        return
    }
    $identity = $env:PHP_BACKGROUND_SUPERVISOR.Split(':')
    if ($identity.Count -ne 2) {{
        throw 'Invalid supervisor identity'
    }
    $owner = $null
    try {{
        $owner = [Diagnostics.Process]::GetProcessById([int]$identity[0])
        if ($owner.StartTime.ToUniversalTime().Ticks -ne [long]$identity[1] -or $owner.HasExited) {{
            throw 'Background supervisor stopped'
        }
    }
    catch {{
        throw 'Background supervisor stopped; scan interrupted'
    }
    finally {{
        if ($owner) {{
            $owner.Dispose()
        }
    }
}
function Stop-PhpOwnedEngine([string]$WorkPath, [string]$EnginePath, [datetime]$NotBefore) {{
    $root = [IO.Path]::GetFullPath($WorkPath).TrimEnd('\')
    $expected = [IO.Path]::GetFullPath($EnginePath)
    if (-not $expected.StartsWith($root + '\', [StringComparison]::OrdinalIgnoreCase) -or [IO.Path]::GetFileName($expected) -ine 'yr.exe') {{
        throw 'Engine is outside the owned attempt'
    }
    foreach ($engineProcess in @(Get-Process -Name yr -ErrorAction SilentlyContinue)) {{
        try {{
            # Retain a process handle while checking identity to prevent PID reuse.
            $null = $engineProcess.Handle
            if ($engineProcess.HasExited) {{
                continue
            }
            $actual = $engineProcess.MainModule.FileName
            if ($actual -ine $expected -or $engineProcess.StartTime.ToUniversalTime() -lt $NotBefore) {{
                continue
            }
            $engineProcess.Kill()
            if (-not $engineProcess.WaitForExit(5000)) {{
                throw 'Owned YARA engine did not stop'
            }
        }
        catch [InvalidOperationException] {{
            if (-not $engineProcess.HasExited) {{
                throw
            }
        }
        finally {{
            $engineProcess.Dispose()
        }
    }
}
function Remove-PhpAttemptDirectory([string]$Path, [string]$Parent) {{
    $resolved = [IO.Path]::GetFullPath($Path)
    if ([IO.Path]::GetDirectoryName($resolved) -ine [IO.Path]::GetFullPath($Parent) -or [IO.Path]::GetFileName($resolved) -notmatch '^work-[0-9]+-[0-9]+-[0-9]+$') {{
        throw 'Invalid attempt cleanup path'
    }
    for ($current = $resolved; $current; $current = [IO.Path]::GetDirectoryName($current)) {{
        if (([IO.File]::Exists($current) -or [IO.Directory]::Exists($current)) -and ([IO.File]::GetAttributes($current) -band [IO.FileAttributes]::ReparsePoint)) {{
            throw 'Reparse cleanup path rejected'
        }
    }
    $pending = New-Object 'Collections.Generic.Stack[string]'; $pending.Push($resolved)
    while ($pending.Count) {{
        foreach ($entry in [IO.DirectoryInfo]::new($pending.Pop()).EnumerateFileSystemInfos()) {{
            if ($entry.Attributes -band [IO.FileAttributes]::ReparsePoint) {{
                throw 'Reparse entry prevents cleanup'
            }
            if ($entry.Attributes -band [IO.FileAttributes]::Directory) {{
                $pending.Push($entry.FullName)
            }
        }
    }
    [IO.Directory]::Delete($resolved, $true)
}
END_PHP_HYBRID_94fd1bd991a1c035
