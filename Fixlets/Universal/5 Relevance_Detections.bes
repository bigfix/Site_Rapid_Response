                  ; parenthesized parts 1 of matches (regex "<string>(/[^<]*php[^</]*)</string>") of lines whose (it contains "<string>/" and it as lowercase contains "php") of files whose (name of it as lowercase ends with ".plist" and size of it < 65536) of (folders ("/Library/LaunchDaemons";"/Library/LaunchAgents") of encoding "ISO-8859-1"; folders "Library/LaunchAgents" of folders of folders "/Users" of encoding "ISO-8859-1")
                  ; (if item 1 of it starts with "/" then item 1 of it else if item 0 of it != "" then item 0 of it & "/" & item 1 of it else "") of (concatenation of parenthesized parts 1 of matches (case insensitive regex "^[ %09]*ServerRoot[ %09]+%22?([^%22 %09]+)") of lines of it, parenthesized parts 1 of matches (case insensitive regex "^[ %09]*LoadModule[ %09]+php[0-9a-z_]*module[ %09]+%22?([^%22 %09]+)") of lines of it) of (files ("/etc/apache2/httpd.conf";"/etc/httpd/conf/httpd.conf";"/usr/local/apache2/conf/httpd.conf";"/opt/homebrew/etc/httpd/httpd.conf";"/usr/local/etc/httpd/httpd.conf";"/opt/local/etc/apache2/httpd.conf";"/opt/lampp/etc/httpd.conf";"/Applications/XAMPP/xamppfiles/etc/httpd.conf";"/Applications/MAMP/conf/apache/httpd.conf") of encoding "ISO-8859-1"; files whose (name of it as lowercase ends with ".load" or name of it as lowercase ends with ".conf") of folders ("/etc/apache2/mods-enabled";"/etc/httpd/conf.modules.d";"/etc/apache2/other";"/opt/lampp/etc/extra";"/Applications/XAMPP/xamppfiles/etc/extra") of encoding "ISO-8859-1") whose (size of it < 1048576)
                ) whose (not (it contains "/homebrew/opt/" or it starts with "/usr/local/opt/" or it contains "/.linuxbrew/opt/"))
            )) of encoding "ISO-8859-1"
