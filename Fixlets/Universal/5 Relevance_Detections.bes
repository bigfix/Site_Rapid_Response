  )) of ("%0a" & concatenation "%0a" of (
      (preceding text of first "%09" of it & " | " & following text of first "%09" of it) of lines whose (it contains "%09") of files whose (name of it as lowercase = "yara_results_php.text" and size of it < 1048576) of folders "Logs" of folders "__Global" of data folders of client
    ; (preceding text of first " | " of it & " | " & (if exists matches (regex "^[0-9]+\.[0-9]+\.[0-9]+") of it then it else "unknown") of preceding text of first " |" of (following text of first " | PHP " of (it & " | PHP ?") & " |")) of following texts of firsts "=" of lines whose (it starts with "VULNERABLE=" or it starts with "UNVERIFIED=") of files whose (name of it as lowercase = "summary.txt" and size of it < 131072) of folders "YARA_PHP" of parent folders of data folders of client
  ) whose (exists matches (case insensitive regex "(^|[\\/])((php|php-cgi|php-fpm|lsphp|frankenphp)-?[0-9.]*(\.exe)?|(libphp|mod_php)[0-9.]*\.so|php[0-9]apache[0-9_]*\.dll) \| ") of it) & "%0a")
) whose (not (item 1 of it ends with " | unknown" and item 0 of it contains ("%0a" & preceding text of last " | " of item 1 of it & " | ") and not (item 0 of it contains ("%0a" & item 1 of it & "%0a"))))]]></Property>
