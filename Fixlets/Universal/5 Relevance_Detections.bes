<?xml version="1.0" encoding="UTF-8"?>
<BES xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="BES.xsd">
	<Analysis>
		<Title>Relevance Detections</Title>
		<Description>An analysis for pure relevance detections related to CVEs. Currently only PHP. "PHP Installs" lists path | version for PHP runtimes in common install locations on Windows, Linux and macOS, plus results from the YARA-X PHP scans when present.</Description>
		<!-- relevance-ok: this analysis is meant to report on every endpoint -->
		<Relevance><![CDATA[true]]></Relevance>
		<Source>Internal</Source>
		<SourceID>jgstew</SourceID>
		<SourceReleaseDate>2026-10-21</SourceReleaseDate>
		<MIMEField>
			<Name>x-fixlet-modification-time</Name>
			<Value>Fri, 23 Oct 2026 19:39:32 +0000</Value>
		</MIMEField>
		<Domain>BESC</Domain>
		<Property Name="PHP Running?" ID="1" EvaluationPeriod="P1D"><![CDATA[unique values of (item 1 of it & " pid=" & (pid of item 2 of it as string) & " name=" & (name of item 2 of it | "") & " path=" & (pathname of image file of item 2 of it | "?") & " evidence=" & item 3 of it & " version=" & concatenation "," of unique values of (((if (windows of operating system) then concatenation "," of (value "ProductVersion" of version block 1 of it as string) of image files whose (value "ProductName" of version block 1 of it as string = "PHP") of item 2 of it else "") ; (following text of first "%09" of item 1 of it) of ((it as lowercase) of pathnames of image files of item 2 of it, substrings separated by "%0a" of item 0 of it) whose (item 1 of it starts with (item 0 of it & "%09")) ; (following text of first "%09" of item 1 of it) of (unique values of (("/" & following text of first "/" of it) as lowercase) of lines whose (it contains "/") of files ("/proc/" & (pid of item 2 of it as string) & "/maps") whose (exists folder (pathname of parent folder of it & "/root")), substrings separated by "%0a" of item 0 of it) whose (item 1 of it starts with (item 0 of it & "%09"))) whose (it != "" and it != "unknown")) & " libphp=" & concatenation ";" of unique values of ("/" & following text of first "/" of it) of lines whose (it as lowercase contains "/libphp") of files ("/proc/" & (pid of item 2 of it as string) & "/maps") whose (exists folder (pathname of parent folder of it & "/root"))) of ((item 0 of it, item 1 of it, item 2 of it, concatenation "," of ((if ((name of item 2 of it | "") as lowercase contains "php") then "name" else "") ; (if (exists pathnames whose (it as lowercase contains "php") of image files of item 2 of it) then "path" else "") ; (if (windows of operating system) then (if (exists image files whose (value "ProductName" of version block 1 of it as string = "PHP") of item 2 of it) then "pe" else "") else "") ; (if (exists lines whose (it as lowercase contains "/libphp") of files ("/proc/" & (pid of item 2 of it as string) & "/maps") whose (exists folder (pathname of parent folder of it & "/root"))) then "libphp" else "") ; (if (exists lines whose (it as lowercase contains "/php/extensions/") of files ("/proc/" & (pid of item 2 of it as string) & "/maps") whose (exists folder (pathname of parent folder of it & "/root"))) then "php-ext" else "") ; (if (exists (item 0 of it, (it as lowercase) of pathnames of image files of item 2 of it) whose (item 0 of it contains ("%0a" & item 1 of it & "%09"))) then "yara" else "") ; (if ((name of item 2 of it | "") as lowercase starts with "httpd" or (name of item 2 of it | "") as lowercase starts with "apache") then (if (exists lines whose (it as lowercase contains "loadmodule php") of files whose (name of it as lowercase ends with ".conf") of (folders "conf" of it; folders "extra" of folders "conf" of it) of parent folders of parent folders of image files of item 2 of it) then "httpd-conf" else "") else "") ; (if (((name of item 2 of it | "") as lowercase starts with "httpd" or (name of item 2 of it | "") as lowercase starts with "apache") and not exists files ("/proc/" & (pid of item 2 of it as string) & "/maps") whose (exists folder (pathname of parent folder of it & "/root"))) then "webserver-modules-unknown" else "")) whose (it != "")) of ((item 0 of it, item 0 of item 1 of it, item 1 of item 1 of it) of (("%0a" & concatenation "%0a" of (it as string as lowercase) of lines of files whose (name of it as lowercase starts with "yara_results_php.text") of folders "Logs" of folders "__Global" of data folders of client & "%0a"), ((local address of it as string & ":" & local port of it as string, processes of it) of sockets whose (tcp of it and listening of tcp state of it) of network ; ("running", it) of processes)))) whose (item 3 of it != "")]]></Property>
		<Property Name="PHP Installs" ID="2" EvaluationPeriod="P1D"><![CDATA[unique values of (item 1 of it) of (
  (it, (
      (substrings separated by "%0a" of it) whose (it != "")
    ; (if windows of operating system then (
        (pathname of it & " | " & (value "ProductVersion" of version block 1 of it as string | "unknown")) of files ("php.exe";"php-cgi.exe";"frankenphp.exe";"php8apache2_4.dll";"php7apache2_4.dll";"php5apache2_4.dll";"php5apache2_2.dll") of (
            (
                (it; folders of it) of folders whose (name of it as lowercase starts with "php") of (it; folders of it)
              ; folders of folders "bin\php" of folders of it
              ; folders of folders "IIS Express\PHP" of folders whose (name of it as lowercase starts with "program files") of it
              ; folders whose (name of it as lowercase != "current") of folders whose (name of it as lowercase starts with "php") of folders "scoop\apps" of (folders of folders "Users" of it; folders "ProgramData" of it)
              ; (folders whose (name of it as lowercase starts with "php") of (it; folders ".config\herd\bin" of it); folders ".config\herd-lite\bin" of it) of folders of folders "Users" of it
            ) of folders (names of drives whose (type of it = "DRIVE_FIXED"))
          ; (it; folders "php" of it; folders of folders "bin\php" of it) of folders (values "InstallLocation" of keys whose (exists matches (case insensitive regex "php|xampp|wamp|laragon|ampps|herd") of (value "DisplayName" of it as string | "")) of keys "HKLM\Software\Microsoft\Windows\CurrentVersion\Uninstall" of (x64 registries; x32 registries) as string)
          ; folders (substrings separated by ";" of value of variable "PATH" of environment)
          ; parent folders of files ((preceding text of first "%22" of following text of first "fullPath=%22" of it) of lines whose (it as lowercase contains "fullpath=%22" and it as lowercase contains "php") of files "applicationHost.config" of folders "inetsrv\config" of native system folder)
          ; parent folders of image files of processes whose (name of it as lowercase starts with "php")
        )
      ) else (
        (pathname of it & " | " & (if it = "" then "unknown" else it) of (if (pathname of it contains "/Cellar/php") then preceding text of first "_" of (preceding text of first "/" of following text of first "/" of following text of first "/Cellar/" of pathname of it & "_") else if (size of it > 134217728) then "" else concatenation "," of unique values of (it as string) of matches (regex "^[0-9]{1,2}\.[0-9]{1,2}\.[0-9]{1,3}[0-9A-Za-z.+~_-]{0,40}") of following texts of firsts "X-Powered-By: PHP/" of lines whose (it contains "X-Powered-By: PHP/") of it)) of (
          (files whose (exists matches (case insensitive regex "^(php|php-cgi|php-fpm|lsphp|frankenphp)-?[0-9.]*$|^(libphp|mod_php)[0-9.]*\.so$") of name of it) of (
              (
                  folders ("usr/bin";"usr/sbin";"usr/libexec/apache2";"usr/lib/apache2/modules";"usr/lib/httpd/modules";"usr/lib64/httpd/modules";"usr/local/apache2/modules";"opt/local/bin";"opt/local/sbin";"opt/local/apache2/modules";"opt/lampp/bin";"opt/lampp/modules";"Applications/XAMPP/xamppfiles/bin";"Applications/XAMPP/xamppfiles/modules";"Library/WebServer") of it
                ; folders ("usr/local/bin";"usr/local/sbin") whose (not exists folder "/usr/local/Cellar") of it
                ; folders ("bin";"sbin";"modules";"lib/httpd/modules";"usr/bin";"usr/sbin";"usr/lib64/httpd/modules";"root/usr/bin";"root/usr/sbin";"root/usr/lib64/httpd/modules") of (
                      folders of folders whose (name of it as lowercase starts with "php") of folders ("opt/homebrew/Cellar";"usr/local/Cellar";"home/linuxbrew/.linuxbrew/Cellar") of it
                    ; folders whose (exists matches (case insensitive regex "^(php|lsphp|ea-php|rh-php)") of name of it) of folders ("usr/local";"opt";"opt/alt";"opt/remi";"opt/rh";"opt/cpanel";"usr/local/lsws") of it
                    ; folders of folders ("opt/plesk/php";"Applications/MAMP/bin/php") of it
                    ; folders "opt/bitnami/php" of it
                    ; (it; folders whose (name of it != ".linuxbrew") of it; folders of folders (".phpbrew/php";".phpenv/versions";".asdf/installs/php") of it; folders (".config/herd-lite";"Library/Application Support/Herd") of it) of (folders of folders ("Users";"home") of it; folders "root" of it)
                  )
              ) of folder "/" of encoding "ISO-8859-1"
            ; folders (pathnames of parent folders of image files of processes whose (exists matches (case insensitive regex "^(php|php-cgi|php-fpm|lsphp|frankenphp)") of name of it)) of encoding "ISO-8859-1"
          )) whose (not exists (name of it, size of it, files of parent folder of it) whose (name of item 2 of it != item 0 of it and name of item 2 of it starts with item 0 of it and size of item 2 of it = item 1 of it))
        )
      ))
  )) of ("%0a" & concatenation "%0a" of (
      (preceding text of first "%09" of it & " | " & following text of first "%09" of it) of lines whose (it contains "%09") of files whose (name of it as lowercase = "yara_results_php.text" and size of it < 1048576) of folders "Logs" of folders "__Global" of data folders of client
    ; (preceding text of first " | " of it & " | " & (if exists matches (regex "^[0-9]+\.[0-9]+\.[0-9]+") of it then it else "unknown") of preceding text of first " |" of (following text of first " | PHP " of (it & " | PHP ?") & " |")) of following texts of firsts "=" of lines whose (it starts with "VULNERABLE=" or it starts with "UNVERIFIED=") of files whose (name of it as lowercase = "summary.txt" and size of it < 131072) of folders "YARA_PHP" of parent folders of data folders of client
  ) whose (exists matches (case insensitive regex "(^|[\\/])((php|php-cgi|php-fpm|lsphp|frankenphp)-?[0-9.]*(\.exe)?|(libphp|mod_php)[0-9.]*\.so|php[0-9]apache[0-9_]*\.dll) \| ") of it) & "%0a")
) whose (not (item 1 of it ends with " | unknown" and item 0 of it contains ("%0a" & preceding text of last " | " of item 1 of it & " | ") and not (item 0 of it contains ("%0a" & item 1 of it & "%0a"))))]]></Property>
	</Analysis>
</BES>
