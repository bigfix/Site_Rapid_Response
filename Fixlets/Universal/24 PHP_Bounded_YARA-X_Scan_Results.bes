<?xml version='1.0' encoding='utf-8'?>
<BES>
  <Analysis>
    <Title>PHP - Bounded YARA-X Scan Results - Windows, Linux and macOS</Title>
    <Description>&lt;style type="text/css"&gt;
.phpScan {font-family:Segoe UI,Tahoma,Arial,sans-serif;font-size:13px;line-height:1.45;color:#243447;max-width:1000px;margin:8px 12px 20px;}
.phpScan h2 {font-size:20px;color:#183953;margin:0 0 5px;}
.phpScan h3 {font-size:15px;color:#183953;margin:20px 0 8px;padding-bottom:5px;border-bottom:2px solid #dbe5ed;}
.phpScan p {margin:7px 0;}
.phpScan .recommend {background:#edf5fa;border-left:4px solid #28658a;padding:10px 12px;margin:12px 0;}
.phpScan table {width:100%;border-collapse:collapse;table-layout:fixed;margin:8px 0;}
.phpScan th {background:#edf1f5;text-align:left;font-weight:600;}
.phpScan td,.phpScan th {padding:8px;vertical-align:top;border-bottom:1px solid #dce3e9;word-wrap:break-word;}
.phpScan .setting {width:31%;}.phpScan .value {width:18%;}
.phpScan .mode {width:110px;}.phpScan .deep {background:#fff7e7;}
.phpScan .warning {color:#865000;font-weight:bold;}
.phpScan input,.phpScan select,.phpScan button {font-family:inherit;font-size:13px;}
.phpScan input {max-width:95%;}.phpScan input[type=text],.phpScan input:not([type]) {box-sizing:border-box;padding:5px;border:1px solid #9baab7;}
.phpScan select {padding:5px;max-width:100%;}.phpScan input[type=checkbox] {margin-top:3px;}
.phpScan .exclusion input {display:block;width:98%;margin:5px 0;}
.phpScan .hint {color:#516170;font-size:12px;}
.phpScan code {font-family:Consolas,monospace;font-size:12px;word-wrap:break-word;}
.phpScan .launch {border-top:1px solid #dce3e9;padding-top:12px;margin-top:15px;}
.phpScan button {background:#245b7d;color:white;border:1px solid #194766;padding:8px 16px;cursor:pointer;}
.phpScan button:focus,.phpScan input:focus,.phpScan select:focus {outline:2px solid #438bb7;outline-offset:1px;}
&lt;/style&gt;&lt;div class="phpScan"&gt;&lt;h2&gt;PHP scan results&lt;/h2&gt;&lt;p&gt;Four compact properties report the latest finished scan for &lt;strong&gt;CVE-2026-109618&lt;/strong&gt; and &lt;strong&gt;CVE-2026-109619&lt;/strong&gt;.&lt;/p&gt;&lt;div class="recommend"&gt;This Analysis reads saved results; it does not run a scan. Run the updated companion scanner to refresh the results.&lt;/div&gt;&lt;h3&gt;Properties&lt;/h3&gt;&lt;table&gt;&lt;tr&gt;&lt;th scope="col"&gt;Property&lt;/th&gt;&lt;th scope="col"&gt;What it shows&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;YARA PHP Vulnerable Detected&lt;/td&gt;&lt;td&gt;&lt;strong&gt;TRUE:&lt;/strong&gt; an upstream-affected runtime was detected.&lt;br /&gt;&lt;strong&gt;FALSE:&lt;/strong&gt; none found within the completed selected scope.&lt;br /&gt;&lt;strong&gt;UNKNOWN:&lt;/strong&gt; unavailable, incomplete or unverified results, followed by a short reason.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;YARA Vulnerable PHP Path and Version&lt;/td&gt;&lt;td&gt;One path and PHP version per result, up to 100. Vendor-managed affected versions are qualified until the vendor advisory confirms patch status.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;YARA PHP Last Scan&lt;/td&gt;&lt;td&gt;The last completed scan time and any coverage qualifier.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;YARA Last Scan Length&lt;/td&gt;&lt;td&gt;The scan duration in hours, minutes and seconds.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;h3&gt;When a result needs attention&lt;/h3&gt;&lt;p&gt;UNKNOWN reasons include file or time limits, unreadable locations, skipped oversized runtime candidates and unverified vendor patch status. Older results without a saved reason show a general explanation until rescanned. A positive finding stays TRUE even when other scan coverage is incomplete.&lt;/p&gt;&lt;h3&gt;Detailed scan log&lt;/h3&gt;&lt;p&gt;Find full findings and coverage details in &lt;code&gt;YARA_PHP/scan.log&lt;/code&gt; under the BigFix client state root.&lt;/p&gt;&lt;/div&gt;</Description>
    <Relevance>if (version of client &gt;= "9.5.7") then windows of operating system or (name of operating system starts with "Linux") or mac of operating system else false</Relevance>
    <Category>PHP Security Discovery</Category>
    <Property Name="YARA PHP Vulnerable Detected" ID="15" EvaluationPeriod="PT5M">substrings separated by "%0a" of ((if exists files (pathnames of files "summary.txt" whose (size of it &lt;= 131072) of folders "YARA_PHP" of parent folders of data folders of client) of encoding "UTF-8" then (if (number of (substrings separated by "%0a" of it) whose (it = "RESULT_FORMAT=2") = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "RESULT_FORMAT=") = 1 and number of (substrings separated by "%0a" of it) whose (it = "DETECTED=TRUE" or it = "DETECTED=FALSE" or it = "DETECTED=UNKNOWN") = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "DETECTED=") = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "LAST_SCAN=" and length of it &gt; 10) = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "LAST_SCAN=") = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "DURATION=" and length of it &gt; 9) = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "DURATION=") = 1) then (if exists (substrings separated by "%0a" of it) whose (it = "DETECTED=UNKNOWN") then (if exists (substrings separated by "%0a" of it) whose (it starts with "LAST_SCAN=" and it contains "Last attempt failed") then "UNKNOWN - Latest scan attempt failed; see scan.log" else if number of (substrings separated by "%0a" of it) whose (it starts with "UNKNOWN_REASON=") = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "UNKNOWN_REASON=" and length of it &gt; 15 and length of it &lt;= 815) = 1 then "UNKNOWN - " &amp; concatenation "" of following texts of firsts "UNKNOWN_REASON=" of (substrings separated by "%0a" of it) whose (it starts with "UNKNOWN_REASON=") else "UNKNOWN - Incomplete or unverified results; see scan.log") else (concatenation "%0a" of (following texts of firsts "DETECTED=" of (substrings separated by "%0a" of it) whose (it starts with "DETECTED=")))) else "UNKNOWN - Scan results missing or invalid; run the scan") of (concatenation "%0a" of lines of files (pathnames of files "summary.txt" whose (size of it &lt;= 131072) of folders "YARA_PHP" of parent folders of data folders of client) of encoding "UTF-8") else "UNKNOWN - Scan results missing or invalid; run the scan") | "UNKNOWN - Scan results unavailable; see scan.log")</Property>
    <Property Name="YARA Vulnerable PHP Path and Version" ID="16" EvaluationPeriod="PT5M">substrings separated by "%0a" of ((if exists files (pathnames of files "summary.txt" whose (size of it &lt;= 131072) of folders "YARA_PHP" of parent folders of data folders of client) of encoding "UTF-8" then (if (number of (substrings separated by "%0a" of it) whose (it = "RESULT_FORMAT=2") = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "RESULT_FORMAT=") = 1 and number of (substrings separated by "%0a" of it) whose (it = "DETECTED=TRUE" or it = "DETECTED=FALSE" or it = "DETECTED=UNKNOWN") = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "DETECTED=") = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "LAST_SCAN=" and length of it &gt; 10) = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "LAST_SCAN=") = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "DURATION=" and length of it &gt; 9) = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "DURATION=") = 1) then (concatenation "%0a" of ((if exists (substrings separated by "%0a" of it) whose (it starts with "VULNERABLE=" or it starts with "UNVERIFIED=") then following texts of firsts "=" of (substrings separated by "%0a" of it) whose (it starts with "VULNERABLE=" or it starts with "UNVERIFIED=") else if exists (substrings separated by "%0a" of it) whose (it = "DETECTED=FALSE") then "None detected" else "Results unverified or incomplete; see scan.log"))) else "Results unavailable; run the updated scan") of (concatenation "%0a" of lines of files (pathnames of files "summary.txt" whose (size of it &lt;= 131072) of folders "YARA_PHP" of parent folders of data folders of client) of encoding "UTF-8") else "Results unavailable; run the updated scan") | "Results unavailable; run the updated scan")</Property>
    <Property Name="YARA PHP Last Scan" ID="17" EvaluationPeriod="PT5M">substrings separated by "%0a" of ((if exists files (pathnames of files "summary.txt" whose (size of it &lt;= 131072) of folders "YARA_PHP" of parent folders of data folders of client) of encoding "UTF-8" then (if (number of (substrings separated by "%0a" of it) whose (it = "RESULT_FORMAT=2") = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "RESULT_FORMAT=") = 1 and number of (substrings separated by "%0a" of it) whose (it = "DETECTED=TRUE" or it = "DETECTED=FALSE" or it = "DETECTED=UNKNOWN") = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "DETECTED=") = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "LAST_SCAN=" and length of it &gt; 10) = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "LAST_SCAN=") = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "DURATION=" and length of it &gt; 9) = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "DURATION=") = 1) then (concatenation "%0a" of (following texts of firsts "LAST_SCAN=" of (substrings separated by "%0a" of it) whose (it starts with "LAST_SCAN="))) else "Results unavailable; run the updated scan") of (concatenation "%0a" of lines of files (pathnames of files "summary.txt" whose (size of it &lt;= 131072) of folders "YARA_PHP" of parent folders of data folders of client) of encoding "UTF-8") else (if exists files "summary.txt" of folders "YARA_PHP" of parent folders of data folders of client then "Results unavailable; run the updated scan" else "NO SCAN")) | "Results unavailable; run the updated scan")</Property>
    <Property Name="YARA Last Scan Length" ID="18" EvaluationPeriod="PT5M">substrings separated by "%0a" of ((if exists files (pathnames of files "summary.txt" whose (size of it &lt;= 131072) of folders "YARA_PHP" of parent folders of data folders of client) of encoding "UTF-8" then (if (number of (substrings separated by "%0a" of it) whose (it = "RESULT_FORMAT=2") = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "RESULT_FORMAT=") = 1 and number of (substrings separated by "%0a" of it) whose (it = "DETECTED=TRUE" or it = "DETECTED=FALSE" or it = "DETECTED=UNKNOWN") = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "DETECTED=") = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "LAST_SCAN=" and length of it &gt; 10) = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "LAST_SCAN=") = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "DURATION=" and length of it &gt; 9) = 1 and number of (substrings separated by "%0a" of it) whose (it starts with "DURATION=") = 1) then (concatenation "%0a" of (following texts of firsts "DURATION=" of (substrings separated by "%0a" of it) whose (it starts with "DURATION="))) else "Results unavailable; run the updated scan") of (concatenation "%0a" of lines of files (pathnames of files "summary.txt" whose (size of it &lt;= 131072) of folders "YARA_PHP" of parent folders of data folders of client) of encoding "UTF-8") else (if exists files "summary.txt" of folders "YARA_PHP" of parent folders of data folders of client then "Results unavailable; run the updated scan" else "NO SCAN")) | "Results unavailable; run the updated scan")</Property>
  </Analysis>
</BES>
