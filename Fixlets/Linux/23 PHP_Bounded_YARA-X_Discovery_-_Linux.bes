wait /bin/bash "{parameter "work"}/background-unix.sh" launch Linux "{parameter "output"}" "{parameter "work"}" /bin/bash "{parameter "work"}/scan-linux.sh" --engine "{parameter "work"}/yr" --engine-sha256 {parameter "PHPYaraEngineSha256"} --rules "{parameter "work"}/php-detect.yar" --output "{parameter "output"}" --archive "{parameter "work"}/engine.tar.gz" --archive-sha256 {parameter "PHPYaraArchiveSha256"} --enumeration-seconds {parameter "PHPEnumerationSeconds"} --scan-seconds {parameter "PHPScanSeconds"} --max-files {parameter "PHPMaxFiles"} --candidate-gb {parameter "PHPCandidateGB"} --max-file-mb {parameter "PHPMaxFileMB"} --cpu-limit {parameter "PHPCpuLimit"} --threads {parameter "PHPYaraThreads"} --exclude-directories-hex "{parameter "PHPExcludeDirectoriesHex"}" --include-build-text {parameter "PHPIncludeBuildText"} --include-broader-locations {parameter "PHPIncludeBroaderLocations"} --include-nonstandard-names {parameter "PHPIncludeNonstandardNames"}
parameter "scanExit" = "{exit code of action}"
continue if {parameter "scanExit" = "0"}
exit 0
]]></ActionScript>
      <SuccessCriteria Option="RunToCompletion"/>
    </DefaultAction>
  </Task>
</BES>
