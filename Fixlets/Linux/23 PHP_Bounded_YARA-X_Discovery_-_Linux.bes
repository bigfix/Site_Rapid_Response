#!/bin/bash
# Bounded, dependency-light PHP discovery. Bash 4+, GNU find/coreutils, awk,
# tar/gzip and flock (util-linux); no Python, jq, compiler or PHP execution.
# YARA text parsing follows the Apache-2.0 Rapid Response scanner approach.
set -euo pipefail
export LC_ALL=C
umask 077
engine= rules= output= archive= engine_sha256= archive_sha256=
enumeration_seconds=0 scan_seconds=0 max_files=0 candidate_gb=0
max_file_mb=512 cpu_limit=10 yara_threads=2 include_build_text=0 include_broader_locations=0 include_nonstandard_names=0
roots=()

valid_utf8() {{
    local text=$1 i byte remaining=0 low=128 high=191
    for ((i=0;i<${{#text};i++)); do
        printf -v byte '%d' "'${{text:i:1}"
        if ((remaining)); then
            ((byte>=low && byte<=high)) || return 1
            remaining=$((remaining-1)); low=128; high=191
        elif ((byte<128)); then :
        elif ((byte>=194 && byte<=223)); then remaining=1
        elif ((byte>=224 && byte<=239)); then
            remaining=2; ((byte!=224)) || low=160; ((byte!=237)) || high=159
        elif ((byte>=240 && byte<=244)); then
            remaining=3; ((byte!=240)) || low=144; ((byte!=244)) || high=143
        else return 1; fi
    done
    ((remaining==0))
}
# Shared v3 workspace/path helpers, embedded in both Unix scanners.
cleanup_abandoned_work() {{
    local candidate marker metadata owner mode
    for candidate in "$output"/work-*; do
        [[ -d $candidate && ! -L $candidate && $candidate != "$work" ]] || continue
        [[ ${{candidate##*/} =~ ^work-[0-9]+-[0-9]+-[0-9]+$ ]] || continue
        metadata=$(stat -c '%u %a' "$candidate" 2>/dev/null) || continue
        read -r owner mode <<<"$metadata"
        [[ $owner = "$EUID" && $mode =~ ^[0-7]+$ ]] || continue
        (( (8#$mode & 0022)==0 )) || continue
        [[ -f $candidate/attempt.started && ! -L $candidate/attempt.started ]] || continue
        metadata=$(stat -c '%u %a' "$candidate/attempt.started" 2>/dev/null) || continue
        read -r owner mode <<<"$metadata"
        [[ $owner = "$EUID" && $mode =~ ^[0-7]+$ ]] || continue
        (( (8#$mode & 0022)==0 )) || continue
        marker=
        IFS= read -r marker <"$candidate/attempt.started" || continue
        [[ $marker = PHP_YARA_WORKSPACE_V3 ]] || continue
        # Only a prior launched-v3 workspace is eligible under the global lock.
        # Unmarked folders may still be in ActionScript preparation: leave them.
        rm -rf -- "$candidate"
    done
    [[ ! -L $work/attempt.started ]] || return 1
    printf 'PHP_YARA_WORKSPACE_V3\n' >"$work/attempt.started"
}

scan_list_path_safe() {{
    [[ $1 != *[[:cntrl:]]* ]] || return 1
    [[ $1 != *[!\ -\~]* ]] || valid_utf8 "$1"
}

stage_candidate() {{
    local available blocks copied
    available=$(df -Pk "$work" 2>/dev/null | awk 'NR>1 {{v=$4} END {{if(v ~ /^[0-9]+$/) print v}') || available=
    blocks=$(((size+1023)/1024))
    if [[ ! $available =~ ^[0-9]+$ ]] || ((available<blocks+65536)); then
        reasons+=('insufficient free space for unusual-path staging')
        return 1
    fi
    # Non-POSIX Bash ulimit -f uses 1024-byte blocks. Bound growing files too.
    if ! (ulimit -f "$blocks"; timeout -k 2 "$((enumeration_seconds==0 ? 0 : (deadline-SECONDS>0 ? deadline-SECONDS : 1)))" cp --reflink=auto -- "$path" "$scan_path"); then
        rm -f -- "$scan_path"
        read_errors=$((read_errors+1))
        return 1
    fi
    copied=$(stat -c %s "$scan_path" 2>/dev/null) || copied=
    if [[ $copied != "$size" ]]; then
        rm -f -- "$scan_path"
        read_errors=$((read_errors+1))
        return 1
    fi
}

exclude_directories_hex=x
while (($#)); do
    (($# >= 2)) || {{ echo 'Missing argument' >&2; exit 2; }
    case "$1" in
        --engine) engine=$2;; --engine-sha256) engine_sha256=$2;; --rules) rules=$2;; --output) output=$2;;
        --archive) archive=$2;; --archive-sha256) archive_sha256=$2;; --root) roots+=("$2");;
        --enumeration-seconds) enumeration_seconds=$2;; --scan-seconds) scan_seconds=$2;;
        --max-files) max_files=$2;; --candidate-gb) candidate_gb=$2;; --max-file-mb) max_file_mb=$2;;
        --cpu-limit) cpu_limit=$2;; --threads) yara_threads=$2;; --include-build-text) include_build_text=$2;;
        --include-broader-locations) include_broader_locations=$2;; --include-nonstandard-names) include_nonstandard_names=$2;;
        --exclude-directories-hex) exclude_directories_hex=$2;;
        *) echo 'Unknown argument' >&2; exit 2;;
    esac
    shift 2
done
for name in enumeration_seconds scan_seconds max_files candidate_gb max_file_mb cpu_limit yara_threads include_build_text include_broader_locations include_nonstandard_names; do
    [[ ${{!name} =~ ^[0-9]{{1,9}$ ]] || {{ echo "Invalid $name" >&2; exit 2; }
done
((enumeration_seconds>=0 && enumeration_seconds<=3600 && scan_seconds>=0 && scan_seconds<=3600 && max_files>=0 && max_files<=50000000 && candidate_gb>=0 && candidate_gb<=100 && max_file_mb>=1 && max_file_mb<=512 && cpu_limit>=0 && cpu_limit<=10 && yara_threads>=1 && yara_threads<=4 && include_build_text<=1 && include_broader_locations<=1 && include_nonstandard_names<=1)) || {{ echo 'Scan setting outside its allowed range' >&2; exit 2; }
[[ $output = /* && $engine = /* && $rules = /* ]] || {{ echo 'Engine, rule and output paths must be absolute' >&2; exit 2; }
missing=()
for command in df find timeout stat awk sort sha256sum tar gzip flock date mkdir mv chmod dirname mkfifo cp nice cat head rm; do
    command -v "$command" >/dev/null 2>&1 || missing+=("$command")
done
