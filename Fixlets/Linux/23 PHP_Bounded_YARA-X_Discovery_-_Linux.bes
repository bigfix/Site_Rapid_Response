# group before cleanup, even when the direct worker has already exited.
stop_child
if [[ -f $output/summary.txt && ! -L $output/summary.txt ]] && grep -qx "RUN_ID=$run_id" "$output/summary.txt"; then
    case "$result" in 0) final_state=COMPLETED;; 10) final_state=PARTIAL;; *) final_state=FAILED;; esac
fi
exit "$result"
