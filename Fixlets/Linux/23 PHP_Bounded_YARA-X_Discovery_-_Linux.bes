hash() {{ sha256sum -- "$1" | awk '{{print $1}'; }
[[ $(hash "$rules") = d5fc6eed5b935a2048726831d6735140a6f312345b0d92df870344500fffdc7f ]] || {{ echo 'Rule hash mismatch' >&2; exit 2; }
if [[ ! -f $engine ]]; then
