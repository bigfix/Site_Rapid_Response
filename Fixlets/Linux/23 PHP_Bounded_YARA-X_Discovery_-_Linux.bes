#!/bin/bash
# A short launcher hands the scan to a detached supervisor. No Python needed.
set -euo pipefail
export LC_ALL=C PATH=/usr/bin:/bin:/usr/sbin:/sbin
umask 077
mode=$1 platform=$2 output=$3 work=$4
shift 4
[[ $output = /* && $work = "$output"/work-* && ${{work##*/} =~ ^work-[0-9]+-[0-9]+-[0-9]+$ ]] || exit 2
ancestor=$work
while [[ $ancestor != / ]]; do
    [[ ! -L $ancestor ]] || exit 2
    ancestor=${{ancestor%/*}; [[ -n $ancestor ]] || ancestor=/
done
[[ -d $work && -d $output ]] || exit 2
for leaf in background.lock scan-state.txt scan-state.txt.new; do [[ ! -L $output/$leaf ]] || exit 2; done
for leaf in launch.ready launch.accepted attempt.admitted; do [[ ! -e $work/$leaf && ! -L $work/$leaf ]] || [[ $mode = supervise ]] || exit 2; done
if [[ $platform = Mac ]]; then
    metadata=$(stat -f '%u %Lp' "$output"); work_metadata=$(stat -f '%u %Lp' "$work")
elif [[ $platform = Linux ]]; then
    metadata=$(stat -c '%u %a' "$output"); work_metadata=$(stat -c '%u %a' "$work")
else exit 2; fi
read -r owner permissions <<<"$metadata"; read -r work_owner work_permissions <<<"$work_metadata"
[[ $owner = "$EUID" && $work_owner = "$EUID" && $permissions =~ ^[0-7]+$ && $work_permissions =~ ^[0-7]+$ ]] || exit 2
(( (8#$permissions & 0022)==0 && (8#$work_permissions & 0022)==0 )) || exit 2
if [[ $mode = launch ]]; then
    # Detach standard streams and preserve ignored HUP across exec. Apple's
    # nohup can fail without a console when launched by the BigFix daemon.
    if [[ $platform = Mac ]]; then
        (
            trap '' HUP
            exec /bin/zsh -f "$work/mac-lock.zsh" "$output/background.lock" "$work/background-unix.sh" supervise "$platform" "$output" "$work" "$@"
        ) </dev/null >/dev/null 2>&1 &
    else
        nohup /bin/bash "$work/background-unix.sh" supervise "$platform" "$output" "$work" "$@" </dev/null >/dev/null 2>&1 &
    fi
    supervisor=$!
    deadline=$((SECONDS+25))
    while [[ ! -f $work/launch.ready ]]; do
        if ! kill -0 "$supervisor" 2>/dev/null; then
            result=0; wait "$supervisor" || result=$?
            # This exact attempt never admitted a worker; no persistent results removed.
            rm -rf -- "$work"
            ((result!=0)) || result=2
            exit "$result"
        fi
        ((SECONDS<deadline)) || exit 2
        sleep 0.1
    done
    IFS= read -r admission <"$work/launch.ready"
    printf 'accepted\n' >"$work/launch.accepted"
    [[ $admission = RUNNING || $admission = COMPLETED || $admission = PARTIAL ]] || exit 2
    exit 0
fi
[[ $mode = supervise ]] || exit 2
if [[ $platform = Linux ]]; then
    exec 8>"$output/background.lock"
    flock -n 8 || exit 75
fi
run_id=${{work##*/}
started=$(date -u '+%a, %d %b %Y %H:%M:%S +0000')
child= admitted=0 final_state=FAILED
state() {{
    local value=$1
    printf 'STATE_FORMAT=1\nRUN_ID=%s\nSTATE=%s\nSTARTED=%s\nUPDATED=%s\n' "$run_id" "$value" "$started" "$(date -u '+%a, %d %b %Y %H:%M:%S +0000')" >"$output/scan-state.txt.new"
    mv -f -- "$output/scan-state.txt.new" "$output/scan-state.txt"
}
stop_child() {{
    [[ -n $child ]] || return 0
    # Job control gives this child and its descendants their own process group.
    kill -TERM -- "-$child" 2>/dev/null || :
    for ((n=0;n<50;n++)); do kill -0 "$child" 2>/dev/null || break; sleep 0.1; done
    kill -KILL -- "-$child" 2>/dev/null || :
    wait "$child" 2>/dev/null || :
    child=
}
cleanup() {{
    result=$?; trap - EXIT INT TERM
    stop_child
    if ((admitted)); then state "$final_state" || :; fi
    # Give the short launcher time to observe admission even for a subsecond scan.
    deadline=$((SECONDS+25))
    while [[ -f $work/launch.ready && ! -f $work/launch.accepted ]] && ((SECONDS<deadline)); do sleep 0.1; done
    # Only the current validated work-* directory; never summary.txt/log/state/locks.
    rm -rf -- "$work"
    exit "$result"
}
trap cleanup EXIT
trap 'exit 130' INT TERM
export PHP_BACKGROUND_RUN_ID=$run_id
set -m
( exec 8>&-; exec "$@" ) </dev/null >/dev/null 2>&1 &
child=$!
admission_deadline=$((SECONDS+20))
while [[ ! -f $work/attempt.admitted ]]; do
    kill -0 "$child" 2>/dev/null || {{ result=0; wait "$child" || result=$?; child=; exit "${{result:-2}"; }
    ((SECONDS<admission_deadline)) || exit 2
    sleep 0.1
done
admitted=1
state RUNNING
printf 'RUNNING\n' >"$work/launch.ready"
# Budgets are validated again by the worker. The outer guard also covers setup.
search=0 scan=0 previous=
for value in "$@"; do
    case "$previous" in --enumeration-seconds) search=$value;; --scan-seconds) scan=$value;; esac
    previous=$value
done
[[ $search =~ ^[0-9]{{1,4}$ && $scan =~ ^[0-9]{{1,4}$ ]] || exit 2
deadline=$((SECONDS+search+scan+120)); next_heartbeat=$SECONDS
while kill -0 "$child" 2>/dev/null; do
    ((search==0 || scan==0 || SECONDS<deadline)) || exit 124
