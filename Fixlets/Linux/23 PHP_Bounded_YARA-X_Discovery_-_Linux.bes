#!/bin/bash
# One read-only worker serves all header requests. Bash builtins preserve every
# byte, including NUL/newline/high bytes, without starting od for every file.
# The parent bounds each FIFO response and kills/restarts a stalled worker.
set -eo pipefail
export LC_ALL=C PATH=/usr/bin:/bin:/usr/sbin:/sbin
umask 077
(($#==2)) || exit 2
[[ $1 = /* && $2 = /* && -p $1 && -p $2 && ! -L $1 && ! -L $2 ]] || exit 2
exec 7<"$1" 6>"$2"
while IFS= read -r -d '' path <&7; do
    header=; status=ERROR
    if [[ -f $path && ! -L $path ]]; then
        if {{
            for ((index=0;index<20;index++)); do
                byte=
                if ! IFS= read -r -n 1 -d '' byte <&8; then break; fi
                # Bash3.2 can expose bytes >=128 as signed char values.
                printf -v octet '%d' "'$byte"
                printf -v hexadecimal '%02x' "$((octet & 255))"
                header+=$hexadecimal
            done
        } 8<"$path" 2>/dev/null; then
            [[ -z $header ]] || status=OK
        fi
    fi
    printf '%s:%s\0' "$status" "$header" >&6 || exit 0
done
END_PHP_HYBRID_49f6302bed220249
