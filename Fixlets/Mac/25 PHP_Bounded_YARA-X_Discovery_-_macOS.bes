#!/bin/zsh -f
# Stock zsh provides a watchdog without GNU timeout or orphaned sleep children.
# Only the child created here is signalled. The watchdog is reaped on every exit.
emulate -R zsh
setopt NO_UNSET
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
(( $# >= 3 )) || exit 2
seconds=$1
grace=$2
shift 2
[[ $seconds = <0-7200> && $grace = <1-10> ]] || exit 2
zmodload zsh/zselect || exit 2
child= watcher= result=0
cleanup() {{
    trap - TERM INT HUP
    [[ -z $watcher ]] || {{ kill -TERM "$watcher" 2>/dev/null; wait "$watcher" 2>/dev/null; }
    if [[ -n $child ]]; then
        kill -TERM "$child" 2>/dev/null
        zselect -t 10 >/dev/null 2>&1
        kill -KILL "$child" 2>/dev/null
        wait "$child" 2>/dev/null
    fi
}
trap 'cleanup; exit 130' TERM INT HUP
"$@" &
child=$!
if ((seconds>0)); then
(
    trap - TERM INT HUP
    zselect -t $((seconds * 100)) >/dev/null 2>&1
    kill -TERM "$child" 2>/dev/null || exit 0
    zselect -t $((grace * 100)) >/dev/null 2>&1
    kill -KILL "$child" 2>/dev/null
) &
watcher=$!
fi
wait "$child" || result=$?
child=
if [[ -n $watcher ]]; then
    kill -TERM "$watcher" 2>/dev/null
    wait "$watcher" 2>/dev/null
fi
watcher=
trap - TERM INT HUP
exit "$result"
END_PHP_HYBRID_eb3f9497fdb402ce
