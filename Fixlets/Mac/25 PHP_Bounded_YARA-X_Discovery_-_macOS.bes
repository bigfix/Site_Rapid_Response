    elif (( (major==5 && minor>=4) || major==7 || (major==8 && minor<2) )); then affected=1
    else unknown=$((unknown+1)); printf '%s | PHP %s | Version assessment unavailable\n' "$display" "$version" >>"$work/unverified.txt"; fi
    if ((affected)); then
