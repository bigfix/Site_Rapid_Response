<?xml version="1.0" encoding="UTF-8"?>
<BES>
  <Task>
    <Title>PHP YARA Vulnerability Scanner – CVE-2026-109618 and CVE-2026-109619 (Mac) V7</Title>
    <Description><![CDATA[<style>.php-hybrid{font-family:Segoe UI,Arial,sans-serif;max-width:1100px;line-height:1.45;color:#243447}.php-hybrid table{border-collapse:collapse;width:100%;margin:12px 0}.php-hybrid td,.php-hybrid th{padding:9px;border:1px solid #d6dee5;text-align:left;vertical-align:top}.php-hybrid th{background:#edf2f6}.php-hybrid .notice{padding:12px;background:#edf5fc;border-left:4px solid #356b98}.php-hybrid input{max-width:100%}</style>
<div class="php-hybrid"><h2>PHP YARA Vulnerability Scanner V7</h2>
<p>Detects PHP runtimes affected by CVE-2026-109618 and CVE-2026-109619 without executing PHP. Use the matching V7 analysis. Scanner and analysis versions should match.</p>
<p class="notice"><strong>Normal is the default: 2 workers, low priority, no CPU throttle. Use Gentle on busy or sensitive systems.</strong> Quick selects Gentle; Normal and Deep select Fast. You can adjust resource usage after selecting the scan type. Every mode keeps the 512 MiB individual-file limit.</p>
<h3>1. Coverage</h3><select id="PHPScanPreset" onchange="PhpScan.preset(this.value);"><option value="quick">Quick</option><option value="normal" selected="selected">Normal (default)</option><option value="deep">Deep</option><option value="custom" disabled="disabled">Custom</option></select>
<table><tr><th>Scan</th><th>Coverage and tradeoff</th></tr><tr><td>Quick</td><td>Standard PHP runtime names in usual application locations; fastest, but can miss renamed runtimes.</td></tr><tr><td>Normal</td><td>Includes renamed runtimes while keeping usual location exclusions.</td></tr><tr><td>Deep</td><td>Adds further OS and application locations, selected caches and PHP build evidence. Permanent data/cache exclusions, including Windows.old, still apply. Allows 60 minutes for file search and 60 minutes for YARA scanning.</td></tr></table>
<h3>2. Resource usage</h3><select id="PHPResourcePreset" onchange="PhpScan.resource(this.value);"><option value="gentle">Gentle (busy systems)</option><option value="fast" selected="selected">Fast (default)</option><option value="custom" disabled="disabled">Custom</option></select>
<p><strong>Gentle:</strong> 2 workers, engine throttle 10%, low CPU priority. <strong>Fast, default:</strong> 2 workers, no throttle, low CPU priority. Low priority does not prevent disk or memory contention; use Fast when the system is quiet.</p>
<h3>3. Advanced settings</h3><p>Changing the scan type selects its recommended resource settings and retains your directory exclusions. Change advanced settings afterward if needed. All times below are in minutes.</p><table><tr><th>Setting</th><th>Value</th><th>Purpose</th></tr><tr><td><label for="PHPExcludeDirectoriesHex">Additional directory exclusions (comma-separated)</label></td><td><input id="PHPExcludeDirectoriesHex" value="" size="48" maxlength="4096" /></td><td>Optional comma-separated directory exclusions; use /data/* or C:\folder\* to exclude a whole tree. A trailing slash alone excludes direct files only. Windows accepts either slash.</td></tr><tr><td><label for="PHPIncludeNonstandardNames">Include renamed or nonstandard PHP binaries (slower)</label></td><td><input type="checkbox" id="PHPIncludeNonstandardNames" checked="checked" onchange="PhpScan.syncPreset();" /></td><td>Includes renamed native runtimes; excluding them can miss custom PHP applications.</td></tr><tr><td><label for="PHPIncludeBroaderLocations">Include OS, recovery, cache and data locations (slower)</label></td><td><input type="checkbox" id="PHPIncludeBroaderLocations" onchange="PhpScan.syncPreset();" /></td><td>Includes normally skipped operating-system, cache and data locations.</td></tr><tr><td><label for="PHPIncludeBuildText">Include PHP source/build text (slower)</label></td><td><input type="checkbox" id="PHPIncludeBuildText" onchange="PhpScan.syncPreset();" /></td><td>Includes build evidence, which alone does not prove an installed vulnerable runtime.</td></tr><tr><td><label for="PHPEnumerationSeconds">File search time (minutes)</label></td><td><input id="PHPEnumerationSeconds" value="0" size="12" onchange="PhpScan.syncPreset();" /></td><td>Optional file-search time limit in minutes; 0 means no limit. Quick and Normal use 0; Deep uses 60.</td></tr><tr><td><label for="PHPScanSeconds">Content scan time (minutes)</label></td><td><input id="PHPScanSeconds" value="0" size="12" onchange="PhpScan.syncPreset();" /></td><td>Optional YARA content-scan time limit in minutes; 0 means no limit. Quick and Normal use 0; Deep uses 60.</td></tr><tr><td><label for="PHPMaxFiles">Maximum files checked (optional)</label></td><td><label><input id="PHPUseFileLimit" type="checkbox" onchange="PhpScan.syncPreset();" /> Limit files checked</label><br /><input id="PHPMaxFiles" value="50000000" size="12" onchange="PhpScan.syncPreset();" /></td><td>Enable only if you want a file-count limit. Unchecked means no limit for every scan type; the suggested enabled value is 50,000,000.</td></tr><tr><td><label for="PHPCandidateGB">Total input limit (GiB; 0 = off)</label></td><td><input id="PHPCandidateGB" value="0" size="12" onchange="PhpScan.syncPreset();" /></td><td>Optional cumulative input limit; 0 disables it. Time, individual-file and other safeguards remain active.</td></tr><tr><td><label for="PHPMaxFileMB">Maximum individual file size (MiB)</label></td><td><input id="PHPMaxFileMB" value="512" size="12" onchange="PhpScan.syncPreset();" /></td><td>Files at or above 512 MiB receive only a bounded header check; possible runtimes remain UNKNOWN.</td></tr><tr><td><label for="PHPCpuLimit">YARA CPU setting (%)</label></td><td><input id="PHPCpuLimit" value="0" size="12" onchange="PhpScan.syncPreset();" /></td><td>10 enables the engine throttle; 0 disables it. This is not a guaranteed whole-system CPU percentage.</td></tr><tr><td><label for="PHPYaraThreads">YARA workers</label></td><td><input id="PHPYaraThreads" value="2" size="12" onchange="PhpScan.syncPreset();" /></td><td>Concurrent YARA workers: use 2 normally; 4 may help a quiet Windows Deep scan but can increase contention.</td></tr></table>
<p>Linux and Mac submit ordinary candidates directly to YARA-X. Windows also submits ordinary candidates directly to YARA-X using PowerShell and built-in process support. No local C# compilation, scheduled tasks or Python are required. Oversized candidates receive only a small header check. Remote mounts, cloud placeholders and permanent exclusions remain excluded.</p>
<p>On Mac, specific Apple privacy, identity and personal-data stores are excluded. Desktop, Documents, Downloads, development folders and general application support remain in scope. On Mac, access-denied locations are skipped and recorded in scan.log, without making the scan Partial or UNKNOWN. FALSE means no vulnerable PHP was found in the accessible files; it does not confirm unreadable locations are clear. Running as root does not bypass macOS privacy controls.</p>
<p>The BigFix action returns after launch; results update after the background scan completes. TRUE means affected runtime evidence; FALSE means none found within the completed scan scope (accessible files on Mac); UNKNOWN includes a reason. Vendor patch status and web exposure require separate verification.</p>
<p>Results and detailed scan.log are under the BigFix client root in <code>YARA_PHP</code>. Previous completed results remain available while another scan runs.</p>
<p><a href="#" onclick="return PhpScan.prepare();">Start scan with these settings</a></p></div><script type="text/javascript">var phpScanFields = [{"key": "PHPExcludeDirectoriesHex", "label": "Additional directory exclusions (comma-separated)", "text": true}, {"key": "PHPIncludeNonstandardNames", "label": "Include renamed or nonstandard PHP binaries (slower)", "min": 0, "max": 1, "checkbox": true}, {"key": "PHPIncludeBroaderLocations", "label": "Include OS, recovery, cache and data locations (slower)", "min": 0, "max": 1, "checkbox": true}, {"key": "PHPIncludeBuildText", "label": "Include PHP source/build text (slower)", "min": 0, "max": 1, "checkbox": true}, {"key": "PHPEnumerationSeconds", "label": "File search time (minutes)", "min": 0, "max": 3600, "multiplier": 60}, {"key": "PHPScanSeconds", "label": "Content scan time (minutes)", "min": 0, "max": 3600, "multiplier": 60}, {"key": "PHPMaxFiles", "label": "Maximum files checked (optional)", "min": 1, "max": 50000000}, {"key": "PHPCandidateGB", "label": "Total input limit (GiB; 0 = off)", "min": 0, "max": 100}, {"key": "PHPMaxFileMB", "label": "Maximum individual file size (MiB)", "min": 16, "max": 512}, {"key": "PHPCpuLimit", "label": "YARA CPU setting (%)", "min": 0, "max": 10}, {"key": "PHPYaraThreads", "label": "YARA workers", "min": 1, "max": 4}];
var phpScanWindows = false;
/* Console JScript compatible: no JSON dependency, eval, credentials or target selection. */
var PhpScan = (function () {
    function parameters(values) {
        var fields = phpScanFields, selected = {}, index, field, text, number, multiplier, minimum, maximum;
        for (index = 0; index < fields.length; index++) {
            field = fields[index];
            text = String(values[field.key]);
            if (field.text) {
                /* Encode UTF-8 bytes, never interpolate a directory into script code. */
                if (/[\x00-\x1f\x7f]/.test(text)) { throw new Error('Exclusions cannot contain control characters.'); }
                var entries = text.split(','), clean = [], j, entry, encoded, hex = 'x', k, byte;
                for (j = 0; j < entries.length; j++) {
                    entry = entries[j].replace(/^\s+|\s+$/g, '');
                    if (!entry) { continue; }
                    var prefix = phpScanWindows ? /^([A-Za-z]:[\\\/]|\*[\\\/])/ : /^(\/|\*\/)/;
                    var relative = phpScanWindows ? /(^|[\\\/])\.{1,2}([\\\/]|$)/ : /(^|\/)\.{1,2}(\/|$)/;
                    if (!prefix.test(entry) || relative.test(entry)) {
                        throw new Error('Use absolute exclusion paths or a leading */; . and .. segments are not allowed.');
                    }
                    clean.push(entry);
                }
                if (clean.length > 32) { throw new Error('Use at most 32 directory exclusions.'); }
                encoded = encodeURIComponent(clean.join(','));
                for (k = 0; k < encoded.length; k++) {
                    if (encoded.charAt(k) === '%') { byte = encoded.substr(k + 1, 2); k += 2; }
                    else { byte = encoded.charCodeAt(k).toString(16); if (byte.length < 2) { byte = '0' + byte; } }
                    hex += byte.toLowerCase();
                }
                if (hex.length > 8193) { throw new Error('Directory exclusions must fit within 4096 UTF-8 bytes.'); }
                selected[field.key] = hex;
                continue;
            }
            if (!/^[0-9]{1,9}$/.test(text)) { throw new Error(field.label + ': enter a whole number.'); }
            number = Number(text);
            multiplier = field.multiplier || 1;
            minimum = Math.ceil(field.min / multiplier);
            maximum = Math.floor(field.max / multiplier);
            if (number < minimum || number > maximum) { throw new Error(field.label + ': use ' + minimum + ' to ' + maximum + '.'); }
            number = number * multiplier;
            selected[field.key] = String(number);
        }
        selected.PHPMaxFiles = String(values.PHPUseFileLimit) === '1' ? selected.PHPMaxFiles : '0';
        return selected;
    }
    function prepare() {
        try {
            var values = {}, index, field;
            for (index = 0; index < phpScanFields.length; index++) {
                field = phpScanFields[index];
                values[field.key] = field.checkbox ? (document.getElementById(field.key).checked ? '1' : '0') : document.getElementById(field.key).value;
            }
            values.PHPUseFileLimit = document.getElementById('PHPUseFileLimit').checked ? '1' : '0';
            var selected = parameters(values);
            if (typeof TakeFixletAction === 'undefined' || typeof Relevance === 'undefined') {
                throw new Error('Open this content in the BigFix Console to use this settings form. API/WebUI launches use defaults unless action parameters are supplied.');
            }
            /* These are ordinary, nonsecret action parameters. The Console */
            /* obtains the current Task's Action1; no XML or script is rebuilt. */
            TakeFixletAction(Relevance('id of current fixlet'), Relevance('id of current bes site'), 'Action1', selected);
        } catch (error) { alert('Cannot prepare scan. ' + error.message); }
        return false;
    }

    var scopes = {"quick": {"PHPEnumerationSeconds": 0, "PHPScanSeconds": 0, "PHPMaxFiles": 50000000, "PHPCandidateGB": 0, "PHPMaxFileMB": 512, "PHPIncludeNonstandardNames": false, "PHPIncludeBroaderLocations": false, "PHPIncludeBuildText": false, "PHPCpuLimit": 10, "PHPYaraThreads": 2}, "normal": {"PHPEnumerationSeconds": 0, "PHPScanSeconds": 0, "PHPMaxFiles": 50000000, "PHPCandidateGB": 0, "PHPMaxFileMB": 512, "PHPIncludeNonstandardNames": true, "PHPIncludeBroaderLocations": false, "PHPIncludeBuildText": false, "PHPCpuLimit": 0, "PHPYaraThreads": 2}, "deep": {"PHPEnumerationSeconds": 60, "PHPScanSeconds": 60, "PHPMaxFiles": 50000000, "PHPCandidateGB": 0, "PHPMaxFileMB": 512, "PHPIncludeNonstandardNames": true, "PHPIncludeBroaderLocations": true, "PHPIncludeBuildText": true, "PHPCpuLimit": 0, "PHPYaraThreads": 2}};

    function apply(values) {
        var i, field, node;
        for (i = 0; i < phpScanFields.length; i++) {
            field = phpScanFields[i];
            if (!Object.prototype.hasOwnProperty.call(values, field.key)) continue;
            node = document.getElementById(field.key);
            if (field.checkbox) node.checked = values[field.key];
            else node.value = String(values[field.key]);
        }
    }
    function preset(value) {
        if (!scopes[value]) return;
        apply(scopes[value]);
        document.getElementById('PHPUseFileLimit').checked = false;
        document.getElementById('PHPScanPreset').value = value;
        if (Object.prototype.hasOwnProperty.call(scopes[value], 'PHPCpuLimit'))
            document.getElementById('PHPResourcePreset').value = scopes[value].PHPCpuLimit === 0 ? 'fast' : 'gentle';
    }
    function resource(value) {
        if (value !== 'gentle' && value !== 'fast') return;
        apply({PHPCpuLimit: value === 'gentle' ? 10 : 0, PHPYaraThreads: 2});
        document.getElementById('PHPResourcePreset').value = value;
    }
    function syncPreset() {
        document.getElementById('PHPScanPreset').value = 'custom';
        document.getElementById('PHPResourcePreset').value = 'custom';
    }
    return {parameters: parameters, prepare: prepare, preset: preset, resource: resource, syncPreset: syncPreset};
}());
document.body.ontakeaction = function () { return PhpScan.prepare(); };
</script>]]></Description>
    <Relevance><![CDATA[if version of client >= "9.5.7" then (mac of operating system and ((architecture of operating system = "arm64" and version of operating system >= "11.0") or (architecture of operating system = "x86_64" and version of operating system >= "10.12"))) else false]]></Relevance>
    <Category>PHP Security Discovery</Category>
    <SourceReleaseDate>2026-10-25</SourceReleaseDate>
    <MIMEField>
      <Name>x-fixlet-modification-time</Name>
      <Value>Sun, 25 Oct 2026 13:17:04 +0000</Value>
    </MIMEField>
    <DefaultAction ID="Action1">
      <Description>
        <PreLink>Click </PreLink>
        <Link>here</Link>
        <PostLink> to run bounded local PHP discovery.</PostLink>
      </Description>
      <ActionScript MIMEType="application/x-Fixlet-Windows-Shell"><![CDATA[begin prefetch block
if {architecture of operating system = "arm64"}
add prefetch item name=yara-x-v1.22.0-aarch64-apple-darwin.tar.gz sha1=16b30fd7d7613bd0172bc197d785f1143c34f2b9 sha256=79d596da5bf02205de63a1d7844a964daebc7293fa36fcb7da46c3e3c7567229 size=8421133 url=https://github.com/VirusTotal/yara-x/releases/download/v1.22.0/yara-x-v1.22.0-aarch64-apple-darwin.tar.gz
elseif {architecture of operating system = "x86_64"}
add prefetch item name=yara-x-v1.22.0-x86_64-apple-darwin.tar.gz sha1=560ace0fca8543195a71d52545bef248e92854e4 sha256=d059da4b91c7d7b43f6f50174a7739e3362b51f349f2ba8b33d46e3334bb3300 size=9476144 url=https://github.com/VirusTotal/yara-x/releases/download/v1.22.0/yara-x-v1.22.0-x86_64-apple-darwin.tar.gz
endif
end prefetch block
if {exists parameter "PHPUnixExcludeDirectoriesHex"}
if {not exists parameter "PHPExcludeDirectoriesHex"}
parameter "PHPExcludeDirectoriesHex" = "{parameter "PHPUnixExcludeDirectoriesHex"}"
else
continue if {parameter "PHPExcludeDirectoriesHex" = parameter "PHPUnixExcludeDirectoriesHex"}
endif
endif
action uses file encoding UTF-8 NoBOM
if {not exists parameter "PHPExcludeDirectoriesHex"}
parameter "PHPExcludeDirectoriesHex" = "x"
endif
continue if {length of parameter "PHPExcludeDirectoriesHex" <= 8193 and parameter "PHPExcludeDirectoriesHex" = regex "x([0-9A-Fa-f][0-9A-Fa-f])*"}
if {not exists parameter "PHPIncludeNonstandardNames"}
parameter "PHPIncludeNonstandardNames" = "1"
endif
continue if {parameter "PHPIncludeNonstandardNames" = regex "[0-9]+" and length of parameter "PHPIncludeNonstandardNames" <= 9}
continue if {(parameter "PHPIncludeNonstandardNames" as integer) >= 0 and (parameter "PHPIncludeNonstandardNames" as integer) <= 1}
if {not exists parameter "PHPIncludeBroaderLocations"}
parameter "PHPIncludeBroaderLocations" = "0"
endif
continue if {parameter "PHPIncludeBroaderLocations" = regex "[0-9]+" and length of parameter "PHPIncludeBroaderLocations" <= 9}
continue if {(parameter "PHPIncludeBroaderLocations" as integer) >= 0 and (parameter "PHPIncludeBroaderLocations" as integer) <= 1}
if {not exists parameter "PHPIncludeBuildText"}
parameter "PHPIncludeBuildText" = "0"
endif
continue if {parameter "PHPIncludeBuildText" = regex "[0-9]+" and length of parameter "PHPIncludeBuildText" <= 9}
continue if {(parameter "PHPIncludeBuildText" as integer) >= 0 and (parameter "PHPIncludeBuildText" as integer) <= 1}
if {not exists parameter "PHPEnumerationSeconds"}
parameter "PHPEnumerationSeconds" = "0"
endif
continue if {parameter "PHPEnumerationSeconds" = regex "[0-9]+" and length of parameter "PHPEnumerationSeconds" <= 9}
continue if {(parameter "PHPEnumerationSeconds" as integer) >= 0 and (parameter "PHPEnumerationSeconds" as integer) <= 3600}
if {not exists parameter "PHPScanSeconds"}
parameter "PHPScanSeconds" = "0"
endif
continue if {parameter "PHPScanSeconds" = regex "[0-9]+" and length of parameter "PHPScanSeconds" <= 9}
continue if {(parameter "PHPScanSeconds" as integer) >= 0 and (parameter "PHPScanSeconds" as integer) <= 3600}
if {not exists parameter "PHPMaxFiles"}
parameter "PHPMaxFiles" = "0"
endif
continue if {parameter "PHPMaxFiles" = regex "[0-9]+" and length of parameter "PHPMaxFiles" <= 9}
continue if {(parameter "PHPMaxFiles" as integer) >= 0 and (parameter "PHPMaxFiles" as integer) <= 50000000}
if {not exists parameter "PHPCandidateGB"}
parameter "PHPCandidateGB" = "0"
endif
continue if {parameter "PHPCandidateGB" = regex "[0-9]+" and length of parameter "PHPCandidateGB" <= 9}
continue if {(parameter "PHPCandidateGB" as integer) >= 0 and (parameter "PHPCandidateGB" as integer) <= 100}
if {not exists parameter "PHPMaxFileMB"}
parameter "PHPMaxFileMB" = "512"
endif
continue if {parameter "PHPMaxFileMB" = regex "[0-9]+" and length of parameter "PHPMaxFileMB" <= 9}
continue if {(parameter "PHPMaxFileMB" as integer) >= 16 and (parameter "PHPMaxFileMB" as integer) <= 512}
if {not exists parameter "PHPCpuLimit"}
parameter "PHPCpuLimit" = "0"
endif
continue if {parameter "PHPCpuLimit" = regex "[0-9]+" and length of parameter "PHPCpuLimit" <= 9}
continue if {(parameter "PHPCpuLimit" as integer) >= 0 and (parameter "PHPCpuLimit" as integer) <= 10}
if {not exists parameter "PHPYaraThreads"}
parameter "PHPYaraThreads" = "2"
endif
continue if {parameter "PHPYaraThreads" = regex "[0-9]+" and length of parameter "PHPYaraThreads" <= 9}
continue if {(parameter "PHPYaraThreads" as integer) >= 1 and (parameter "PHPYaraThreads" as integer) <= 4}
parameter "output" = "{pathname of parent folder of data folder of client}/YARA_PHP"
// Each attempt owns a separate workspace; interrupted children keep their scan lock.
parameter "work" = "{parameter "output"}/work-{id of action}-{((now - ("01 Jan 1970 00:00:00 +0000" as time)) / microsecond) as integer as string}-{random integer of 2147483647 as string}"
folder create "{parameter "output"}"
folder create "{parameter "work"}"
if {architecture of operating system = "arm64"}
parameter "macArchive" = "yara-x-v1.22.0-aarch64-apple-darwin.tar.gz"
parameter "macArchiveSha" = "79d596da5bf02205de63a1d7844a964daebc7293fa36fcb7da46c3e3c7567229"
parameter "macEngineSha" = "81f91471e7e786d932e80e8a74e25e0607e0c5305c370ba6238a31133fd2a05f"
elseif {architecture of operating system = "x86_64"}
parameter "macArchive" = "yara-x-v1.22.0-x86_64-apple-darwin.tar.gz"
parameter "macArchiveSha" = "d059da4b91c7d7b43f6f50174a7739e3362b51f349f2ba8b33d46e3334bb3300"
parameter "macEngineSha" = "aec0e72e7ff4a6efe2fb90419c58f4a539bde31b6804ac24a75f625cf837510c"
endif
delete __createfile
createfile until END_PHP_HYBRID_d5fc6eed5b935a20
/*
  PHP install detection + version, all OSes (Linux ELF, Windows PE, macOS Mach-O).

  Deliberately broad: PHP_Binary_Broad flags anything that looks PHP-related so
  nothing is missed; the other rules carry the exact version string. Run with
  `yara -s` (or `yr scan -s`) to print the matched version text.

  Rules:
    PHP_Runtime_Version     - PHP core runtime; $ver holds the exact version,
                              incl. distro suffix (e.g. 8.1.2-1ubuntu2.27)
    PHP_Windows_VersionInfo - any PE whose version resource says ProductName=PHP
                              (php.exe, php-cgi.exe, php8ts.dll, ext\php_*.dll);
                              $pv holds ProductVersion
    PHP_Binary_Broad        - catch-all: any executable with any PHP marker
    PHP_Build_Artifact      - php-config / php_version.h left by source installs

  No modules are imported so the rules also work in embedded YARA engines
  (osquery, EDRs) that are built without the pe/elf/macho modules.

  See README.md for tested samples and the API number -> branch table.
*/

private rule PHP_Detect_IsExecutable
{{
  condition:
    // Keep existing ELF object/core exclusions inside YARA-X.
    (uint32(0) == 0x464C457F and
      not (uint16(16) == 1 or uint16(16) == 4 or
           uint16be(16) == 1 or uint16be(16) == 4))
    or uint16(0) == 0x5A4D
    // Mach-O executable, dylib and bundle; relocatable objects are not runtimes.
    or ((uint32(0) == 0xFEEDFACE or uint32(0) == 0xFEEDFACF) and
        (uint32(12) == 2 or uint32(12) == 6 or uint32(12) == 8))
    or ((uint32be(0) == 0xFEEDFACE or uint32be(0) == 0xFEEDFACF) and
        (uint32be(12) == 2 or uint32be(12) == 6 or uint32be(12) == 8))
    or uint32(0) == 0xBEBAFECA
}

// Coverage evidence only; do not silently certify unqualified fat variants.
rule PHP_Unsupported_Format
{{
  condition:
    uint32be(0) == 0xCAFEBABF or uint32be(0) == 0xBEBAFECA
    or uint32be(0) == 0xBFBAFECA
}


rule PHP_Runtime_Version
{{
  meta:
    description = "PHP core runtime (CLI/CGI/FPM/mod_php/libphp/php*ts.dll/php8.dll/embedded); $ver = exact version"
    confidence = "high"
  strings:
    // Compile-time literal "X-Powered-By: PHP/" PHP_VERSION in main/SAPI.c.
    // Present regardless of expose_php. Suffix covers distro builds (8.1.2-1ubuntu2.27)
    // and pre-releases (8.5.0RC1).
    $ver = /X-Powered-By: PHP\/[0-9]{{1,2}\.[0-9]{{1,2}\.[0-9]{{1,3}[0-9A-Za-z.+~_-]{{0,40}/
  condition:
    PHP_Detect_IsExecutable and $ver
}

rule PHP_Windows_VersionInfo
{{
  meta:
    description = "Windows PE with PHP version resource; $pv = ProductVersion (exact version)"
    confidence = "high"
  strings:
    // UTF-16LE "ProductName" <NUL + 0-2 bytes alignment pad> "PHP\0"
    $pname = {{ 50 00 72 00 6F 00 64 00 75 00 63 00 74 00 4E 00 61 00 6D 00 65 00 [2-4] 50 00 48 00 50 00 00 00 }
    $pv = /ProductVersion\x00[0-9]{{1,2}\.[0-9]{{1,2}\.[0-9]{{1,3}[0-9A-Za-z.\-]{{0,20}/ wide
  condition:
    // #pv >= 0 is always true: $pv is only there so -s prints the version
    uint16(0) == 0x5A4D and $pname and #pv >= 0
}

rule PHP_Binary_Broad
{{
  meta:
    description = "Broad catch-all: executable containing any PHP runtime/extension marker"
    confidence = "medium"
  strings:
    $xpb    = "X-Powered-By: PHP/"
    $zend   = "Zend Engine v"
    // ZEND_MODULE_BUILD_ID, e.g. API20220829,NTS / API20250925,TS - also in extensions
    $api    = /API20[0-9]{{6},N?TS/
    $pname  = {{ 50 00 72 00 6F 00 64 00 75 00 63 00 74 00 4E 00 61 00 6D 00 65 00 [2-4] 50 00 48 00 50 00 00 00 }
    $grp    = "The PHP Group" ascii wide
    $ini    = "php.ini"
    $fmt    = "PHP %s (%s)"
  condition:
    PHP_Detect_IsExecutable and
    (
      $xpb or $zend or $api or $pname
      or ($grp and ($ini or $fmt))
    )
}

rule PHP_Build_Artifact
{{
  meta:
    description = "php-config script or php_version.h header from a PHP build/install; $v* = version"
    confidence = "medium"
  strings:
    // php-config (installed next to the php binary by `make install` and -dev packages)
    $cfg_ver   = /version="[0-9]{{1,2}\.[0-9]{{1,2}\.[0-9]{{1,3}[0-9A-Za-z.+~_-]{{0,40}"/
    $cfg_a     = "php_cli_binary="
    $cfg_b     = "--php-binary"
    // main/php_version.h
    $hdr_ver   = /#define PHP_VERSION "[0-9]{{1,2}\.[0-9]{{1,2}\.[0-9]{{1,3}[0-9A-Za-z.+~_-]{{0,40}"/
    $hdr_a     = "#define PHP_MAJOR_VERSION"
  condition:
    filesize < 64KB and
    (
      ($cfg_ver and $cfg_a and $cfg_b)
      or ($hdr_ver and $hdr_a)
    )
}
END_PHP_HYBRID_d5fc6eed5b935a20
delete "{parameter "work"}/php-detect.yar"
move __createfile "{parameter "work"}/php-detect.yar"
continue if {sha256 of file "php-detect.yar" of folder (parameter "work") = "d5fc6eed5b935a2048726831d6735140a6f312345b0d92df870344500fffdc7f"}
delete __createfile
createfile until END_PHP_HYBRID_8813f47e0501c318
#!/bin/bash
# macOS PHP discovery with stock Bash 3.2, BSD utilities and stock zsh modules.
# No Python, jq, GNU tools, compiler or PHP execution required.
# YARA text parsing follows the Apache-2.0 Rapid Response scanner approach.
# Bash 3.2 treats empty arrays as unset under nounset; all inputs below
# are explicitly initialised/validated instead of relying on that option.
set -eo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
export LC_ALL=C
umask 077
mac_regex_0='^x([0-9a-fA-F]{{2})*$'
mac_regex_1='^[0-9]{{1,9}$'
mac_regex_2='/\.\.?/'
mac_regex_3='^(php|phpdbg|libphp|mod_php|lsphp|frankenphp)([0-9][0-9.]*([-_][a-z0-9_.-]+)?|[-_][a-z0-9_.-]+)?(ts|nts|apache[0-9_]*)?(\.exe|\.dll|\.dylib|\.so(\.[0-9]+)*)?$'
mac_regex_4='^[0-9][a-z0-9_-]*$'
mac_regex_5='^[0-9]+$'
mac_regex_6='^([0-9]{{1,2})\.([0-9]{{1,2})\.([0-9]{{1,3})(.*)$'
mac_regex_7='^(alpha|beta|RC|dev)[0-9]*$'
mac_regex_8='^(alpha|beta|RC|dev)'
engine= rules= output= archive= engine_sha256= archive_sha256=
enumeration_seconds=0 scan_seconds=0 max_files=0 candidate_gb=0
max_file_mb=512 cpu_limit=10 yara_threads=2 include_build_text=0 include_broader_locations=0 include_nonstandard_names=0
roots=()

valid_utf8() {{
    local text=$1 i byte remaining=0 low=128 high=191
    for ((i=0;i<${{#text};i++)); do
        printf -v byte '%d' "'${{text:i:1}"
        byte=$((byte & 255))
        if ((remaining)); then
            ((byte>=low && byte<=high)) || return 1
            remaining=$((remaining-1)); low=128; high=191
        elif ((byte<128)); then :
        elif ((byte>=194 && byte<=223)); then remaining=1
        elif ((byte>=224 && byte<=239)); then
            remaining=2; ((byte!=224)) || low=160; ((byte!=237)) || high=159
        elif ((byte>=240 && byte<=244)); then
            remaining=3; ((byte!=240)) || low=144; ((byte!=244)) || high=143
        else return 1; fi
    done
    ((remaining==0))
}
# Shared v3 workspace/path helpers, embedded in both Unix scanners.
cleanup_abandoned_work() {{
    local candidate marker metadata owner mode
    for candidate in "$output"/work-*; do
        [[ -d $candidate && ! -L $candidate && $candidate != "$work" ]] || continue
        [[ ${{candidate##*/} =~ ^work-[0-9]+-[0-9]+-[0-9]+$ ]] || continue
        metadata=$(stat -f '%u %Lp' "$candidate" 2>/dev/null) || continue
        read -r owner mode <<<"$metadata"
        [[ $owner = "$EUID" && $mode =~ ^[0-7]+$ ]] || continue
        (( (8#$mode & 0022)==0 )) || continue
        [[ -f $candidate/attempt.started && ! -L $candidate/attempt.started ]] || continue
        metadata=$(stat -f '%u %Lp' "$candidate/attempt.started" 2>/dev/null) || continue
        read -r owner mode <<<"$metadata"
        [[ $owner = "$EUID" && $mode =~ ^[0-7]+$ ]] || continue
        (( (8#$mode & 0022)==0 )) || continue
        marker=
        IFS= read -r marker <"$candidate/attempt.started" || continue
        [[ $marker = PHP_YARA_WORKSPACE_V3 ]] || continue
        # Only a prior launched-v3 workspace is eligible under the global lock.
        # Unmarked folders may still be in ActionScript preparation: leave them.
        rm -rf -- "$candidate"
    done
    [[ ! -L $work/attempt.started ]] || return 1
    printf 'PHP_YARA_WORKSPACE_V3\n' >"$work/attempt.started"
}

scan_list_path_safe() {{
    [[ $1 != *[[:cntrl:]]* ]] || return 1
    [[ $1 != *[!\ -\~]* ]] || valid_utf8 "$1"
}

stage_candidate() {{
    local available blocks copied
    available=$(df -Pk "$work" 2>/dev/null | awk 'NR>1 {{v=$4} END {{if(v ~ /^[0-9]+$/) print v}') || available=
    blocks=$(((size+1023)/1024))
    if [[ ! $available =~ ^[0-9]+$ ]] || ((available<blocks+65536)); then
        reasons+=('insufficient free space for unusual-path staging')
        return 1
    fi
    # Non-POSIX Bash ulimit -f uses 1024-byte blocks. Bound growing files too.
    if ! (ulimit -f "$blocks"; timeout -k 2 "$((enumeration_seconds==0 ? 0 : (deadline-SECONDS>0 ? deadline-SECONDS : 1)))" cp -p "$path" "$scan_path"); then
        rm -f -- "$scan_path"
        read_errors=$((read_errors+1))
        return 1
    fi
    copied=$(stat -f %z "$scan_path" 2>/dev/null) || copied=
    if [[ $copied != "$size" ]]; then
        rm -f -- "$scan_path"
        read_errors=$((read_errors+1))
        return 1
    fi
}

exclude_directories_hex=x
# macOS adapters, sourced into the generated Bash 3.2-compatible scanner.
# No GNU utilities, Python, PHP, compiler or Homebrew installation is needed.
timeout() {{
    local grace=1 limit
    if [[ $1 = -k ]]; then grace=$2; shift 2; fi
    limit=$1; shift
    /bin/zsh -f "$work/mac-run-bounded.zsh" "$limit" "$grace" "$@"
}

mac_roots() {{
    local line mount filesystem source disposition options data_root=0 images
    [[ ! -d /System/Volumes/Data ]] || data_root=1
    images=$work/disk-images.txt
    if ! timeout -k 1 5 hdiutil info >"$images" 2>"$work/mount.stderr"; then
        reasons+=('disk image inventory unavailable')
        : >"$images"
    fi
    while IFS= read -r line; do
        [[ $line = *' on '* && $line = *' ('*')' ]] || continue
        source=${{line%% on *}
        mount=${{line#* on }; mount=${{mount% \(*}
        options=${{line##* \(}; options=${{options%)}
        filesystem=${{options%%,*}
        [[ $mount = /* && $mount != *[[:cntrl:]]* ]] || {{
            reasons+=('unsupported mount path'); continue
        }
        disposition=EXCLUDED
        if [[ $source = /dev/disk* ]]; then
            case "$filesystem" in apfs|hfs|msdos|exfat|ntfs) disposition=SCAN;; *) disposition=UNSUPPORTED;; esac
        fi
        case "$mount" in
            /dev|/net|/home|/System/Volumes/Preboot*|/System/Volumes/VM*|/System/Volumes/Update*|/System/Volumes/Recovery*|/System/Volumes/iSCPreboot*|/System/Volumes/xarts*|/System/Volumes/Hardware*|*/.timemachine/*) disposition=EXCLUDED;;
        esac
        # The APFS Data volume contains user applications. Scanning only / with
        # -xdev can miss it; scanning both logical aliases and Data duplicates it.
        if [[ $mount = / && $data_root = 1 && $include_broader_locations = 0 ]]; then disposition=EXCLUDED; fi
        if awk -v device="$source" '$1==device {{found=1} END{{exit !found}' "$images"; then disposition=EXCLUDED; fi
        printf 'Mount: %s | %s | %s\n' "$mount" "$filesystem" "$disposition" >>"$output/scan.log"
        case "$disposition" in
            SCAN) roots+=("$mount");;
            UNSUPPORTED) reasons+=('unsupported local filesystem');;
        esac
    done < <(mount)
    # Older macOS releases shipped an Apple PHP runtime on the sealed/system
    # side. It must not disappear just because application Data is separate.
    [[ ! -f /usr/bin/php ]] || roots+=(/usr/bin/php)
}

package_status() {{
    local file=$1 logical answer rc=0 budget index
    for ((index=0;index<${{#package_paths[@]};index++)); do
        if [[ ${{package_paths[index]} = "$file" ]]; then package_state=${{package_states[index]}; return; fi
    done
    logical=${{file#/System/Volumes/Data}
    package_state=unverified
    case "$logical" in
        /System/*|/usr/bin/*) package_state=vendor;;
        /opt/homebrew/Cellar/php/*|/opt/homebrew/Cellar/php@[0-9]*/*|/usr/local/Cellar/php/*|/usr/local/Cellar/php@[0-9]*/*|/opt/local/bin/php*|/opt/local/sbin/php*|/opt/local/lib/php*|/opt/local/apache*/modules/*php*)
            # Standard package-manager PHP is assessed against upstream versions.
            # This does not establish the patch status of a custom build.
            package_state=upstream;;
        *)
            budget=$((package_deadline-SECONDS)); ((budget<=2)) || budget=2
            if ((budget>=1)); then
                answer=$(timeout -k 1 "$budget" pkgutil --file-info "$logical" 2>&1 | head -c 8192) || rc=$?
                if ((rc==0)); then
                    # A successful query can describe a path without any owning
                    # receipt. Require pkgid evidence before calling it managed;
                    # unknown output remains unverified rather than guessing.
                    case "$answer" in
                        pkgid:\ *|*$'\npkgid: '*) package_state=vendor;;
                        volume:\ *$'\npath: '*) package_state=unowned;;
                    esac
                elif ((rc==1)) && [[ $answer = *'No receipt for'* ]]; then package_state=unowned; fi
            fi;;
    esac
    package_paths+=("$file"); package_states+=("$package_state")
}

while (($#)); do
    (($# >= 2)) || {{ echo 'Missing argument' >&2; exit 2; }
    case "$1" in
        --engine) engine=$2;; --engine-sha256) engine_sha256=$2;; --rules) rules=$2;; --output) output=$2;;
        --archive) archive=$2;; --archive-sha256) archive_sha256=$2;; --root) roots+=("$2");;
        --enumeration-seconds) enumeration_seconds=$2;; --scan-seconds) scan_seconds=$2;;
        --max-files) max_files=$2;; --candidate-gb) candidate_gb=$2;; --max-file-mb) max_file_mb=$2;;
        --cpu-limit) cpu_limit=$2;; --threads) yara_threads=$2;; --include-build-text) include_build_text=$2;;
        --include-broader-locations) include_broader_locations=$2;; --include-nonstandard-names) include_nonstandard_names=$2;;
        --exclude-directories-hex) exclude_directories_hex=$2;;
        *) echo 'Unknown argument' >&2; exit 2;;
    esac
    shift 2
done
for name in enumeration_seconds scan_seconds max_files candidate_gb max_file_mb cpu_limit yara_threads include_build_text include_broader_locations include_nonstandard_names; do
    [[ ${{!name} =~ $mac_regex_1 ]] || {{ echo "Invalid $name" >&2; exit 2; }
done
((enumeration_seconds>=0 && enumeration_seconds<=3600 && scan_seconds>=0 && scan_seconds<=3600 && max_files>=0 && max_files<=50000000 && candidate_gb>=0 && candidate_gb<=100 && max_file_mb>=1 && max_file_mb<=512 && cpu_limit>=0 && cpu_limit<=10 && yara_threads>=1 && yara_threads<=4 && include_build_text<=1 && include_broader_locations<=1 && include_nonstandard_names<=1)) || {{ echo 'Scan setting outside its allowed range' >&2; exit 2; }
[[ $output = /* && $engine = /* && $rules = /* ]] || {{ echo 'Engine, rule and output paths must be absolute' >&2; exit 2; }
missing=()
for command in df find stat od awk sort shasum tar gzip date mkdir mv chmod dirname mkfifo cp nice cat head tr rm zsh pkgutil hdiutil mount; do
    command -v "$command" >/dev/null 2>&1 || missing+=("$command")
done
((${{#missing[@]}==0)) || {{ printf 'Missing required utilities: %s\n' "${{missing[*]}" >&2; exit 2; }
# Reject symlink output ancestors and insecure output ownership. Never change
# permissions on an unrelated directory and never follow an output redirect.
current=$output
while [[ $current != / ]]; do [[ ! -L $current ]] || {{ echo 'Symlink output ancestor rejected' >&2; exit 2; }; current=${{current%/*}; [[ -n $current ]] || current=/; done
mkdir -p -- "$output"
[[ $(stat -f %u "$output") = "$EUID" ]] || {{ echo 'Output directory ownership mismatch' >&2; exit 2; }
mode=$(stat -f %Lp "$output"); (( (8#$mode & 0022)==0 )) || {{ echo 'Output directory is writable by another account' >&2; exit 2; }
for leaf in scan.lock scan.log scan.log.new summary.txt summary.txt.new; do [[ ! -L $output/$leaf ]] || {{ echo "Symlink output file rejected: $leaf" >&2; exit 2; }; done
# The pinned mac-lock.zsh launcher execs this process while retaining its
# kernel advisory lock. Never reopen/close the locked inode in this process.
[[ ${{PHP_SCAN_LOCK_HELD_PID-} = "$$" ]] || {{ echo 'Use the locked macOS launcher' >&2; exit 2; }
work=$(dirname -- "$engine")
[[ -d $work && ! -L $work && $(stat -f %u "$work") = "$EUID" ]] || {{ echo 'Unsafe or missing scan workspace' >&2; exit 2; }
mode=$(stat -f %Lp "$work"); (( (8#$mode & 0022)==0 )) || {{ echo 'Scan workspace is writable by another account' >&2; exit 2; }
if [[ -n ${{PHP_BACKGROUND_RUN_ID:-} ]]; then printf "%s\n" "$PHP_BACKGROUND_RUN_ID" >"$work/attempt.admitted"; fi
started=$(date -u '+%Y-%m-%d %H:%M:%S UTC'); start_seconds=$SECONDS
# Persistent header worker: one process per scan instead of several per file.
# The request/response FIFOs are private attempt-owned objects. Opening both
# ends in the parent avoids startup/EOF races; read -t applies to the FIFO.
header_pid=
stop_header_worker() {{
    if [[ -n $header_pid ]]; then
        kill -KILL "$header_pid" 2>/dev/null || :
        wait "$header_pid" 2>/dev/null || :
        header_pid=
    fi
    exec 6>&- 7>&-
}
start_header_worker() {{
    local leaf
    for leaf in header-request.pipe header-response.pipe; do
        [[ ! -L $work/$leaf ]] || return 1
        if [[ -e $work/$leaf ]]; then [[ -p $work/$leaf ]] || return 1; rm -f -- "$work/$leaf"; fi
        mkfifo -- "$work/$leaf" || return 1
    done
    exec 7<>"$work/header-request.pipe" 6<>"$work/header-response.pipe"
    /bin/bash "$work/mac-read-header.sh" "$work/header-request.pipe" "$work/header-response.pipe" &
    header_pid=$!
}
read_header() {{
    header_access_denied=0
    local reply expected_size=$2 hexadecimal_pattern='^[0-9a-f]+$'
    local expected_length=$(( (expected_size<20 ? expected_size : 20)*2 ))
    header=
    if [[ -z $header_pid ]]; then start_header_worker || return 1; fi
    if printf '%s\0' "$1" >&7 && IFS= read -r -d '' -t 2 reply <&6; then
        if [[ $reply = DENIED:* ]]; then header_access_denied=1; return 1; fi
        if [[ $reply = OK:* ]]; then
            header=${{reply#OK:}
            if [[ $header =~ $hexadecimal_pattern ]] && ((${{#header}==expected_length)); then return 0; fi
        fi
    fi
    # Only this read-only attempt-owned worker is terminated, never an app.
    stop_header_worker
    return 1
}

finished=0 find_pid= scan_pid=
failure() {{
    result=$?
    trap - EXIT
    stop_header_worker
    if [[ -n $find_pid ]]; then kill "$find_pid" 2>/dev/null || :; wait "$find_pid" 2>/dev/null || :; fi
    if [[ -n $scan_pid ]]; then kill "$scan_pid" 2>/dev/null || :; wait "$scan_pid" 2>/dev/null || :; fi
    if (( !finished )); then
        printf '\nScan failed (exit %s); previous finished results retained.\n' "$result" >>"$output/scan.log"
        if [[ -f $output/summary.txt ]]; then
            awk '/^LAST_SCAN=/{{sub(/ \(Last attempt failed.*/, ""); print $0 " (Last attempt failed; see scan.log)"; next} {{print}' "$output/summary.txt" >"$output/summary.txt.new"
        else printf 'RESULT_FORMAT=2\nDETECTED=UNKNOWN\nLAST_SCAN=NO SCAN (Last attempt failed; see scan.log)\nDURATION=NO SCAN\n' >"$output/summary.txt.new"; fi
        mv -f -- "$output/summary.txt.new" "$output/summary.txt"
    fi
    exit "$result"
}
trap failure EXIT
trap 'exit 130' INT TERM
printf 'PHP scan started: %s\nStandard names: %s; build text: %s; broader locations: %s\n' "$started" "$((1-include_nonstandard_names))" "$include_build_text" "$include_broader_locations" >"$output/scan.log"
exec 2>>"$output/scan.log"
cleanup_abandoned_work
# Decode only validated byte pairs. Paths are never shell code, printf formats or
# evaluated expressions. BSD find gets quoted regex arguments with literal syntax
# escaped; only '*' is a wildcard. Directory pruning happens before any file read.
[[ ${{#exclude_directories_hex} -le 8193 && $exclude_directories_hex =~ $mac_regex_0 ]] || {{ echo 'Invalid encoded exclusions' >&2; exit 2; }
exclusion_text=
for ((i=1;i<${{#exclude_directories_hex};i+=2)); do
    pair=${{exclude_directories_hex:i:2}
    [[ $pair != 00 ]] || {{ echo 'NUL in exclusions' >&2; exit 2; }
    printf -v character '%b' "\\x$pair"; exclusion_text+=$character
done
[[ $exclusion_text != *[[:cntrl:]]* ]] || {{ echo 'Control character in exclusions' >&2; exit 2; }
custom_trees=(); custom_direct=(); custom_patterns=()
IFS=',' read -r -a exclusion_entries <<<"$exclusion_text"
for pattern in "${{exclusion_entries[@]}"; do
    pattern="${{pattern#"${{pattern%%[![:space:]]*}"}"; pattern="${{pattern%"${{pattern##*[![:space:]]}"}"
    [[ -n $pattern ]] || continue
    ((${{#custom_patterns[@]}<32)) || {{ echo 'At most 32 exclusions allowed' >&2; exit 2; }
    [[ $pattern = /* || $pattern = \*/* ]] || {{ echo 'Unix exclusions need an absolute path or leading */' >&2; exit 2; }
    [[ ! /$pattern/ =~ $mac_regex_2 ]] || {{ echo 'Relative path segments are not allowed' >&2; exit 2; }
    while [[ $pattern = *//* ]]; do pattern=${{pattern//\/\//\/}; done
    while [[ $pattern = *\*\** ]]; do pattern=${{pattern//\*\*/\*}; done
    custom_patterns+=("$pattern")
    recursive=0; basis=$pattern
    if [[ $basis = */\* ]]; then recursive=1; basis=${{basis%/\*}; fi
    while [[ $basis = */ ]]; do basis=${{basis%/}; done
    expression=
    for ((i=0;i<${{#basis};i++)); do
        character=${{basis:i:1}
        case "$character" in
            '*') expression+='.*';;
            '.'|'['|']'|'('|')'|'{{'|'}'|'+'|'?'|'^'|'$'|'|'|'\') expression+="\\$character";;
            *) expression+=$character;;
        esac
    done
    if ((recursive)); then custom_trees+=("$expression(/.*)?"); else custom_direct+=("$expression/[^/]+"); fi
    printf 'Custom directory exclusion: %s\n' "$pattern" >>"$output/scan.log"
done
hash() {{ shasum -a 256 "$1" | awk '{{print $1}'; }
[[ $(hash "$rules") = d5fc6eed5b935a2048726831d6735140a6f312345b0d92df870344500fffdc7f ]] || {{ echo 'Rule hash mismatch' >&2; exit 2; }
if [[ ! -f $engine ]]; then
    [[ -f $archive && $(hash "$archive") = "$archive_sha256" ]] || {{ echo 'Archive hash mismatch' >&2; exit 2; }
    # Extract only the pinned executable to a controlled filename; no archive paths.
    tar -xOzf "$archive" yr >"$engine"
    chmod 700 "$engine"
fi
[[ $(hash "$engine") = "$engine_sha256" ]] || {{ echo 'Engine hash mismatch' >&2; exit 2; }
prune=(/dev /net /home /Volumes/TimeMachine /private/var/vm "$output")
# Keep all scanner-owned data out of discovery, including private nested runs.
scanner_ancestor=$output
while [[ -n $scanner_ancestor && $scanner_ancestor != / ]]; do
    if [[ ${{scanner_ancestor##*/} = YARA_PHP ]]; then
        prune+=("$scanner_ancestor" "${{scanner_ancestor%/*}/__BESData")
        break
    fi
    scanner_ancestor=${{scanner_ancestor%/*}
done
if (( !include_broader_locations )); then
    prune+=(/System /bin /sbin /usr/bin /usr/sbin /usr/lib /usr/share /Library/Apple /private/var/log /private/var/cache /private/var/folders)
fi
# Include physical APFS Data paths for exclusions expressed using logical paths.
for directory in "${{prune[@]}"; do
    [[ $directory = /System/Volumes/Data/* ]] || prune+=("/System/Volumes/Data$directory")
done
reasons=()
if ((${{#roots[@]}==0)); then mac_roots; fi
((${{#roots[@]})) || {{ echo 'No supported local filesystem found' >&2; exit 2; }
name_expression=( '(' -iname 'php*' -o -iname 'libphp*' -o -iname 'mod_php*' -o -iname 'lsphp*' -o -iname 'frankenphp*' ')' )
((include_nonstandard_names)) && name_expression=()
prune_expression=( '(' -type d '(' -false )
for directory in "${{prune[@]}"; do prune_expression+=( -o -path "$directory" ); done
prune_expression+=( -o -path '*/Library/CloudStorage' -o -path '*/Library/Mobile Documents' -o -path '*/Library/Containers/com.docker.docker' -o -path '*/.Trash' -o -path '*/.Trashes' -o -path '*/.Spotlight-V100' -o -path '*/.fseventsd' )
for expression in "${{custom_trees[@]}"; do prune_expression+=( -o -regex "$expression" -o -regex "/System/Volumes/Data$expression" ); done
if ((!include_broader_locations)); then prune_expression+=( -o -path '*/Library/Caches' -o -path '*/Library/Logs' -o -path '*/.cache' -o -path '*/.npm/_cacache' -o -path '*/.nuget/packages' ); fi
# Package-specific OS data exclusions apply to every scope. Keep application
# directories, developer projects and personal documents in scope.
mac_data_trees=(
    '/Library/Application Support/com.apple.TCC'
    '/System/Volumes/Data/Library/Application Support/com.apple.TCC'
    '/Library/Trial'
    '/System/Volumes/Data/Library/Trial'
    '/Library/Bluetooth'
    '/System/Volumes/Data/Library/Bluetooth'
    '/private/var/networkd/db'
    '/System/Volumes/Data/private/var/networkd/db'
    '/private/var/OOPJit'
    '/System/Volumes/Data/private/var/OOPJit'
    '/private/var/protected/trustd/private'
    '/System/Volumes/Data/private/var/protected/trustd/private'
    '/private/var/protected/sfanalytics'
    '/System/Volumes/Data/private/var/protected/sfanalytics'
    '/private/var/db/appinstalld'
    '/System/Volumes/Data/private/var/db/appinstalld'
    '/private/var/db/ExtensibleSSO/Configuration'
    '/System/Volumes/Data/private/var/db/ExtensibleSSO/Configuration'
    '/private/var/db/os_eligibility'
    '/System/Volumes/Data/private/var/db/os_eligibility'
    '/private/var/db/Spotlight'
    '/System/Volumes/Data/private/var/db/Spotlight'
    '/private/var/db/sysdiagnose/com.apple.sysdiagnose'
    '/System/Volumes/Data/private/var/db/sysdiagnose/com.apple.sysdiagnose'
    '/private/var/db/DumpPanic'
    '/System/Volumes/Data/private/var/db/DumpPanic'
    '/private/var/db/AppleIntelligencePlatform'
    '/System/Volumes/Data/private/var/db/AppleIntelligencePlatform'
    '/private/var/db/rmd/secure'
    '/System/Volumes/Data/private/var/db/rmd/secure'
    '/private/var/db/com.apple.backgroundtaskmanagement'
    '/System/Volumes/Data/private/var/db/com.apple.backgroundtaskmanagement'
    '/private/var/db/fpsd/dvp'
    '/System/Volumes/Data/private/var/db/fpsd/dvp'
    '/private/var/db/installcoordinationd'
    '/System/Volumes/Data/private/var/db/installcoordinationd'
    '/private/var/db/Spotlight-V100'
    '/System/Volumes/Data/private/var/db/Spotlight-V100'
    '/private/var/db/oah'
    '/System/Volumes/Data/private/var/db/oah'
    '/private/var/db/Sandbox'
    '/System/Volumes/Data/private/var/db/Sandbox'
    '/private/var/db/lockdown'
    '/System/Volumes/Data/private/var/db/lockdown'
    '/private/var/db/biome'
    '/System/Volumes/Data/private/var/db/biome'
    '/private/var/db/KernelExtensionManagement/Staging'
    '/System/Volumes/Data/private/var/db/KernelExtensionManagement/Staging'
    '/private/var/db/DifferentialPrivacy'
    '/System/Volumes/Data/private/var/db/DifferentialPrivacy'
    '/private/var/db/com.apple.security.cryptexd'
    '/System/Volumes/Data/private/var/db/com.apple.security.cryptexd'
    '/private/var/db/MobileIdentityService'
    '/System/Volumes/Data/private/var/db/MobileIdentityService'
    '/private/var/db/SystemKeys'
    '/System/Volumes/Data/private/var/db/SystemKeys'
    '/private/var/db/searchparty'
    '/System/Volumes/Data/private/var/db/searchparty'
    '/private/var/db/CoreDuet'
    '/System/Volumes/Data/private/var/db/CoreDuet'
    '/private/var/db/ConfigurationProfiles/Store'
    '/System/Volumes/Data/private/var/db/ConfigurationProfiles/Store'
    '*/Library/Mail'
    '*/Library/Messages'
    '*/Library/Calendars'
    '*/Library/Autosave Information'
    '*/Library/Application Support/AddressBook'
    '*/Library/Application Support/CallHistoryDB'
    '*/Library/Application Support/CallHistoryTransactions'
    '*/Library/Containers/com.apple.mail'
    '*/Library/Containers/com.apple.Notes'
    '*/Library/Containers/com.apple.Photos'
    '*/Library/Containers/com.apple.MobileSMS'
    '*/Library/Group Containers/group.com.apple.notes'
    '*/Pictures/*.photoslibrary'
    '*/Music/Music'
)
mac_data_files=(
    '/private/var/db/SystemKey'
    '/System/Volumes/Data/private/var/db/SystemKey'
    '/Library/Preferences/SystemConfiguration/com.apple.airport.preferences.plist.backup'
    '/System/Volumes/Data/Library/Preferences/SystemConfiguration/com.apple.airport.preferences.plist.backup'
)
for pattern in "${{mac_data_trees[@]}"; do
    prune_expression+=( -o -path "$pattern" -o -path "$pattern/*" )
done
prune_expression+=( ')' ')' -prune -o )
# File-type scope applies to ALL scan types, including Deep. One case-insensitive
# regex avoids hundreds of find predicates or a child process per file.
non_runtime_extension_regex='.*[.](3g2|3gp|3mf|7z|a|aac|ai|aif|aifc|aiff|alac|amr|apinotes|apk|arw|ass|avi|avif|bdf|bib|blend|bmp|bnnsir|bom|bz2|c|c4d|cab|caf|car|cat|cc|cfg|chm|cjs|class|conf|cpp|cr2|cr3|css|csv|db|db-shm|db-wal|deb|dgn|dib|dmg|dng|doc|docm|docx|dot|dotm|dotx|dwg|dxf|edb|eml|eot|eps|epub|etl|evtx|fbx|flac|flv|fnt|fon|frag|fxf|geojson|gif|glb|glsl|gltf|go|gpx|gz|h|heic|heif|hlsl|hpp|htm|html|icns|ico|ics|idx|iges|igs|indd|inf|ini|iso|jar|java|journal|jpe|jpeg|jpg|js|json|jsonl|jsx|key|kml|kmz|less|lib|log|m|m2ts|m2v|m4a|m4b|m4v|ma|manifest|map|markdown|max|mb|mbox|md|mdb|metallib|mid|midi|mjs|mkv|mo|mobi|modulemap|mov|mp3|mp4|mpeg|mpg|msg|msi|msp|mts|ndjson|nef|nib|numbers|nupkg|odp|ods|odt|oga|ogg|ogv|opus|orf|ost|otf|otp|ots|ott|pack|pages|pcf|pcm|pdb|pdf|php|pkg|plist|png|po|pot|potm|potx|pps|ppsm|ppsx|ppt|pptm|pptx|prefab|properties|psb|psd|pst|py|pyc|qcow2|rar|rb|reg|rpm|rs|rst|rtf|rw2|sass|scss|shader|shadergraph|shp|shx|sketch|sqlite|sqlite-shm|sqlite-wal|srt|ssa|step|stl|stp|strings|svg|svgz|swift|swiftdoc|swiftinterface|swiftmodule|swiftsourceinfo|tar|tbd|tex|tgz|tif|tiff|toml|tracev3|ts|tsv|tsx|ttc|ttf|txt|uasset|ucas|umap|unity|unitypackage|usf|ush|utoc|vcf|vdi|vert|vmdk|vob|vpk|vtt|wal|wav|webm|webp|whl|wma|wmv|woff|woff2|xcf|xhtml|xip|xls|xlsb|xlsm|xlsx|xlt|xltm|xltx|xml|xz|yaml|yml|zip|zst)'
file_scope_expression=( '(' -iname 'php-config' -o -iname 'php_version.h' -o '!' -iregex "$non_runtime_extension_regex" ')' )

if ((!include_broader_locations)); then
    file_scope_expression+=( '!' -iregex '.*[.](db|sqlite|sqlite3|bak|dump|dmp|iso|vhd|vhdx|vmdk|wim|esd)' )
fi
direct_expression=()
# Also protect explicit file roots and descendants supplied as scan roots.
for pattern in "${{mac_data_trees[@]}"; do
    direct_expression+=( '!' -path "$pattern" '!' -path "$pattern/*" )
done
for pattern in "${{mac_data_files[@]}"; do direct_expression+=( '!' -path "$pattern" ); done
for expression in "${{custom_direct[@]}"; do direct_expression+=( '!' -regex "$expression" '!' -regex "/System/Volumes/Data$expression" ); done
# Directory pruning alone cannot exclude a file supplied as a starting root,
# including the legacy /usr/bin/php check. Apply tree exclusions to files too.
for expression in "${{custom_trees[@]}"; do direct_expression+=( '!' -regex "$expression" '!' -regex "/System/Volumes/Data$expression" ); done
list_bytes=0
list=$work/candidates.txt; raw=$work/results.txt; errors=$work/engine.stderr; fifo=$work/find.pipe
# Recovery happens only after acquiring the global scan lock. A prior interrupted
# attempt may leave its FIFO/staging directory; never follow or remove a symlink.
for leaf in candidates.txt results.txt engine.stderr find.stderr versions.tsv vulnerable.txt unverified.txt find.pipe staged; do
    [[ ! -L $work/$leaf ]] || {{ echo "Symlink workspace item rejected: $leaf" >&2; exit 2; }
done
: >"$list"; : >"$raw"; : >"$errors"
if [[ -e $fifo ]]; then
    [[ -p $fifo ]] || {{ echo 'Unexpected object at discovery FIFO path' >&2; exit 2; }
    rm -f -- "$fifo"
fi
mkfifo -- "$fifo"
mkdir -p -- "$work/staged"
original_paths=()
discovery_stopped=0
files=0; candidates=0; bytes=0; size_skipped=0; structural_skipped=0; read_errors=0; access_denied_skips=0
consider_runtime_candidate() {{
    if ((enumeration_seconds>0 && SECONDS>=deadline)); then reasons+=('file search time limit reached'); discovery_stopped=1; return 0; fi
    # BSD stat collects size and dataless flags together. Never hydrate a
    # cloud placeholder merely to inspect its content.
    [[ -f $path && ! -L $path ]] || return 0
    if ! metadata=$(stat -f '%z %f' "$path" 2>"$work/stat-open.stderr"); then
        if [[ -e $path ]]; then
            if awk 'NF {{seen=1; if ($0 !~ /^stat: \/.*: (stat: )?(Permission denied|Operation not permitted)$/) bad=1} END {{exit !(seen && !bad)}' "$work/stat-open.stderr"; then
                access_denied_skips=$((access_denied_skips+1))
                cat "$work/stat-open.stderr" >>"$output/scan.log"
            else read_errors=$((read_errors+1)); fi
        fi
        return 0
    fi
    read -r size file_flags <<<"$metadata"
    [[ $size =~ $mac_regex_5 && $file_flags =~ $mac_regex_5 ]] || {{ read_errors=$((read_errors+1)); return 0; }
    (( (file_flags & 0x40000000)==0 )) || return 0
    ((size>0)) || return 0
    # Stat/find never opens devices or FIFOs. Recheck after enumeration before
    # reading, because an application can replace its file during a scan.
    [[ -f $path && ! -L $path ]] || return 0
    if ! read_header "$path" "$size"; then
        if [[ $header_access_denied = 1 ]]; then
            access_denied_skips=$((access_denied_skips+1))
            printf 'Access denied; oversized file skipped: %q\n' "$path" >>"$output/scan.log"
        elif [[ -e $path ]]; then read_errors=$((read_errors+1)); fi
        return 0
    fi
    header=${{header//[[:space:]]/}
    binary=0
    case "$header" in
        7f454c46*)
            # ELF ET_REL/ET_CORE cannot be a live PHP executable/shared runtime.
            elf_type=${{header:32:4}
            if [[ $elf_type = 0100 || $elf_type = 0001 || $elf_type = 0400 || $elf_type = 0004 ]]; then structural_skipped=$((structural_skipped+1)); return 0; fi
            binary=1;;
        cefaedfe*|cffaedfe*)
            case "${{header:24:8}" in 02000000|06000000|08000000) binary=1;; *) structural_skipped=$((structural_skipped+1)); return 0;; esac;;
        feedface*|feedfacf*)
            case "${{header:24:8}" in 00000002|00000006|00000008) binary=1;; *) structural_skipped=$((structural_skipped+1)); return 0;; esac;;
        4d5a*|cafebabe*) binary=1;;
        cafebabf*|bebafeca*|bfbafeca*)
            # The unchanged community rule does not recognise these rare fat
            # variants. Keep the coverage gap visible until native tests justify
            # a shared rule change; never silently certify a clean result.
            reasons+=('unsupported Mach-O universal header'); return 0;;
    esac
    if ((!binary)); then ((include_build_text && size<65536)) || return 0; fi
    # Header reads stay bounded; unrelated oversized data is not a PHP gap.
    if ((size>=max_file_mb*1048576)); then
        size_skipped=$((size_skipped+1))
        if ((size_skipped<=20)); then
            printf 'Size-limited runtime candidate (%s bytes; path capped at 800 bytes): %q\n' "$size" "${{path:0:800}" >>"$output/scan.log"
        fi
        return 0
    fi
    if ((candidate_gb>0 && bytes+size>candidate_gb*1073741824)); then reasons+=('total candidate size limit'); discovery_stopped=1; return 0; fi
    # YARA scan lists are UTF-8 and newline-separated. Stage unusual raw-byte
    # paths to ASCII names; retain original bytes for readable UTF-8 reporting.
    scan_path=$path
    if ! scan_list_path_safe "$path"; then
        scan_path=$work/staged/$candidates
        [[ ! -L $scan_path ]] || {{ echo 'Symlink staged file rejected' >&2; exit 2; }
        stage_candidate || return 0
        original_paths[candidates]=$path
    fi
    # LC_ALL=C makes this a byte count, independent of filename encoding.
    # Bound temporary path-list storage separately from cumulative input bytes.
    if ((list_bytes+${{#scan_path}+1>134217728)); then
        reasons+=('candidate path list limit reached'); discovery_stopped=1; return 0
    fi
    printf '%s\n' "$scan_path" >>"$list"
    list_bytes=$((list_bytes+${{#scan_path}+1))
    candidates=$((candidates+1)); bytes=$((bytes+size))
}

# Ordinary candidates go directly to YARA-X. File names, exclusions and metadata
# are processed once; no preliminary content scan. Oversized candidates retain
# the bounded classifier so ordinary large data does not produce false UNKNOWNs.
admit_direct_candidate() {{
    if ((enumeration_seconds>0 && SECONDS>=deadline)); then reasons+=('file search time limit reached'); discovery_stopped=1; return 0; fi
    [[ -f $path && ! -L $path ]] || return 0
    [[ $size =~ ^[0-9]+$ ]] || {{ read_errors=$((read_errors+1)); return 0; }
    ((size>0)) || return 0
    if ((size>=max_file_mb*1048576)); then consider_runtime_candidate; return 0; fi
    if ((candidate_gb>0 && bytes+size>candidate_gb*1073741824)); then reasons+=('total candidate size limit'); discovery_stopped=1; return 0; fi
    scan_path=$path
    if ! scan_list_path_safe "$path"; then
        scan_path=$work/staged/$candidates
        [[ ! -L $scan_path ]] || {{ echo 'Symlink staged file rejected' >&2; exit 2; }
        stage_candidate || return 0
        original_paths[candidates]=$path
    fi
    # LC_ALL=C makes this a byte count, independent of filename encoding.
    # Bound temporary path-list storage separately from cumulative input bytes.
    if ((list_bytes+${{#scan_path}+1>134217728)); then
        reasons+=('candidate path list limit reached'); discovery_stopped=1; return 0
    fi
    printf '%s\n' "$scan_path" >>"$list"
    list_bytes=$((list_bytes+${{#scan_path}+1))
    candidates=$((candidates+1)); bytes=$((bytes+size))
}

# BSD stat accepts multiple paths. Read only numeric size/flags in bounded batches,
# keeping filename bytes in Bash arrays instead of parsing names from text output.
# Failed batches fall back to the established per-file path; partial numeric output
# is never paired with the wrong pathname. This needs no Python or GNU utility.
metadata_paths=()
metadata_count=0 metadata_argument_bytes=0 metadata_batches=0
flush_metadata_batch() {{
    ((metadata_count)) || return 0
    local index=0 remaining prior_stop=$discovery_stopped metadata_line extra
    local metadata_sizes=() metadata_flags=() batch_ok=1
    remaining=$((enumeration_seconds==0 ? 0 : deadline-SECONDS))
    if ((enumeration_seconds>0 && remaining<1)); then reasons+=('file search time limit reached'); discovery_stopped=1; return 0; fi
    if ! timeout -k 1 "$remaining" /usr/bin/stat -f '%z %f' "${{metadata_paths[@]}" >"$work/metadata.txt" 2>"$work/metadata.stderr"; then
        batch_ok=0
    fi
    if ((batch_ok)); then
        while IFS= read -r metadata_line; do
            read -r size file_flags extra <<<"$metadata_line"
            if [[ ! $size =~ $mac_regex_5 || ! $file_flags =~ $mac_regex_5 || -n $extra ]]; then batch_ok=0; break; fi
            metadata_sizes[index]=$size; metadata_flags[index]=$file_flags
            index=$((index+1))
        done <"$work/metadata.txt"
        ((index==metadata_count)) || batch_ok=0
    fi
    metadata_batches=$((metadata_batches+1))
    discovery_stopped=0
    for ((index=0;index<metadata_count;index++)); do
        path=${{metadata_paths[index]}
        if ((batch_ok)); then
            size=${{metadata_sizes[index]}; file_flags=${{metadata_flags[index]}
            (( (file_flags & 0x40000000)==0 )) || continue
            admit_direct_candidate
        else
            # Includes actual vanished-file, permission and malformed-stat handling.
            consider_runtime_candidate
        fi
        ((discovery_stopped==0)) || break
    done
    metadata_paths=(); metadata_count=0; metadata_argument_bytes=0
    ((prior_stop==0)) || discovery_stopped=1
}
queue_metadata_candidate() {{
    # Bound argv by bytes as well as count for very long paths on macOS.
    # Flushing changes the shared path variable while visiting queued entries.
    local queued_path=$path
    if ((metadata_count && metadata_argument_bytes+${{#path}+1>32768)); then flush_metadata_batch; fi
    ((discovery_stopped==0)) || return 0
    path=$queued_path
    metadata_paths[metadata_count]=$path
    metadata_count=$((metadata_count+1))
    metadata_argument_bytes=$((metadata_argument_bytes+${{#path}+1))
    if ((metadata_count>=256)); then flush_metadata_batch; fi
    return 0
}

deadline=$((SECONDS+enumeration_seconds))
read_budget=(); if ((enumeration_seconds>0)); then read_budget=(-t "$enumeration_seconds"); fi
# A timeout covers blocked directory reads. Streaming NUL records preserves path
# bytes and avoids a huge on-disk inventory; the FIFO provides backpressure.
root_arguments=(); for root in "${{roots[@]}"; do root_arguments+=(--root "$root"); done
/bin/zsh -f "$work/mac-run-bounded.zsh" "$enumeration_seconds" 5 /bin/bash "$work/mac-find.sh" "${{root_arguments[@]}" -- "${{prune_expression[@]}" -type f -size +0c "${{name_expression[@]}" "${{file_scope_expression[@]}" "${{direct_expression[@]}" -print0 >"$fifo" 2>"$work/find.stderr" &
find_pid=$!
while IFS= read -r -d '' "${{read_budget[@]}" path; do
    if ((enumeration_seconds>0 && SECONDS>=deadline)); then reasons+=('file search time limit reached'); discovery_stopped=1; break; fi
    if ((max_files>0 && files>=max_files)); then reasons+=('file count limit reached'); discovery_stopped=1; break; fi
    files=$((files+1)); leaf=${{path##*/}; lower=$leaf
    if ((!include_nonstandard_names)); then
        if [[ $lower = *[A-Z]* ]]; then lower=$(printf '%s' "$leaf" | tr '[:upper:]' '[:lower:]'); fi
        [[ $lower =~ $mac_regex_3 ]] || continue
        case "$lower" in
            php-config|php_version.h) ((include_build_text)) || continue;;
            *.*) extension=${{lower##*.}; [[ $extension = exe || $extension = dll || $extension = dylib || $extension = so || $extension =~ $mac_regex_4 ]] || continue;;
        esac
    fi
    case "$leaf" in
        [pP][hH][pP]-[cC][oO][nN][fF][iI][gG]|[pP][hH][pP]_[vV][eE][rR][sS][iI][oO][nN].[hH]) ((include_build_text)) || continue;;
    esac
    [[ -f $path && ! -L $path ]] || continue
    queue_metadata_candidate
    ((discovery_stopped==0)) || break
done <"$fifo"
flush_metadata_batch
printf 'Native metadata batches: %s\n' "$metadata_batches" >>"$output/scan.log"
stop_header_worker
if ((discovery_stopped)); then kill "$find_pid" 2>/dev/null || :; fi
find_rc=0; wait "$find_pid" || find_rc=$?; find_pid=
# A denied location is an explicit log-only skip on Mac. Other discovery
# errors, missing starting roots and time limits still indicate incomplete work.
find_relevant_errors=0; find_ignored_errors=0
while IFS= read -r message || [[ -n $message ]]; do
    [[ -n $message ]] || continue
    case "$message" in
        'find: /'*': Permission denied'|'find: /'*': Operation not permitted')
            access_denied_skips=$((access_denied_skips+1)); find_ignored_errors=$((find_ignored_errors+1));;
        'find: /'*': No such file or directory') find_ignored_errors=$((find_ignored_errors+1));;
        *) find_relevant_errors=$((find_relevant_errors+1));;
    esac
done <"$work/find.stderr"
if ((find_rc!=0 && !discovery_stopped)); then
    if ((enumeration_seconds>0 && SECONDS>=deadline)); then reasons+=('file search time limit reached')
    elif ((find_rc==1 && find_ignored_errors>0 && find_relevant_errors==0)); then
        for root in "${{roots[@]}"; do
            [[ -e $root ]] || {{ reasons+=('file search incomplete (starting location unavailable)'); break; }
        done
    else reasons+=('file search incomplete'); fi
fi
((find_relevant_errors==0)) || reasons+=('file search errors; see scan.log')
((size_skipped==0)) || reasons+=('file size limit')
((read_errors==0)) || reasons+=('unreadable files')
# Files may disappear between enumeration and YARA opening them. Ignore only
# explicit ENOENT open errors for absolute paths still absent. Verified Mac
# access denials are log-only skips; all other engine messages remain visible.
filter_engine_errors() {{
    local message missing denied
    local prefix="error: can't open \`" suffix='`: No such file or directory (os error 2)'
    vanished_engine_files=0
    : >"$work/engine-relevant.stderr"
    while IFS= read -r message || [[ -n $message ]]; do
        if [[ $message == "$prefix"*"$suffix" ]]; then
            missing=${{message#"$prefix"}
            missing=${{missing%"$suffix"}
            if [[ $missing == /* && ! -e $missing && ! -L $missing ]]; then
                vanished_engine_files=$((vanished_engine_files+1))
                continue
            fi
        fi
        # Match the complete known YARA open-error shape, including errno.
        # Do not suppress parser failures or messages merely mentioning access.
        denied=
        case "$message" in
            "$prefix"/*'`: Permission denied (os error 13)')
                denied=${{message#"$prefix"}; denied=${{denied%'`: Permission denied (os error 13)'};;
            "$prefix"/*'`: Operation not permitted (os error 1)')
                denied=${{message#"$prefix"}; denied=${{denied%'`: Operation not permitted (os error 1)'};;
        esac
        if [[ -n $denied ]]; then
            access_denied_skips=$((access_denied_skips+1))
            continue
        fi
        printf '%s\n' "$message" >>"$work/engine-relevant.stderr"
    done <"$errors"
    [[ ! -s $work/engine-relevant.stderr ]] || reasons+=('YARA warnings or unreadable files')
    if ((vanished_engine_files)); then
        printf 'Vanished files skipped before content scan: %s\n' "$vanished_engine_files" >>"$output/scan.log"
    fi
    return 0
}

# Keep the pinned full rules immutable. Runtime-only scans omit build-text
# evidence; do not change signature occurrence semantics with fast-scan.
active_rules=$rules
if ((!include_build_text)); then
    active_rules=$work/runtime-rules.yar
    awk '/^rule PHP_Build_Artifact$/ {{exit} {{print}' "$rules" >"$active_rules"
fi
engine_options=(--threads "$yara_threads")
if ((scan_seconds>0)); then engine_options+=(--timeout "$scan_seconds"); fi
if ((cpu_limit)); then engine_options+=(--cpu-limit "$cpu_limit"); fi
if ((candidates)); then
    runner=(nice -n 10)
    # Idle I/O is optional, never a prerequisite that can suppress detection.
    if command -v ionice >/dev/null 2>&1 && ionice -c 3 true 2>/dev/null; then runner+=(ionice -c 3); fi
    (ulimit -f 65536; exec /bin/zsh -f "$work/mac-run-bounded.zsh" "$((scan_seconds>0 ? scan_seconds+15 : 0))" 5 "${{runner[@]}" "$engine" scan --scan-list --print-strings --output-format text "${{engine_options[@]}" --max-matches-per-pattern 64 "$active_rules" "$list") >"$raw" 2>"$errors" &
    scan_pid=$!; scan_rc=0; wait "$scan_pid" || scan_rc=$?; scan_pid=
    ((scan_rc==0)) || reasons+=('YARA time/output/error limit')
    filter_engine_errors
fi
# Parse the engine's documented text output, not shell code or executable PHP.
awk '
 /^PHP_/ {{rule=$1; file=$0; sub(/^[^ ]+ /,"",file); seen[file]=1; if(rule=="PHP_Runtime_Version")core[file]=1; if(rule=="PHP_Build_Artifact")build[file]=1; if(rule=="PHP_Unsupported_Format")unsupported[file]=1; next}
 /:\$[A-Za-z_]+: / {{if(rule=="PHP_Binary_Broad") {{if($0 ~ /:\$api: /) api[file]=1; else non_api[file]=1}}
 /:\$(ver|pv|cfg_ver|hdr_ver): / {{v=$0; gsub(/\\x00/,"",v); sub(/^[^ ]+ /,"",v); if(match(v,/[0-9]+\.[0-9]+\.[0-9]+[0-9A-Za-z.+~_-]*/)) {{v=substr(v,RSTART,RLENGTH); if(rule=="PHP_Runtime_Version")runtime[file SUBSEP v]=1; else evidence[file SUBSEP v]=1}}
 END {{for(k in runtime){{split(k,a,SUBSEP);print a[1] "\truntime\t" a[2]} for(k in evidence){{split(k,a,SUBSEP);if(!core[a[1]])print a[1] "\tevidence\t" a[2]} for(f in unsupported)print f "\tunsupported_format\tunknown"; for(f in seen)if(!core[f] && !build[f] && !unsupported[f]) print f ((api[f] && !non_api[f]) ? "\textension_only\tunknown" : "\tunconfirmed\tunknown")}
' "$raw" | sort -u >"$work/versions.tsv"
# Portable byte-based validation handles UTF-8 without installing a locale, Python or another tool.
# Invalid bytes and control characters use reversible shell quoting, never eval.
display_path() {{
    if [[ $1 != *[[:cntrl:]]* ]] && valid_utf8 "$1"; then printf '%s' "$1"; else printf '%q' "$1"; fi
}
summary_row() {{
    local row=$1
    if ((${{#row}>900)); then
        row=${{row:0:870}
        while ! valid_utf8 "$row"; do row=${{row%?}; done
        row+='...[full path in scan.log]'
    fi
    printf '%s\n' "$row"
}

# Native receipt queries are read-only and bounded, with a per-path cache.
package_paths=(); package_states=()
package_deadline=$((SECONDS+30))
vulnerable=0; unknown=0; findings=0; vendor_unverified=0
: >"$work/vulnerable.txt"; : >"$work/unverified.txt"
while IFS=$'\t' read -r path kind version; do
    [[ -n $path ]] || continue
    findings=$((findings+1))
    original=$path
    if [[ $path = "$work/staged/"* ]]; then
        index=${{path##*/}; [[ $index =~ $mac_regex_5 ]] || exit 2
        original=${{original_paths[index]-$path}
    fi
    original=${{original#/System/Volumes/Data}
    display=$(display_path "$original")
    printf 'Finding: %s | %s | PHP %s\n' "$display" "$kind" "$version" >>"$output/scan.log"
    if [[ $kind = unsupported_format ]]; then
        reasons+=('unsupported Mach-O universal header')
        printf '%s | Unsupported executable format\n' "$display" >>"$work/unverified.txt"
        continue
    fi
    if [[ $kind != runtime ]]; then
        # Build evidence is expected only in the opt-in mode. Unknown runtime
        # versions remain a visible qualification in the last-scan property.
        [[ $kind != unconfirmed ]] || unknown=$((unknown+1))
        if [[ $kind = unconfirmed ]]; then printf '%s | PHP version/runtime unconfirmed\n' "$display" >>"$work/unverified.txt"; fi
        continue
    fi
    [[ $version =~ $mac_regex_6 ]] || {{ unknown=$((unknown+1)); printf '%s | PHP version unavailable\n' "$display" >>"$work/unverified.txt"; continue; }
    major=$((10#${{BASH_REMATCH[1]})); minor=$((10#${{BASH_REMATCH[2]})); patch=$((10#${{BASH_REMATCH[3]})); suffix=${{BASH_REMATCH[4]}
    fixed=0 affected=0
