continue if {sha256 of file "mac-lock.zsh" of folder (parameter "work") = "b5cffd0a99c2e1e8e106dcf79d2f0e72f85f4059651e8347bb91653a087aa0fe"}
delete __createfile
createfile until END_PHP_YARA_b57de2beabea66fa
#!/bin/zsh -f
# Stock zsh provides a watchdog without GNU timeout or orphaned sleep children.
# Only the child created here is signalled. The watchdog is reaped on every exit.
emulate -R zsh
setopt NO_UNSET
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
(( $# &gt;= 3 )) || exit 2
seconds=$1
grace=$2
shift 2
[[ $seconds = &lt;1-7200&gt; &amp;&amp; $grace = &lt;1-10&gt; ]] || exit 2
zmodload zsh/zselect || exit 2
child= watcher= result=0
cleanup() {{
    trap - TERM INT HUP
    [[ -z $watcher ]] || {{ kill -TERM "$watcher" 2&gt;/dev/null; wait "$watcher" 2&gt;/dev/null; }
    if [[ -n $child ]]; then
        kill -TERM "$child" 2&gt;/dev/null
        zselect -t 10 &gt;/dev/null 2&gt;&amp;1
        kill -KILL "$child" 2&gt;/dev/null
        wait "$child" 2&gt;/dev/null
    fi
}
trap 'cleanup; exit 130' TERM INT HUP
"$@" &amp;
child=$!
(
    trap - TERM INT HUP
    zselect -t $((seconds * 100)) &gt;/dev/null 2&gt;&amp;1
    kill -TERM "$child" 2&gt;/dev/null || exit 0
    zselect -t $((grace * 100)) &gt;/dev/null 2&gt;&amp;1
    kill -KILL "$child" 2&gt;/dev/null
) &amp;
watcher=$!
wait "$child" || result=$?
child=
kill -TERM "$watcher" 2&gt;/dev/null
wait "$watcher" 2&gt;/dev/null
watcher=
trap - TERM INT HUP
exit "$result"
END_PHP_YARA_b57de2beabea66fa
