#!/bin/bash
# One read-only worker serves all header requests. Bash builtins preserve every
# byte, including NUL/newline/high bytes, without starting od for every file.
# The parent bounds each FIFO response and kills/restarts a stalled worker.
set -eo pipefail
export LC_ALL=C PATH=/usr/bin:/bin:/usr/sbin:/sbin
umask 077
(($#==2)) || exit 2
[[ $1 = /* &amp;&amp; $2 = /* &amp;&amp; -p $1 &amp;&amp; -p $2 &amp;&amp; ! -L $1 &amp;&amp; ! -L $2 ]] || exit 2
exec 7&lt;"$1" 6&gt;"$2"
while IFS= read -r -d '' path &lt;&amp;7; do
    header=; status=ERROR
    if [[ -f $path &amp;&amp; ! -L $path ]]; then
        if {{
            for ((index=0;index&lt;20;index++)); do
                byte=
                if ! IFS= read -r -n 1 -d '' byte &lt;&amp;8; then break; fi
                # Bash3.2 can expose bytes &gt;=128 as signed char values.
                printf -v octet '%d' "'$byte"
                printf -v hexadecimal '%02x' "$((octet &amp; 255))"
                header+=$hexadecimal
            done
        } 8&lt;"$path" 2&gt;/dev/null; then
            [[ -z $header ]] || status=OK
        fi
    fi
    printf '%s:%s\0' "$status" "$header" &gt;&amp;6 || exit 0
done
END_PHP_YARA_49f6302bed220249
