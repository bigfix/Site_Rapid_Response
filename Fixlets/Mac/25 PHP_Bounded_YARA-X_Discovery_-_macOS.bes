continue if {sha256 of file "mac-find.sh" of folder (parameter "work") = "40d8859de3217c09e78a57e3a777883574c596f015fbdf06069088e5280fd597"}
delete __createfile
createfile until END_PHP_YARA_b5cffd0a99c2e1e8
#!/bin/zsh -f
# macOS ships zsh/system. Its kernel lock survives exec and is released when
# the scanner exits; there is no stale PID/directory lock to guess or delete.
emulate -R zsh
setopt ERR_EXIT NO_UNSET
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
umask 077
(( $# &gt;= 2 )) || exit 2
lockfile=$1
scanner=$2
shift 2
[[ $lockfile = /* &amp;&amp; $scanner = /* ]] || exit 2
zmodload zsh/stat
zmodload zsh/system
directory=${{lockfile:h}
ancestor=$directory
while [[ $ancestor != / ]]; do
    [[ ! -L $ancestor ]] || {{ print -u2 'Symlink output ancestor rejected'; exit 2; }
    ancestor=${{ancestor:h}
done
[[ -d $directory ]] || {{ print -u2 'Output folder must already exist'; exit 2; }
typeset -A info
zstat -H info -- "$directory"
# zsh does not interpret leading-zero integers as octal by default.
(( info[uid] == EUID &amp;&amp; (info[mode] &amp; 8#22) == 0 )) || {{
    print -u2 'Unsafe output folder ownership or permissions'; exit 2
}
[[ ! -L $lockfile ]] || {{ print -u2 'Symlink scan lock rejected'; exit 2; }
# O_NOFOLLOW and O_EXCL are not emulated by a check followed by a truncation.
if [[ ! -e $lockfile ]]; then
    sysopen -o create,excl,nofollow -m 0600 -u created "$lockfile" || exit 75
    exec {{created}&gt;&amp;-
fi
[[ -f $lockfile &amp;&amp; ! -L $lockfile ]] || exit 2
zstat -H info -- "$lockfile"
(( info[uid] == EUID &amp;&amp; info[nlink] == 1 &amp;&amp; (info[mode] &amp; 8#22) == 0 )) || exit 2
# Older stock zsh treats -t 0 as an unlimited wait. One second bounds overlap
# on both old and current releases without relying on newer timeout semantics.
zsystem flock -e -t 1 -f lockfd "$lockfile" || {{
    print -u2 'Another PHP scan is running; retry after it finishes'; exit 75
}
[[ -f $scanner &amp;&amp; ! -L $scanner ]] || exit 2
export PHP_SCAN_LOCK_HELD_PID=$$
exec /bin/bash "$scanner" "$@"
END_PHP_YARA_b5cffd0a99c2e1e8
delete "{parameter "work"}/mac-lock.zsh"
