for leaf in candidates.txt results.txt engine.stderr find.stderr versions.tsv vulnerable.txt unverified.txt find.pipe staged; do
    [[ ! -L $work/$leaf ]] || {{ echo "Symlink workspace item rejected: $leaf" &gt;&amp;2; exit 2; }
done
: &gt;"$list"; : &gt;"$raw"; : &gt;"$errors"
if [[ -e $fifo ]]; then
    [[ -p $fifo ]] || {{ echo 'Unexpected object at discovery FIFO path' &gt;&amp;2; exit 2; }
    rm -f -- "$fifo"
fi
mkfifo -- "$fifo"
mkdir -p -- "$work/staged"
original_paths=()
discovery_stopped=0
files=0; candidates=0; bytes=0; size_skipped=0; structural_skipped=0; read_errors=0
deadline=$((SECONDS+enumeration_seconds))
# A timeout covers blocked directory reads. Streaming NUL records preserves path
# bytes and avoids a huge on-disk inventory; the FIFO provides backpressure.
root_arguments=(); for root in "${{roots[@]}"; do root_arguments+=(--root "$root"); done
/bin/zsh -f "$work/mac-run-bounded.zsh" "$enumeration_seconds" 5 /bin/bash "$work/mac-find.sh" "${{root_arguments[@]}" -- "${{prune_expression[@]}" -type f -size +0c "${{name_expression[@]}" "${{file_scope_expression[@]}" "${{direct_expression[@]}" -print0 &gt;"$fifo" 2&gt;"$work/find.stderr" &amp;
find_pid=$!
while IFS= read -r -d '' -t "$enumeration_seconds" path; do
    if ((SECONDS&gt;=deadline)); then reasons+=('file search time limit reached'); discovery_stopped=1; break; fi
    if ((files&gt;=max_files)); then reasons+=('file count limit reached'); discovery_stopped=1; break; fi
    files=$((files+1)); leaf=${{path##*/}; lower=$leaf
    if ((!include_nonstandard_names)); then
        if [[ $lower = *[A-Z]* ]]; then lower=$(printf '%s' "$leaf" | tr '[:upper:]' '[:lower:]'); fi
        [[ $lower =~ $mac_regex_3 ]] || continue
        case "$lower" in
            php-config|php_version.h) ((include_build_text)) || continue;;
            *.*) extension=${{lower##*.}; [[ $extension = exe || $extension = dll || $extension = dylib || $extension = so || $extension =~ $mac_regex_4 ]] || continue;;
        esac
    fi
    case "$leaf" in
        [pP][hH][pP]-[cC][oO][nN][fF][iI][gG]|[pP][hH][pP]_[vV][eE][rR][sS][iI][oO][nN].[hH]) ((include_build_text)) || continue;;
    esac
    # BSD stat collects size and dataless flags together. Never hydrate a
    # cloud placeholder merely to inspect its content.
    [[ -f $path &amp;&amp; ! -L $path ]] || continue
    if ! metadata=$(stat -f '%z %f' "$path" 2&gt;/dev/null); then
        [[ ! -e $path ]] || read_errors=$((read_errors+1)); continue
    fi
    read -r size file_flags &lt;&lt;&lt;"$metadata"
    [[ $size =~ $mac_regex_5 &amp;&amp; $file_flags =~ $mac_regex_5 ]] || {{ read_errors=$((read_errors+1)); continue; }
    (( (file_flags &amp; 0x40000000)==0 )) || continue
    ((size&gt;0)) || continue
    # Stat/find never opens devices or FIFOs. Recheck after enumeration before
    # reading, because an application can replace its file during a scan.
    [[ -f $path &amp;&amp; ! -L $path ]] || continue
    if ! read_header "$path" "$size"; then
        [[ -e $path ]] &amp;&amp; read_errors=$((read_errors+1)); continue
    fi
    header=${{header//[[:space:]]/}
