if ((discovery_stopped)); then kill "$find_pid" 2&gt;/dev/null || :; fi
find_rc=0; wait "$find_pid" || find_rc=$?; find_pid=
if ((find_rc!=0 &amp;&amp; !discovery_stopped)); then
    if ((SECONDS&gt;=deadline)); then reasons+=('file search time limit reached')
    elif ((find_rc==1)) &amp;&amp; awk 'NF {{seen=1; if($0 !~ /No such file or directory$/) bad=1} END {{exit !(seen &amp;&amp; !bad)}' "$work/find.stderr"; then
        # Ignore expected vanished entries only if selected starting roots remain.
        for root in "${{roots[@]}"; do
            [[ -e $root ]] || {{ reasons+=('file search incomplete (starting location unavailable)'); break; }
        done
    else reasons+=('file search incomplete'); fi
fi
if awk 'NF &amp;&amp; $0 !~ /No such file or directory$/ {{found=1} END{{exit !found}' "$work/find.stderr"; then reasons+=('unreadable locations or macOS privacy restrictions'); fi
((size_skipped==0)) || reasons+=('file size limit')
((read_errors==0)) || reasons+=('unreadable files')
if ((candidates)); then
    runner=(nice -n 10)
    # Idle I/O is optional, never a prerequisite that can suppress detection.
    if command -v ionice &gt;/dev/null 2&gt;&amp;1 &amp;&amp; ionice -c 3 true 2&gt;/dev/null; then runner+=(ionice -c 3); fi
    (ulimit -f 65536; exec /bin/zsh -f "$work/mac-run-bounded.zsh" "$((scan_seconds+15))" 5 "${{runner[@]}" "$engine" scan --scan-list --print-strings --output-format text --threads 2 --cpu-limit "$cpu_limit" --timeout "$scan_seconds" --max-matches-per-pattern 64 "$rules" "$list") &gt;"$raw" 2&gt;"$errors" &amp;
    scan_pid=$!; scan_rc=0; wait "$scan_pid" || scan_rc=$?; scan_pid=
    ((scan_rc==0)) || reasons+=('YARA time/output/error limit')
    [[ ! -s $errors ]] || reasons+=('YARA warnings or unreadable files')
fi
# Parse the engine's documented text output, not shell code or executable PHP.
awk '
 /^PHP_/ {{rule=$1; file=$0; sub(/^[^ ]+ /,"",file); seen[file]=1; if(rule=="PHP_Runtime_Version")core[file]=1; if(rule=="PHP_Build_Artifact")build[file]=1; next}
 /:\$[A-Za-z_]+: / {{if(rule=="PHP_Binary_Broad") {{if($0 ~ /:\$api: /) api[file]=1; else non_api[file]=1}}
 /:\$(ver|pv|cfg_ver|hdr_ver): / {{v=$0; gsub(/\\x00/,"",v); sub(/^[^ ]+ /,"",v); if(match(v,/[0-9]+\.[0-9]+\.[0-9]+[0-9A-Za-z.+~_-]*/)) {{v=substr(v,RSTART,RLENGTH); if(rule=="PHP_Runtime_Version")runtime[file SUBSEP v]=1; else evidence[file SUBSEP v]=1}}
 END {{for(k in runtime){{split(k,a,SUBSEP);print a[1] "\truntime\t" a[2]} for(k in evidence){{split(k,a,SUBSEP);if(!core[a[1]])print a[1] "\tevidence\t" a[2]} for(f in seen)if(!core[f] &amp;&amp; !build[f]) print f ((api[f] &amp;&amp; !non_api[f]) ? "\textension_only\tunknown" : "\tunconfirmed\tunknown")}
' "$raw" | sort -u &gt;"$work/versions.tsv"
# Portable byte-based validation handles UTF-8 without installing a locale, Python or another tool.
# Invalid bytes and control characters use reversible shell quoting, never eval.
display_path() {{
    if [[ $1 != *[[:cntrl:]]* ]] &amp;&amp; valid_utf8 "$1"; then printf '%s' "$1"; else printf '%q' "$1"; fi
}
summary_row() {{
    local row=$1
    if ((${{#row}&gt;900)); then
        row=${{row:0:870}
        while ! valid_utf8 "$row"; do row=${{row%?}; done
        row+='...[full path in scan.log]'
    fi
    printf '%s\n' "$row"
}

# Native receipt queries are read-only and bounded, with a per-path cache.
package_paths=(); package_states=()
package_deadline=$((SECONDS+30))
vulnerable=0; unknown=0; findings=0; vendor_unverified=0
: &gt;"$work/vulnerable.txt"; : &gt;"$work/unverified.txt"
while IFS=$'\t' read -r path kind version; do
    [[ -n $path ]] || continue
    findings=$((findings+1))
    original=$path
    if [[ $path = "$work/staged/"* ]]; then
        index=${{path##*/}; [[ $index =~ $mac_regex_5 ]] || exit 2
        original=${{original_paths[index]-$path}
    fi
    original=${{original#/System/Volumes/Data}
    display=$(display_path "$original")
    printf 'Finding: %s | %s | PHP %s\n' "$display" "$kind" "$version" &gt;&gt;"$output/scan.log"
    if [[ $kind != runtime ]]; then
        # Build evidence is expected only in the opt-in mode. Unknown runtime
        # versions remain a visible qualification in the last-scan property.
        [[ $kind != unconfirmed ]] || unknown=$((unknown+1))
        if [[ $kind = unconfirmed ]]; then printf '%s | PHP version/runtime unconfirmed\n' "$display" &gt;&gt;"$work/unverified.txt"; fi
        continue
    fi
    [[ $version =~ $mac_regex_6 ]] || {{ unknown=$((unknown+1)); printf '%s | PHP version unavailable\n' "$display" &gt;&gt;"$work/unverified.txt"; continue; }
    major=$((10#${{BASH_REMATCH[1]})); minor=$((10#${{BASH_REMATCH[2]})); patch=$((10#${{BASH_REMATCH[3]})); suffix=${{BASH_REMATCH[4]}
    fixed=0 affected=0
    case "$major.$minor" in 8.2) fixed=35;; 8.3) fixed=36;; 8.4) fixed=27;; 8.5) fixed=12;; esac
    if ((fixed)); then
        if ((patch&lt;fixed)) || {{ ((patch==fixed)) &amp;&amp; [[ $suffix =~ $mac_regex_8 ]]; }; then affected=1; fi
    elif (( (major==5 &amp;&amp; minor&gt;=4) || major==7 || (major==8 &amp;&amp; minor&lt;2) )); then affected=1
    else unknown=$((unknown+1)); printf '%s | PHP %s | Version assessment unavailable\n' "$display" "$version" &gt;&gt;"$work/unverified.txt"; fi
    if ((affected)); then
        package_status "$original"
        if [[ ($package_state != unowned &amp;&amp; $package_state != upstream) || ( -n $suffix &amp;&amp; ! $suffix =~ $mac_regex_7 ) ]]; then
            vendor_unverified=$((vendor_unverified+1))
            printf '%s | PHP %s | Vendor patch status unverified\n' "$display" "$version" &gt;&gt;"$work/unverified.txt"
            printf 'Vendor patch status unverified: %s | ownership %s\n' "$display" "$package_state" &gt;&gt;"$output/scan.log"
        else
            vulnerable=$((vulnerable+1))
            printf '%s | PHP %s\n' "$display" "$version" &gt;&gt;"$work/vulnerable.txt"
        fi
    fi
done &lt;"$work/versions.tsv"
((unknown==0)) || reasons+=('unconfirmed PHP version/runtime')
if ((${{#reasons[@]})); then
    # Multiple unsupported mounts or files can have the same cause; show it once.
    unique_reasons=(); while IFS= read -r reason; do unique_reasons+=("$reason"); done &lt; &lt;(printf '%s\n' "${{reasons[@]}" | sort -u)
    reasons=("${{unique_reasons[@]}")
fi
elapsed=$((SECONDS-start_seconds))
printf -v duration '%s hours, %s minutes, %s seconds' "$((elapsed/3600))" "$((elapsed%3600/60))" "$((elapsed%60))"
completed=$(date -u '+%Y-%m-%d %H:%M:%S UTC'); last_scan=$completed
if ((${{#reasons[@]})); then
    reason_text=
    for reason in "${{reasons[@]}"; do
        [[ -z $reason_text ]] || reason_text+=', '
        reason_text+=$reason
    done
    last_scan+=" (Partial: $reason_text; see scan.log)"
fi
if ((vendor_unverified)); then last_scan+=' (Vendor patch status unverified; see scan.log)'; fi
if ((vulnerable+vendor_unverified+unknown&gt;100)); then last_scan+=' (first 100 paths shown; all paths in scan.log)'; fi
{{
    printf '\nCompleted: %s\nDuration: %s\nFiles considered: %s\nCandidates: %s\nCandidate bytes: %s\nOver size limit: %s\nRead errors: %s\nStructural skips: %s\nFindings: %s\nUpstream-affected runtime paths: %s\n' "$completed" "$duration" "$files" "$candidates" "$bytes" "$size_skipped" "$read_errors" "$structural_skipped" "$findings" "$vulnerable"
    printf 'Limits: search %ss; YARA %ss; files %s; individual file %s MiB; candidate input %s GiB; CPU %s%%\n' "$enumeration_seconds" "$scan_seconds" "$max_files" "$max_file_mb" "$candidate_gb" "$cpu_limit"
    printf 'Result: %s\n' "$last_scan"
    printf 'Vendor-unverified runtime paths: %s\n' "$vendor_unverified"
    printf 'TRUE: upstream-affected runtime detected. FALSE: none detected within complete scan scope. UNKNOWN: unavailable, incomplete or unverified evidence. Vendor package patch status and web exposure require verification.\n'
    head -c 32768 -- "$work/find.stderr" "$errors"
} &gt;&gt;"$output/scan.log"
{{
    echo RESULT_FORMAT=2
    if ((vulnerable)); then echo DETECTED=TRUE
    elif ((vendor_unverified || unknown || ${{#reasons[@]})); then
        echo DETECTED=UNKNOWN
        unknown_reason=
        for reason in "${{reasons[@]}"; do
            case "$reason" in
                'file size limit') detail="$size_skipped possible runtime file(s) at or above $max_file_mb MiB skipped";;
                'YARA time/output/error limit') detail='Content scan incomplete (time, output or engine error)' ;;
                *) detail=$reason;;
            esac
            [[ -z $unknown_reason ]] || unknown_reason+='; '
            unknown_reason+=$detail
        done
        if ((vendor_unverified)); then
            [[ -z $unknown_reason ]] || unknown_reason+='; '
            unknown_reason+='Vendor patch status unverified'
        fi
        printf 'UNKNOWN_REASON=%s\n' "${{unknown_reason:0:800}"
    else echo DETECTED=FALSE; fi
    printf 'LAST_SCAN=%s\nDURATION=%s\n' "$last_scan" "$duration"
    rows=0
    while IFS= read -r row; do
        ((rows&lt;100)) || break
        summary_row "VULNERABLE=$row"; rows=$((rows+1))
    done &lt;"$work/vulnerable.txt"
    while IFS= read -r row; do
        ((rows&lt;100)) || break
        summary_row "UNVERIFIED=$row"; rows=$((rows+1))
    done &lt;"$work/unverified.txt"
} &gt;"$output/summary.txt.new"
mv -f -- "$output/summary.txt.new" "$output/summary.txt"
finished=1
if ((${{#reasons[@]})); then exit 10; fi
END_PHP_YARA_5208e234d6eae9fb
