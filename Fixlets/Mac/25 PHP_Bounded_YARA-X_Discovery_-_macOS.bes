            binary=1;;
        cefaedfe*|cffaedfe*)
            case "${{header:24:8}" in 02000000|06000000|08000000) binary=1;; *) structural_skipped=$((structural_skipped+1)); continue;; esac;;
        feedface*|feedfacf*)
            case "${{header:24:8}" in 00000002|00000006|00000008) binary=1;; *) structural_skipped=$((structural_skipped+1)); continue;; esac;;
        4d5a*|cafebabe*) binary=1;;
        cafebabf*|bebafeca*|bfbafeca*)
