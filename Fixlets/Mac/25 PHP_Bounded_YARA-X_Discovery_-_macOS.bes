            vendor_unverified=$((vendor_unverified+1))
            printf '%s | PHP %s | Vendor patch status unverified\n' "$display" "$version" >>"$work/unverified.txt"
            printf 'Vendor patch status unverified: %s | ownership %s\n' "$display" "$package_state" >>"$output/scan.log"
        else
            vulnerable=$((vulnerable+1))
            printf '%s | PHP %s\n' "$display" "$version" >>"$work/vulnerable.txt"
