#!/bin/bash
# Stock-Bash discovery: inspect common PHP installations first, then the rest of
# the selected local volumes. Prune already searched roots from the fallback.
set -eo pipefail
export LC_ALL=C PATH=/usr/bin:/bin:/usr/sbin:/sbin
umask 077
roots=(); expression=(); priorities=(); devices=()
while (($#)); do
    case "$1" in
        --root) (($#&gt;=2)) || exit 2; roots+=("$2"); shift 2;;
        --) shift; expression=("$@"); break;;
        *) exit 2;;
    esac
done
((${{#roots[@]} &amp;&amp; ${{#expression[@]})) || exit 2
child=
stop() {{
    trap - TERM INT HUP
    [[ -z $child ]] || {{ kill -TERM "$child" 2&gt;/dev/null || :; wait "$child" 2&gt;/dev/null || :; }
    exit 130
}
trap stop TERM INT HUP
for root in "${{roots[@]}"; do
    device=$(stat -f %d "$root" 2&gt;/dev/null) || device=unavailable
    devices+=("$device")
done
run_find() {{
    find -E "$@" &amp;
    child=$!
    local result=0
    wait "$child" || result=$?
    child=
    return "$result"
}
for directory in /opt/homebrew/Cellar/php* /usr/local/Cellar/php* \
    /Applications/MAMP/bin/php /Applications/XAMPP/xamppfiles/bin \
    /Library/WebServer /usr/local/php* /opt/php* \
    /Users/*/Library/Application\ Support/Herd/bin; do
    [[ -d $directory &amp;&amp; ! -L $directory ]] || continue
    device=$(stat -f %d "$directory" 2&gt;/dev/null) || continue
    allowed=0
    # Device equality alone would scan outside an explicit test/operator root.
    # Require containment in a selected mount/root as well as a local device.
    for ((index=0;index&lt;${{#roots[@]};index++)); do
        logical_root=${{roots[index]#/System/Volumes/Data}
        [[ -n $logical_root ]] || logical_root=/
        if [[ $device = "${{devices[index]-missing}" &amp;&amp; ($logical_root = / || $directory = "$logical_root" || $directory = "$logical_root/"*) ]]; then allowed=1; break; fi
    done
    ((allowed)) || continue
    nested=0
    for previous in "${{priorities[@]}"; do [[ $directory != "$previous" &amp;&amp; $directory != "$previous/"* ]] || nested=1; done
    ((nested==0)) || continue
    run_find "$directory" -xdev "${{expression[@]}" || :
    priorities+=("$directory")
done
skip=( '(' -type d '(' -false )
for directory in "${{priorities[@]}"; do
    skip+=( -o -path "$directory" -o -path "/System/Volumes/Data$directory" )
done
skip+=( ')' ')' -prune -o )
run_find "${{roots[@]}" -xdev "${{skip[@]}" "${{expression[@]}"
END_PHP_YARA_40d8859de3217c09
delete "{parameter "work"}/mac-find.sh"
